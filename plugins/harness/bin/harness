function runDetectProject(cwd) {
  const dp = detectProjectPath();
  if (!dp) return null;
  const r = spawnSync('node', [dp, '--dir', cwd], { encoding: 'utf8' });
  if (r.status !== 0 || !r.stdout) return null;
  try {
    return JSON.parse(r.stdout);
  } catch {
    return null;
  }
}

function langToStack(lang) {
  if (lang === 'typescript' || lang === 'javascript') return 'node';
  if (lang === 'python') return 'python';
  if (lang === 'rust') return 'rust';
  if (lang === 'go') return 'go';
  return null;
}

function resolveStackKey(stackArg, detected, cwd) {
  if (stackArg !== 'auto') {
    return Object.prototype.hasOwnProperty.call(STACKS, stackArg) ? stackArg : null;
  }
  if (detected && detected.language) {
    const s = langToStack(detected.language);
    if (s) return s;
  }
  if (fs.existsSync(path.join(cwd, 'package.json'))) return 'node';
  if (fs.existsSync(path.join(cwd, 'pyproject.toml'))) return 'python';
  if (fs.existsSync(path.join(cwd, 'Cargo.toml'))) return 'rust';
  if (fs.existsSync(path.join(cwd, 'go.mod'))) return 'go';
  return null;
}

function renderGatesYml(tmplContent, stackKey, cmds) {
  const stack = STACKS[stackKey];
  const withSetup = tmplContent.replace('{{SETUP_STEP}}', stack.setupStep);
  const stepDefs = [
    { placeholder: '{{TYPECHECK_CMD}}', cmd: cmds.typecheck_cmd },
    { placeholder: '{{LINT_CMD}}', cmd: cmds.lint_cmd },
    { placeholder: '{{TEST_CMD}}', cmd: cmds.test_cmd },
  ];
  const lines = withSetup.split('\n');
  const result = [];
  for (const line of lines) {
    const step = stepDefs.find((s) => line.indexOf(s.placeholder) !== -1);
    if (step) {
      if (!step.cmd) {
        result.pop(); // drop the "- name: <gate>" line pushed just before this one
        continue;
      }
      result.push(line.replace(step.placeholder, step.cmd));
      continue;
    }
    result.push(line);
  }
  return result.join('\n');
}

function renderTemplate(tmpl, vars) {
  let out = tmpl;
  for (const k of Object.keys(vars)) {
    out = out.split(`{{${k}}}`).join(vars[k]);
  }
  return out;
}

function printInitHelp() {
  stdout.write(`
${C.primary}${C.bold}harness init${C.reset} ${C.muted}— scaffold governance files, CI gate and lint thresholds${C.reset}

${C.accent}Usage:${C.reset}
  harness init [--stack auto|node|python|rust|go] [--dry-run] [--force]

${C.accent}Options:${C.reset}
  --stack <s>   Force a stack instead of auto-detecting it (default: auto)
  --dry-run     Print what would be written; write nothing
  --force       Overwrite files that already exist (CLAUDE.md is never overwritten)
  -h, --help    Show this help message
`);
}

const VALID_STACK_ARGS = ['auto', 'node', 'python', 'rust', 'go'];

function cmdInit(argv) {
  const dryRun = argv.includes('--dry-run');
  const force = argv.includes('--force');
  let stackArg = 'auto';
  const si = argv.indexOf('--stack');
  if (si !== -1 && argv[si + 1]) stackArg = argv[si + 1];

  if (VALID_STACK_ARGS.indexOf(stackArg) === -1) {
    stderr.write(
      `${C.error}harness: invalid --stack value '${stackArg}' (expected one of: ${VALID_STACK_ARGS.join('|')})${C.reset}\n`
    );
    return 1;
  }

  const cwd = process.cwd();
  const detected = runDetectProject(cwd);
  const stackKey = resolveStackKey(stackArg, detected, cwd);
  const cmds = detected || { test_cmd: '', lint_cmd: '', format_cmd: '', typecheck_cmd: '', dev_cmd: '', language: '' };

  const templates = templatesDir();
  const actions = [];

  function planFile(relPath, content, forceable) {
    const abs = path.join(cwd, relPath);
    const exists = fs.existsSync(abs);
    let willWrite;
    let reason;
    if (!exists) {
      willWrite = true;
      reason = 'create';
    } else if (force && forceable !== false) {
      willWrite = true;
      reason = 'overwrite (--force)';
    } else {
      willWrite = false;
      reason = 'exists, skip';
    }
    actions.push({ path: relPath, willWrite, reason, content });
  }

  planFile('REVIEW.md', readTemplate(templates, 'REVIEW.md'));
  planFile('PROGRESS.md', readTemplate(templates, 'PROGRESS.md'));
  planFile('.claude/harness.json', JSON.stringify(C4_DEFAULTS, null, 2) + '\n');

  let stackObj = null;
  if (stackKey) {
    stackObj = STACKS[stackKey];
    const gatesTmpl = readTemplate(templates, 'gates.yml.tmpl');
    planFile('.github/workflows/gates.yml', renderGatesYml(gatesTmpl, stackKey, cmds));
    planFile(stackObj.thresholdFile, stackObj.thresholdContent, stackObj.thresholdForce);

    // CLAUDE.md: written only when absent, from CLAUDE.project.md, never forced.
    const claudeMdAbs = path.join(cwd, 'CLAUDE.md');
    const claudeMdExists = fs.existsSync(claudeMdAbs);
    const projectName = path.basename(cwd);
    const claudeMdContent = renderTemplate(readTemplate(templates, 'CLAUDE.project.md'), {
      PROJECT_NAME: projectName,
      TEST_CMD: cmds.test_cmd || '(none detected)',
      LINT_CMD: cmds.lint_cmd || '(none detected)',
      TYPECHECK_CMD: cmds.typecheck_cmd || '(none detected)',
      DEV_CMD: cmds.dev_cmd || '(none detected)',
      PROTECTED_PATHS: '.claude/harness.json, .github/workflows/gates.yml, tests/',
    });
    actions.push({
      path: 'CLAUDE.md',
      willWrite: !claudeMdExists,
      reason: claudeMdExists ? 'exists, skip (never overwritten by init)' : 'create',
      content: claudeMdContent,
    });
  }

  if (!dryRun) {
    for (const a of actions) {
      if (!a.willWrite) continue;
      const abs = path.join(cwd, a.path);
      fs.mkdirSync(path.dirname(abs), { recursive: true });
      fs.writeFileSync(abs, a.content);
    }
  }

  const label = dryRun ? 'WOULD WRITE' : 'WROTE';
  stdout.write(`\n${C.primary}${C.bold}harness init${C.reset} ${C.muted}(${stackKey || 'no stack'})${C.reset}\n`);
  for (const a of actions) {
    const tag = a.willWrite ? `${C.success}${label}${C.reset}` : `${C.muted}SKIP${C.reset}`;
    stdout.write(`  ${tag} ${a.path}  ${C.muted}(${a.reason})${C.reset}\n`);
  }
  stdout.write('\n');

  if (!stackKey) {
    stdout.write('no stack detected — governance files written, gates skipped\n');
  } else if (stackObj && stackObj.thresholdInstruction) {
    stdout.write(stackObj.thresholdInstruction + '\n');
  }

  return 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// install — C18: deploy the harness on this machine, idempotently
// ─────────────────────────────────────────────────────────────────────────────

// The 9 ~/.claude/<x> items C18 step 1 links; order matches the spec's list.
const INSTALL_CLAUDE_ITEMS = [
  'skills',
  'agents',
  'commands',
  'scripts',
  'hooks',
  'workflows',
  'harness-templates',
  'settings.json',
  'CLAUDE.md',
];

function printInstallHelp() {
  stdout.write(`
${C.primary}${C.bold}harness install${C.reset} ${C.muted}— deploy the harness on this machine (idempotent)${C.reset}

${C.accent}Usage:${C.reset}
  harness install [--dry-run] [--dotfiles <path>] [--marketplace <path>] [--force]

${C.accent}Options:${C.reset}
  --dotfiles <path>     Dotfiles repo root (default: $DOTFILES, $HOME/.dotfiles,
                         $HOME/dotfiles; a marketplace checkout never qualifies)
  --marketplace <path>  Marketplace repo root (default: $HARNESS_REPO, else
                         $HOME/Desktop/Projects/harness); for each plugins/<name>
                         found there, symlinks ~/.claude/skills/<name> to it
  --dry-run             Print every action; write nothing
  --force               Move a conflicting real file/dir aside, then link over it
  -h, --help            Show this help message

Ends by running \`harness doctor\` and printing its summary.
`);
}

// Default dotfiles root: $HOME/.dotfiles when it looks like a real checkout,
// else the repo that contains this CLI's own real path (C18).
// Candidates, in order: --dotfiles, $DOTFILES, $HOME/.dotfiles, $HOME/dotfiles,
// then the CLI's own repo — but only when that repo carries claude/.claude.
// A marketplace checkout never qualifies (it has no user config), so a plugin
// CLI on a machine without a dotfiles checkout returns null instead of
// silently installing from the wrong tree.
function dotfilesCandidates(argv) {
  const di = argv.indexOf('--dotfiles');
  const out = [];
  if (di !== -1 && argv[di + 1]) out.push(path.resolve(argv[di + 1]));
  if (process.env.DOTFILES) out.push(path.resolve(process.env.DOTFILES));
  out.push(path.join(HOME, '.dotfiles'), path.join(HOME, 'dotfiles'), REPO_ROOT);
  return out;
}
function resolveDotfilesRoot(argv) {
  const di = argv.indexOf('--dotfiles');
  if (di !== -1 && argv[di + 1]) return path.resolve(argv[di + 1]);
  for (const c of dotfilesCandidates(argv)) {
    if (isDir(path.join(c, 'claude', '.claude'))) return c;
  }
  return null;
}

// Default marketplace root: --marketplace, else $HARNESS_REPO, else
// $HOME/Desktop/Projects/harness (C21 M3 / C18-style "install" extension).
function resolveMarketplaceRoot(argv) {
  const mi = argv.indexOf('--marketplace');
  if (mi !== -1 && argv[mi + 1]) return path.resolve(argv[mi + 1]);
  if (process.env.HARNESS_REPO) return path.resolve(process.env.HARNESS_REPO);
  return path.join(HOME, 'Desktop', 'Projects', 'harness');
}

// One reported install action line: "<status> <path> <detail?>", where status
// is one of create|ok|skip|FAIL (C18). Assembled as a single plain-text
// string first so the status/path/detail substring a test greps for is never
// split by an ANSI colour code — colour only ever wraps the whole line.
function makeInstallReporter(pushLine) {
  return function report(status, p, detail) {
    const line = `${status} ${p}${detail ? ' ' + detail : ''}`;
    const col = status === 'create' ? C.success : status === 'ok' ? C.muted : status === 'skip' ? C.warning : C.error;
    stdout.write(`  ${col}${line}${C.reset}\n`);
    pushLine(line);
    return line;
  };
}

// Ensures <linkPath> is a symlink to <targetAbs>, RELATIVE when the dotfiles
// root is exactly $HOME/.dotfiles, else absolute (C18 step 1/2).
function installEnsureLink(opts) {
  const { linkPath, targetAbs, relative, force, dryRun, epoch, report } = opts;
  const desired = relative ? path.relative(path.dirname(linkPath), targetAbs) : targetAbs;

  let lst = null;
  try {
    lst = fs.lstatSync(linkPath);
  } catch {
    lst = null;
  }

  if (!lst) {
    if (dryRun) {
      report('skip', linkPath, `would create -> ${desired}`);
      return;
    }
    fs.mkdirSync(path.dirname(linkPath), { recursive: true });
    fs.symlinkSync(desired, linkPath);
    report('create', linkPath, `-> ${desired}`);
    return;
  }

  if (lst.isSymbolicLink()) {
    const current = fs.readlinkSync(linkPath);
    if (current === desired) {
      report('ok', linkPath, `-> ${desired}`);
      return;
    }
    if (dryRun) {
      report('skip', linkPath, `would relink -> ${desired} (was -> ${current})`);
      return;
    }
    fs.unlinkSync(linkPath);
    fs.symlinkSync(desired, linkPath);
    report('create', linkPath, `-> ${desired} (relinked, was -> ${current})`);
    return;
  }

  // A real file or directory sits where the symlink should go.
  if (!force) {
    report('FAIL', linkPath, 'exists (not a symlink)');
    return;
  }
  const backup = `${linkPath}.pre-harness.${epoch}`;
  if (dryRun) {
    report('skip', linkPath, `would move to ${backup} and link -> ${desired}`);
    return;
  }
  fs.renameSync(linkPath, backup);
  fs.symlinkSync(desired, linkPath);
  report('create', linkPath, `-> ${desired} (previous moved to ${backup})`);
}

// Link one dotfiles entry into an existing real location. Absent → link;
// identical real file → replaced by the link (nothing is lost); differing
// real file (or a real directory) → kept unless --force, which moves it to
// <name>.pre-harness.<epoch> first. Returns 'linked' | 'kept'.
function installLinkEntry(opts) {
  const { dest, targetAbs, relative, force, dryRun, epoch, report } = opts;
  const desired = relative ? path.relative(path.dirname(dest), targetAbs) : targetAbs;
  let lst = null;
  try { lst = fs.lstatSync(dest); } catch { lst = null; }
  if (!lst) {
    if (!dryRun) fs.symlinkSync(desired, dest);
    report(dryRun ? 'skip' : 'create', dest, `${dryRun ? 'would link ' : ''}-> ${desired}`);
    return 'linked';
  }
  if (lst.isSymbolicLink()) {
    const current = fs.readlinkSync(dest);
    if (current === desired) { report('ok', dest, `-> ${desired}`); return 'linked'; }
    if (!dryRun) { fs.unlinkSync(dest); fs.symlinkSync(desired, dest); }
    report(dryRun ? 'skip' : 'create', dest, `${dryRun ? 'would relink ' : ''}-> ${desired} (was -> ${current})`);
    return 'linked';
  }
  let identical = false;
  if (lst.isFile()) {
    try { identical = fs.readFileSync(dest).equals(fs.readFileSync(targetAbs)); } catch { identical = false; }
  }
  if (identical) {
    if (!dryRun) { fs.unlinkSync(dest); fs.symlinkSync(desired, dest); }
    report(dryRun ? 'skip' : 'create', dest, `${dryRun ? 'would link ' : ''}-> ${desired} (was an identical copy)`);
    return 'linked';
  }
  if (!force) {
    report('skip', dest, `differs from ${targetAbs}; kept yours (--force moves it aside and links)`);
    return 'kept';
  }
  const backup = `${dest}.pre-harness.${epoch}`;
  if (!dryRun) { fs.renameSync(dest, backup); fs.symlinkSync(desired, dest); }
  report(dryRun ? 'skip' : 'create', dest, `${dryRun ? 'would move to ' : 'previous moved to '}${backup}${dryRun ? ' and link' : ''} -> ${desired}`);
  return 'linked';
}

// A real directory already sits where ~/.claude/<x> would be linked (agents,
// commands): link each dotfiles entry into it and leave everything else in
// the directory alone — the user's own agents and commands stay.
function installMergeDir(opts) {
  const { linkDir, targetDir, relative, force, dryRun, epoch, report } = opts;
  let entries = [];
  try { entries = fs.readdirSync(targetDir).sort(); } catch { entries = []; }
  let linked = 0;
  let kept = 0;
  for (const e of entries) {
    const r = installLinkEntry({ dest: path.join(linkDir, e), targetAbs: path.join(targetDir, e), relative, force, dryRun, epoch, report });
    if (r === 'linked') linked++; else kept++;
  }
  report('ok', linkDir, `merged: ${linked} linked from ${targetDir}${kept ? `, ${kept} kept (yours)` : ''}; other files untouched`);
}

// chmod +x a single file, reporting ok/create/skip/FAIL (C18 step 3).
function installChmodFile(p, dryRun, report) {
  let st;
  try {
    st = fs.statSync(p);
  } catch {
    return;
  }
  if (!st.isFile()) return;
  if ((st.mode & 0o111) !== 0) {
    report('ok', p, 'already executable');
    return;
  }
  if (dryRun) {
    report('skip', p, 'would chmod +x');
    return;
  }
  try {
    fs.chmodSync(p, st.mode | 0o111);
    report('create', p, 'chmod +x');
  } catch (e) {
    report('FAIL', p, `chmod +x failed: ${e.message}`);
  }
}

// Step 2b (C21 M3): marketplace plugin symlinks. For each plugins/<name>
// under the marketplace repo, ensure ~/.claude/skills/<name> symlinks to
// it — same relative/absolute rule and --force backup as the dotfiles
// symlinks (installEnsureLink), keyed off whether the marketplace root is
// exactly the default $HOME/Desktop/Projects/harness. A machine with no
// marketplace checkout at all is not an error: print the copy-mode
// alternative instead.
function installMarketplaceSymlinks(argv, force, dryRun, epoch, report) {
  const marketplaceRoot = resolveMarketplaceRoot(argv);
  const marketplaceRelative = marketplaceRoot === path.join(HOME, 'Desktop', 'Projects', 'harness');
  const marketplacePluginsDir = path.join(marketplaceRoot, 'plugins');
  if (!isDir(marketplacePluginsDir)) {
    stdout.write(
      `\n  note: no marketplace checkout at ${marketplacePluginsDir} (pass --marketplace <path> or set HARNESS_REPO); ` +
        `alternative: claude plugin marketplace add TomasPalsson/harness && claude plugin install harness@harness\n`
    );
    return;
  }
  stdout.write(
    `\n${C.primary}${C.bold}harness install: marketplace plugins${C.reset} ${C.muted}(${marketplaceRoot})${C.reset}\n`
  );
  let pluginNames = [];
  try {
    pluginNames = fs.readdirSync(marketplacePluginsDir).sort();
  } catch {
    pluginNames = [];
  }
  for (const name of pluginNames) {
    const pluginDir = path.join(marketplacePluginsDir, name);
    if (!isDir(pluginDir)) continue;
    if (!fs.existsSync(path.join(pluginDir, '.claude-plugin', 'plugin.json'))) continue;
    installEnsureLink({
      linkPath: path.join(HOME, '.claude', 'skills', name),
      targetAbs: pluginDir,
      relative: marketplaceRelative,
      force,
      dryRun,
      epoch,
      report,
    });
  }
}

// chmod +x every regular file directly under <dir> whose name matches
// <predicate>. Non-recursive — a nested tests/ directory is never entered
// (satisfies "scripts/* (non-test)" without special-casing the name).
function installChmodDir(dir, predicate, dryRun, report) {
  let entries = [];
  try {
    entries = fs.readdirSync(dir).sort();
  } catch {
    entries = [];
  }
  for (const name of entries) {
    if (!predicate(name)) continue;
    installChmodFile(path.join(dir, name), dryRun, report);
  }
}

function cmdInstall(argv) {
  const dryRun = argv.includes('--dry-run');
  const force = argv.includes('--force');
  const dotfilesRoot = resolveDotfilesRoot(argv);
  if (dotfilesRoot === null) {
    stdout.write(
      `\n${C.error}harness install: no dotfiles checkout found${C.reset} (looked for claude/.claude under: ${dotfilesCandidates(argv).join(', ')})\n` +
        `  clone the dotfiles repo to ~/.dotfiles, or pass --dotfiles <path> / set DOTFILES=<path>\n`
    );
    return 1;
  }
  const relative = dotfilesRoot === path.join(HOME, '.dotfiles');
  const epoch = Math.floor(Date.now() / 1000);
  const lines = [];
  const report = makeInstallReporter((l) => lines.push(l));

  stdout.write(`\n${C.primary}${C.bold}harness install${C.reset} ${C.muted}(dotfiles: ${dotfilesRoot})${C.reset}\n`);

  // Step 1: user-level config from the dotfiles (C21: skills, hooks, scripts,
  // workflows and templates now come from the marketplace plugin, step 1b).
  const marketplaceRoot = resolveMarketplaceRoot(argv);
  const pluginMode = isDir(path.join(marketplaceRoot, 'plugins', 'harness'));
  let liveSettingsKept = false;
  for (const x of INSTALL_CLAUDE_ITEMS) {
    const fromDotfiles = path.join(dotfilesRoot, 'claude', '.claude', x);
    if (pluginMode && (!fs.existsSync(fromDotfiles) || ['skills','hooks','scripts','workflows','harness-templates'].indexOf(x) !== -1)) continue; // provided by the plugin below
    const linkPath = path.join(HOME, '.claude', x);
    let lst = null;
    try { lst = fs.lstatSync(linkPath); } catch { lst = null; }
    const isReal = !!(lst && !lst.isSymbolicLink());
    // A real ~/.claude/agents or /commands is merged, not replaced: every
    // dotfiles entry is linked in and the user's own files stay.
    if (isReal && lst.isDirectory() && (x === 'agents' || x === 'commands') && isDir(fromDotfiles)) {
      installMergeDir({ linkDir: linkPath, targetDir: fromDotfiles, relative, force, dryRun, epoch, report });
      continue;
    }
    // settings.json is machine-specific (gitignored in the dotfiles): a real
    // one in ~/.claude is the source of truth and is never replaced.
    if (isReal && x === 'settings.json') {
      liveSettingsKept = true;
      report('ok', linkPath, 'kept (machine-specific; not linked)');
      continue;
    }
    // A real CLAUDE.md: linked when identical, kept (with a note) when not.
    if (isReal && x === 'CLAUDE.md') {
      installLinkEntry({ dest: linkPath, targetAbs: fromDotfiles, relative, force, dryRun, epoch, report });
      continue;
    }
    installEnsureLink({
      linkPath,
      targetAbs: fromDotfiles,
      relative,
      force,
      dryRun,
      epoch,
      report,
    });
  }
  // Step 1b: plugin content — ~/.claude/skills is the marketplace plugins dir
  // (each plugin auto-loads in place as <name>@skills-dir); hooks, scripts and
  // templates point into the core plugin so $HOME/.claude/<x> paths keep working.
  if (pluginMode) {
    const core = path.join(marketplaceRoot, 'plugins', 'harness');
    const links = [
      ['skills', path.join(marketplaceRoot, 'plugins')],
      ['hooks', path.join(core, 'hooks')],
      ['scripts', path.join(core, 'scripts')],
      ['harness-templates', path.join(core, 'harness-templates')],
    ];
    for (const [x, targetAbs] of links) {
      installEnsureLink({ linkPath: path.join(HOME, '.claude', x), targetAbs, relative: false, force, dryRun, epoch, report });
    }
    // ~/.claude/workflows must NOT exist: the plugin registers harness:<name>; a bare
    // copy would register the same scripts twice under bare names.
    const wf = path.join(HOME, '.claude', 'workflows');
    try {
      if (fs.lstatSync(wf).isSymbolicLink()) { if (!dryRun) fs.unlinkSync(wf); report('ok', `${wf} removed (workflows come from the plugin as harness:<name>)`); }
    } catch { /* absent: fine */ }
  }

  // Step 2: ~/.local/bin/harness, plus a PATH sanity warning.
  const cliTarget = pluginMode && fs.existsSync(path.join(marketplaceRoot, 'plugins', 'harness', 'bin', 'harness'))
    ? path.join(marketplaceRoot, 'plugins', 'harness', 'bin', 'harness')
    : path.join(dotfilesRoot, 'bin', '.local', 'bin', 'harness');
  installEnsureLink({
    linkPath: path.join(HOME, '.local', 'bin', 'harness'),
    targetAbs: cliTarget,
    relative: relative && !pluginMode,
    force,
    dryRun,
    epoch,
    report,
  });
  const localBin = path.join(HOME, '.local', 'bin');
  const pathDirs = (process.env.PATH || '').split(path.delimiter);
  if (pathDirs.indexOf(localBin) === -1) {
    stdout.write(`  ${C.warning}warn ${localBin} is not on PATH${C.reset}\n`);
  }

  // Step 2b: marketplace plugin symlinks (C21 M3) — see installMarketplaceSymlinks.
  // (per-plugin symlinks superseded by step 1b: ~/.claude/skills -> <marketplace>/plugins)
  if (!pluginMode) {
    stdout.write(
      `\n  note: no marketplace checkout at ${path.join(marketplaceRoot, 'plugins')} (pass --marketplace <path> or set HARNESS_REPO); ` +
        `alternative: claude plugin marketplace add TomasPalsson/harness && claude plugin install harness@harness\n`
    );
  }

  // Step 3: chmod +x hooks/*.sh, scripts/* (non-test), and the CLI itself.
  installChmodDir(path.join(dotfilesRoot, 'claude', '.claude', 'hooks'), (n) => n.endsWith('.sh'), dryRun, report);
  installChmodDir(path.join(dotfilesRoot, 'claude', '.claude', 'scripts'), () => true, dryRun, report);
  installChmodFile(path.join(dotfilesRoot, 'bin', '.local', 'bin', 'harness'), dryRun, report);

  // Step 4: settings.json must parse and carry a "hooks" key. The dotfiles
  // copy is gitignored (machine-specific), so in plugin mode a fresh checkout
  // has none: seed a minimal one (the only harness-required key is the skill
  // index budget) rather than failing on a file that was never going to exist.
  const settingsPath = liveSettingsKept
    ? path.join(HOME, '.claude', 'settings.json')
    : path.join(dotfilesRoot, 'claude', '.claude', 'settings.json');
  let raw = safeRead(settingsPath);
  if (raw === null && pluginMode) {
    raw = JSON.stringify({ skillListingBudgetFraction: 0.02 }, null, 2) + '\n';
    if (!dryRun) fs.writeFileSync(settingsPath, raw);
    report('create', settingsPath, 'seeded (gitignored, machine-specific; add your own keys)');
  }
  let settingsOk = false;
  if (raw !== null) {
    try {
      const parsed = JSON.parse(raw);
      settingsOk = !!(parsed && typeof parsed.hooks === 'object' && parsed.hooks !== null);
    } catch {
      settingsOk = false;
    }
  }
  // Plugin mode: hooks come from the plugin's hooks.json, so settings.json must NOT
  // carry a hooks block (every hook would fire twice). Legacy mode: it must.
  let parsedSettings = null;
  try { parsedSettings = JSON.parse(raw); } catch { parsedSettings = null; }
  const hasHooksKey = !!(parsedSettings && typeof parsedSettings.hooks === 'object' && parsedSettings.hooks !== null);
  if (pluginMode) {
    if (raw === null) report('FAIL', settingsPath, 'not found');
    else if (parsedSettings === null) report('FAIL', settingsPath, 'does not parse');
    else if (hasHooksKey) report('FAIL', settingsPath, 'has a hooks key AND the plugin provides hooks.json — remove the settings block or every hook fires twice');
    else report('ok', settingsPath, 'parses; hooks come from the plugin hooks.json');
  } else if (settingsOk) {
    report('ok', settingsPath, 'parses and has a hooks key');
  } else {
    report('FAIL', settingsPath, 'has no hooks key (edit the dotfiles copy)');
  }

  // Step 5: mkdir -p the two log directories hooks write into.
  for (const d of ['transcript-backups', 'subagent-log']) {
    const p = path.join(HOME, '.claude', d);
    if (isDir(p)) {
      report('ok', p, 'exists');
    } else if (dryRun) {
      report('skip', p, 'would mkdir -p');
    } else {
      fs.mkdirSync(p, { recursive: true });
      report('create', p, 'mkdir -p');
    }
  }

  // Step 6: Mac note — rtk/better-plan/worklog are optional everywhere.
  stdout.write(`\n  note: rtk, better-plan and worklog are optional; hooks exit 0 without them.\n`);

  // Step 7: run doctor and print its summary; exit 1 if any FAIL (C18).
  // Two things doctor's own checklist cannot see on its own:
  //  (a) an install-step FAIL for an item its checklist doesn't independently
  //      cover (harness-templates isn't checked there at all; workflows is
  //      WARN-only there) — so this command's own FAIL lines (steps 1-4
  //      above) are counted here and ORed into the exit code regardless of
  //      whether doctor's checklist happens to catch the same problem;
  //  (b) a --dotfiles root that differs from doctor's own default
  //      ($HOME/.dotfiles) — dotfilesRoot is passed through explicitly so
  //      the recheck compares against the SAME root this install used,
  //      instead of always assuming $HOME/.dotfiles.
  stdout.write(`\n${C.primary}${C.bold}harness install: doctor${C.reset}\n`);
  const installFailCount = lines.filter((l) => l.indexOf('FAIL ') === 0).length;
  const doctorRc = cmdDoctor([], dotfilesRoot);
  return installFailCount > 0 || doctorRc !== 0 ? 1 : 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// check / skills-lint — thin passthroughs
// ─────────────────────────────────────────────────────────────────────────────

function cmdCheck(argv) {
  const target = sharedScript('check-all');
  if (!target) {
    stderr.write(`${C.error}harness: check-all not found (deploy the claude package or run from the harness repo)${C.reset}\n`);
    return 1;
  }
  const env = Object.assign({}, process.env, { CI: 'true' });
  const r = spawnSync(target, argv, { stdio: 'inherit', env });
  if (r.error) {
    stderr.write(`${C.error}harness: failed to exec check-all: ${r.error.message}${C.reset}\n`);
    return 1;
  }
  return r.status === null ? 1 : r.status;
}

function cmdSkillsLint(argv) {
  const target = path.join(HOME, '.claude', 'scripts', 'skills-lint');
  if (!fs.existsSync(target)) {
    stderr.write(`${C.error}harness: ${target} not found${C.reset}\n`);
    return 1;
  }
  const r = spawnSync(target, argv, { stdio: 'inherit' });
  if (r.error) {
    stderr.write(`${C.error}harness: failed to exec skills-lint: ${r.error.message}${C.reset}\n`);
    return 1;
  }
  return r.status === null ? 1 : r.status;
}

// ─────────────────────────────────────────────────────────────────────────────
// next — C23: "Next: <command>" derived only from deterministic repo state
// (no network, no model). Checked in the exact priority order the spec lists:
// (1) not a git repo, (2) PROGRESS.md's `## Now` names a resume command,
// (3) `.claude/flow.json` present (a flow is in progress), (4) no flow but
// the branch is `flow/*` with no plan file, (5) generic dirty/clean fallback.
// ─────────────────────────────────────────────────────────────────────────────

function printNextHelp() {
  stdout.write(`
${C.primary}${C.bold}harness next${C.reset} ${C.muted}— print the next command to run${C.reset}

${C.accent}Usage:${C.reset}
  harness next [--json]

${C.accent}Options:${C.reset}
  --json        Print { next, why, state } instead of plain lines
  -h, --help    Show this help message
`);
}

// stripBackticks("`cmd`") -> "cmd"; anything else is returned unchanged.
function stripBackticks(s) {
  const m = s.match(/^`([^`]+)`$/);
  return m ? m[1] : s;
}

// readProgressResume: scans PROGRESS.md's "## Now" section (until the next
// "## " heading) for a bullet that either starts with "resume:" or contains
// a backticked command, per C23 state 2. Returns { command, bullet } (bullet
// is the section's first bullet, verbatim, for the "Why" line) or null.
function readProgressResume(progressPath) {
  const raw = safeRead(progressPath);
  if (!raw) return null;
  const lines = raw.split('\n');
  let inNow = false;
  let firstBullet = null;
  for (const line of lines) {
    const trimmed = line.trim();
    if (/^##\s/.test(trimmed)) {
      if (inNow) break; // left the "## Now" section
      inNow = trimmed === '## Now';
      continue;
    }
    if (!inNow || trimmed === '') continue;
    const bullet = trimmed.replace(/^-+\s*/, '');
    if (firstBullet === null) firstBullet = bullet;
    const resumeMatch = bullet.match(/^resume:\s*(.+)$/i);
    if (resumeMatch) return { command: stripBackticks(resumeMatch[1].trim()), bullet: firstBullet };
    const backtickMatch = bullet.match(/`([^`]+)`/);
    if (backtickMatch) return { command: backtickMatch[1], bullet: firstBullet };
  }
  return null;
}

function readFlowJson(cwd) {
  const raw = safeRead(path.join(cwd, '.claude', 'flow.json'));
  if (raw === null) return null;
  try {
    return JSON.parse(raw);
  } catch {
    return null;
  }
}

// parseProgressCheckboxes: parses a document's "## Progress" section (until
// the next "## " heading) for `- [ ]`/`- [x]` checkboxes and returns
// { total, done }, or null when there is no such section or it has no
// checkbox lines. Used against BOTH `.claude/workflow-state.local.md`
// (the real, spec-documented home of live per-slice checkbox progress —
// see flow/planning.md: "Mirror each slice's sub-phases into `## Progress`
// in `.claude/workflow-state.local.md` ... that is what step 0's resume
// check reads") and the plan file itself (kept as a defensive fallback;
// the plan's own `## Progress` section, when present, normally holds
// `Ruling:` lines from the fix ladder, not checkboxes, so this yields
// null there in the common case, which is correct — it just means "no
// checkbox data here").
function parseProgressCheckboxes(raw) {
  const lines = raw.split('\n');
  let inProgress = false;
  let sawSection = false;
  let total = 0;
  let done = 0;
  for (const line of lines) {
    const trimmed = line.trim();
    if (/^##\s/.test(trimmed)) {
      if (inProgress) break;
      inProgress = trimmed === '## Progress';
      if (inProgress) sawSection = true;
      continue;
    }
    if (!inProgress) continue;
    const m = trimmed.match(/^-\s*\[([ xX])\]/);
    if (m) {
      total++;
      if (m[1].toLowerCase() === 'x') done++;
    }
  }
  if (!sawSection || total === 0) return null;
  return { total, done };
}

// sliceHeadingDoneStatus: C23 state 3(d)'s second detection method ("slice
// headings without a done marker"). Fence-aware per C7 (a `## Slice N —`
// line inside a ``` or ~~~ fence is never a heading). No "done marker"
// syntax is frozen anywhere in the spec or produced anywhere by the
// shipped flow skill, so this is a narrow, documented ASSUMPTION: a slice
// counts as done when its own section body (until the next `## ` heading)
// contains a standalone line reading "Done", "**Done**", or "Status: Done"
// (case-insensitive). Returns { total, done } (total = number of `## Slice
// <N> — ...` headings found), or null when the plan has no slice headings
// at all.
function sliceHeadingDoneStatus(raw) {
  const lines = raw.split('\n');
  let inFence = false;
  let fenceMarker = null;
  const slices = [];
  let current = null;
  const doneMarker = /^(\*\*)?done(\*\*)?$|^status:\s*done\s*$/i;
  for (const line of lines) {
    const fenceMatch = line.match(/^\s*(```|~~~)/);
    if (fenceMatch) {
      if (!inFence) {
        inFence = true;
        fenceMarker = fenceMatch[1];
      } else if (fenceMatch[1] === fenceMarker) {
        inFence = false;
        fenceMarker = null;
      }
      continue;
    }
    if (!inFence) {
      const headingMatch = line.match(/^##\s+Slice\s+\d+\s+—/);
      if (headingMatch) {
        if (current) slices.push(current);
        current = { done: false };
        continue;
      }
      if (/^##\s/.test(line.trim())) {
        if (current) slices.push(current);
        current = null;
        continue;
      }
    }
    if (current && doneMarker.test(line.trim())) current.done = true;
  }
  if (current) slices.push(current);
  if (slices.length === 0) return null;
  let done = 0;
  for (const s of slices) if (s.done) done++;
  return { total: slices.length, done };
}

// computeSliceProgress: tries, in order, (1) checkbox progress in
// `.claude/workflow-state.local.md` (the real source the flow skill
// writes and reads — see parseProgressCheckboxes's comment), (2) checkbox
// progress inside the plan file's own "## Progress" section (defensive
// fallback), (3) the slice-heading-done-marker method over the plan file.
// Returns { total, done, source } or null when none of the three yield
// anything (e.g. a plan with zero slice headings).
function computeSliceProgress(cwd, planRaw) {
  const workflowStateRaw = safeRead(path.join(cwd, '.claude', 'workflow-state.local.md'));
  if (workflowStateRaw) {
    const p = parseProgressCheckboxes(workflowStateRaw);
    if (p) return Object.assign({ source: 'workflow-state-checkboxes' }, p);
  }
  const fromPlan = parseProgressCheckboxes(planRaw);
  if (fromPlan) return Object.assign({ source: 'plan-checkboxes' }, fromPlan);
  const fromHeadings = sliceHeadingDoneStatus(planRaw);
  if (fromHeadings) return Object.assign({ source: 'slice-heading-marker' }, fromHeadings);
  return null;
}

function gitBranch(dir) {
  const r = spawnSync('git', ['-C', dir, 'branch', '--show-current'], { encoding: 'utf8' });
  if (r.status !== 0) return '';
  return (r.stdout || '').trim();
}

function gitDirty(dir) {
  const r = spawnSync('git', ['-C', dir, 'status', '--porcelain'], { encoding: 'utf8' });
  if (r.status !== 0) return false;
  return (r.stdout || '').trim() !== '';
}

function gitToplevel(dir) {
  const r = spawnSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], { encoding: 'utf8' });
  if (r.status !== 0) return null;
  return (r.stdout || '').trim();
}

// gitDefaultBranch: reads the LOCAL refs/remotes/origin/HEAD symref only
// (no fetch, no network per C23's "no network" requirement); null when it
// is not set, in which case the caller falls back to a main/master guess.
function gitDefaultBranch(dir) {
  const r = spawnSync('git', ['-C', dir, 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD'], { encoding: 'utf8' });
  if (r.status === 0 && r.stdout) {
    const s = r.stdout.trim();
    const idx = s.indexOf('/');
    return idx !== -1 ? s.slice(idx + 1) : s;
  }
  return null;
}

// computeNext(cwd) -> { next, why (string|null), state }. Pure decision
// logic, no printing — cmdNext formats it for --json or plain-text output.
function computeNext(cwd) {
  if (!isGitRepo(cwd)) {
    return { next: 'cd into a project (harness init to set one up)', why: null, state: { gitRepo: false } };
  }

  const branch = gitBranch(cwd);
  const dirty = gitDirty(cwd);
  const toplevel = gitToplevel(cwd) || cwd;

  const progressPath = path.join(cwd, 'PROGRESS.md');
  const resume = fs.existsSync(progressPath) ? readProgressResume(progressPath) : null;
  if (resume) {
    return {
      next: resume.command,
      why: `PROGRESS.md · Now: ${resume.bullet}`,
      state: { gitRepo: true, branch, dirty, source: 'progress-resume' },
    };
  }

  const flow = readFlowJson(cwd);
  const planPath = path.join(cwd, '.claude', 'feature-plan.local.md');
  const planExists = fs.existsSync(planPath);

  if (flow) {
    const flowBranch = flow.branch || '';
    const flowWorktree = flow.worktree || null;
    let mismatch = null;
    if (flowWorktree && flowWorktree !== toplevel) mismatch = flowWorktree;
    else if (flowBranch && flowBranch !== branch) mismatch = flowBranch;
    if (mismatch) {
      return {
        next: `agents ${mismatch}`,
        why: `this flow lives in ${mismatch} (branch ${flowBranch})`,
        state: { gitRepo: true, branch, dirty, source: 'flow-mismatch', flow },
      };
    }
    if (!planExists) {
      return {
        next: '/flow',
        why: `spec exists (${flow.spec_dir || ''}), plan not written`,
        state: { gitRepo: true, branch, dirty, source: 'flow-no-plan', flow },
      };
    }
    const planRaw = safeRead(planPath) || '';
    const approved = /^Approved:\s*\d{4}-\d{2}-\d{2}/m.test(planRaw);
    if (!approved) {
      return {
        next: 'review and approve the plan (then /flow continues)',
        why: null,
        state: { gitRepo: true, branch, dirty, source: 'flow-plan-unapproved', flow },
      };
    }
    const progress = computeSliceProgress(cwd, planRaw);
    if (progress && progress.done < progress.total) {
      return {
        next: '/flow',
        why: `${progress.done} of ${progress.total} slices done`,
        state: { gitRepo: true, branch, dirty, source: 'flow-slices-unfinished', flow, progress },
      };
    }
    // All slices done (or computeSliceProgress found nothing to track at
    // all — a plan with zero "## Slice N —" headings, which plan-lint
    // would already have rejected before approval — treated the same way).
    if (dirty) {
      return {
        next: '/wrap then /ship',
        why: null,
        state: { gitRepo: true, branch, dirty, source: 'flow-done-dirty', flow },
      };
    }
    const defaultBranch = gitDefaultBranch(cwd);
    const isDefault = branch === defaultBranch || branch === 'main' || branch === 'master';
    if (!isDefault) {
      return {
        next: '/ship',
        why: null,
        state: { gitRepo: true, branch, dirty, source: 'flow-done-clean', flow },
      };
    }
    // Flow tracked, all slices done, clean tree, back on the default branch:
    // nothing left for this flow to drive — fall through to the generic
    // no-flow suggestion below.
  }

  if (!flow && /^flow\//.test(branch) && !planExists) {
    return {
      next: '/flow <describe the feature>',
      why: 'spec gate is active on this branch',
      state: { gitRepo: true, branch, dirty, source: 'flow-branch-no-plan' },
    };
  }

  if (dirty) {
    return {
      next: '/wrap before leaving, or continue',
      why: null,
      state: { gitRepo: true, branch, dirty, source: 'dirty-no-flow' },
    };
  }

  return {
    next: '/flow <feature> for a feature, or just ask for a one-sentence change',
    why: null,
    state: { gitRepo: true, branch, dirty, source: 'clean-no-flow' },
  };
}

function cmdNext(argv) {
  const jsonMode = argv.includes('--json');
  const result = computeNext(process.cwd());
  if (jsonMode) {
    stdout.write(JSON.stringify({ next: result.next, why: result.why || '', state: result.state }, null, 2) + '\n');
    return 0;
  }
  stdout.write(`Next: ${result.next}\n`);
  if (result.why) stdout.write(`Why: ${result.why}\n`);
  return 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// Main
// ─────────────────────────────────────────────────────────────────────────────

function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];

  if (!cmd || cmd === '--help' || cmd === '-h') {
    printTopHelp();
    process.exit(0);
  }

  const rest = argv.slice(1);

  if (rest.includes('--help') || rest.includes('-h')) {
    if (cmd === 'init') {
      printInitHelp();
    } else if (cmd === 'install') {
      printInstallHelp();
    } else if (cmd === 'next') {
      printNextHelp();
    } else {
      printTopHelp();
    }
    process.exit(0);
  }

  if (cmd === 'doctor') process.exit(cmdDoctor(rest));
  else if (cmd === 'init') process.exit(cmdInit(rest));
  else if (cmd === 'install') process.exit(cmdInstall(rest));
  else if (cmd === 'check') process.exit(cmdCheck(rest));
  else if (cmd === 'skills-lint') process.exit(cmdSkillsLint(rest));
  else if (cmd === 'next') process.exit(cmdNext(rest));
  else {
    stderr.write(`${C.error}harness: unknown command '${cmd}'${C.reset}\n`);
    printTopHelp();
    process.exit(1);
  }
}

main();
