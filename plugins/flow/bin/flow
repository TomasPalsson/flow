};

// ── CI setup step (FU-11): driven by the detected package manager, so the
// workflow installs dependencies the way this repo actually does.
const PY_SETUP = (v) => ['      - uses: actions/setup-python@v5', '        with:', `          python-version: '${v}'`].join('\n');
const NODE_SETUP = ['      - uses: actions/setup-node@v4', '        with:', "          node-version: '20'"].join('\n');

// pythonVersion: .python-version wins, else pyproject's requires-python lower
// bound, else 3.12.
function pythonVersion(cwd) {
  const pinned = (safeRead(path.join(cwd, '.python-version')) || '').trim().split('\n')[0].trim();
  if (/^\d+\.\d+/.test(pinned)) return pinned.match(/^\d+\.\d+/)[0];
  const pyproject = safeRead(path.join(cwd, 'pyproject.toml')) || '';
  const m = pyproject.match(/requires-python\s*=\s*["'][^"']*?(\d+\.\d+)/);
  return m ? m[1] : '3.12';
}

function setupStepFor(stackKey, cwd, pkgMgr) {
  if (stackKey === 'node') {
    if (pkgMgr === 'bun') return ['      - uses: oven-sh/setup-bun@v2', '      - run: bun install --frozen-lockfile'].join('\n');
    if (pkgMgr === 'pnpm') {
      return ['      - uses: pnpm/action-setup@v4', '        with:', "          version: '9'", NODE_SETUP, '      - run: pnpm install --frozen-lockfile'].join('\n');
    }
    if (pkgMgr === 'yarn') return [NODE_SETUP, '      - run: yarn install --frozen-lockfile'].join('\n');
    return [NODE_SETUP, '      - run: npm ci'].join('\n');
  }
  if (stackKey === 'python') {
    const v = pythonVersion(cwd);
    if (pkgMgr === 'uv') {
      return ['      - uses: astral-sh/setup-uv@v5', '        with:', `          python-version: '${v}'`, '      - run: uv sync'].join('\n');
    }
    // FU-11 "start green": setup-python alone installs nothing, so the test
    // gate fails on the first CI run. Install the way this repo declares its
    // dependencies; with neither file present there is nothing to install.
    if (fs.existsSync(path.join(cwd, 'requirements.txt'))) {
      return [PY_SETUP(v), '      - run: pip install -r requirements.txt'].join('\n');
    }
    if (fs.existsSync(path.join(cwd, 'pyproject.toml'))) {
      return [PY_SETUP(v), '      - run: pip install -e .'].join('\n');
    }
    return PY_SETUP(v);
  }
  if (stackKey === 'rust') return '      - uses: dtolnay/rust-toolchain@stable';
  return ['      - uses: actions/setup-go@v5', '        with:', '          go-version-file: go.mod'].join('\n');
}

function runDetectProject(cwd) {
  const dp = detectProjectPath();
  if (!dp) return null;
  const r = spawnSync('node', [dp, '--dir', cwd], { encoding: 'utf8' });
  if (r.status !== 0 || !r.stdout) return null;
  try {
    return JSON.parse(r.stdout);
  } catch {
    return null;
  }
}

function langToStack(lang) {
  if (lang === 'typescript' || lang === 'javascript') return 'node';
  if (lang === 'python') return 'python';
  if (lang === 'rust') return 'rust';
  if (lang === 'go') return 'go';
  return null;
}

function resolveStackKey(stackArg, detected, cwd) {
  if (stackArg !== 'auto') {
    return Object.prototype.hasOwnProperty.call(STACKS, stackArg) ? stackArg : null;
  }
  if (detected && detected.language) {
    const s = langToStack(detected.language);
    if (s) return s;
  }
  if (fs.existsSync(path.join(cwd, 'package.json'))) return 'node';
  if (fs.existsSync(path.join(cwd, 'pyproject.toml'))) return 'python';
  if (fs.existsSync(path.join(cwd, 'Cargo.toml'))) return 'rust';
  if (fs.existsSync(path.join(cwd, 'go.mod'))) return 'go';
  return null;
}

// ─────────────────────────────────────────────────────────────────────────────
// init: lint thresholds (FU-12) — write a thresholds file only when the
// matching linter is actually installed here, and only with numbers at or
// above what that linter reports for this codebase today, so `flow init`
// never hands a repo a config that fails on its first run.
// ─────────────────────────────────────────────────────────────────────────────

// measuredInt(msg, re) -> the integer the rule's own phrasing puts in group 1,
// or null when the message does not carry one.
//
// The measurement must be read from a rule-specific position, never as "the
// first integer in the string": lint messages name the offending symbol, and
// identifiers carry digits of their own (sha256Digest, base64Decode, oauth2Login,
// parse2, x509). Taking the first integer of
//   "Function 'sha256Digest' has a complexity of 42. Maximum allowed is 10."
// yields 256, which would write a complexity ceiling of 256; taking it from
// "Function 'parse2' has too many lines (520)." yields 2, which is below the
// default and silently discards a 520-line function. null here means UNMEASURED,
// and the caller (initThresholdPlan) records that so `flow init` says the key
// carries a default instead of claiming a measurement it never made.
function measuredInt(msg, re) {
  const m = String(msg).match(re);
  return m ? parseInt(m[1], 10) : null;
}

function bump(maxima, key, value) {
  if (value === null) return;
  if (maxima[key] === undefined || value > maxima[key]) maxima[key] = value;
}

// eslint rule -> [threshold key, the pattern that captures the measured value].
const ESLINT_RULES = {
  'max-lines': ['maxFileLines', /too many lines \((\d+)\)/],
  'max-lines-per-function': ['maxFuncLines', /too many lines \((\d+)\)/],
  complexity: ['complexity', /complexity of (\d+)/],
  'max-params': ['maxParams', /too many parameters \((\d+)\)/],
  'max-depth': ['maxDepth', /nested too deeply \((\d+)\)/],
};

// ruff code -> [threshold key, pattern]. C901 names the function first
// ("`sha256_digest` is too complex (42 > 10)"); the PLR codes do not name it,
// but are anchored on their own wording all the same.
const RUFF_RULES = {
  C901: ['complexity', /is too complex \((\d+)/i],
  PLR0912: ['branches', /too many branches \((\d+)/i],
  PLR0913: ['args', /too many arguments[^(]*\((\d+)/i],
  PLR0915: ['statements', /too many statements \((\d+)/i],
};

function parseEslint(out) {
  const maxima = {};
  let arr;
  try {
    arr = JSON.parse(out);
  } catch {
    return maxima;
  }
  if (!Array.isArray(arr)) return maxima;
  for (const file of arr) {
    for (const m of (file && file.messages) || []) {
      const rule = ESLINT_RULES[m && m.ruleId];
      if (rule) bump(maxima, rule[0], measuredInt(m.message, rule[1]));
    }
  }
  return maxima;
}

function parseRuff(out) {
  const maxima = {};
  let arr;
  try {
    arr = JSON.parse(out);
  } catch {
    return maxima;
  }
  if (!Array.isArray(arr)) return maxima;
  for (const d of arr) {
    const rule = RUFF_RULES[d && d.code];
    if (rule) bump(maxima, rule[0], measuredInt(d.message, rule[1]));
  }
  return maxima;
}

// clippy/golangci-lint report "(<actual>/<limit>)" or "(<actual> > <limit>)".
// Each pattern anchors on the rule's own wording and captures the actual value
// in group 1 — the same rule as measuredInt: never "the first integer on the
// line", which a digit-bearing identifier would win.
function parseTextLimits(out, patterns) {
  const maxima = {};
  for (const line of String(out).split('\n')) {
    for (const [re, key] of patterns) {
      bump(maxima, key, measuredInt(line, re));
    }
  }
  return maxima;
}

// Where a stack's linter lives and how to make it report. `resolve` returns
// { cmd, args } or null when the linter is not installed for this project.
const LINTERS = {
  node: {
    resolve: (cwd) => {
      const local = path.join(cwd, 'node_modules', '.bin', 'eslint');
      if (fs.existsSync(local)) return { cmd: local, args: [] };
      return have('eslint') ? { cmd: 'eslint', args: [] } : null;
    },
    args: ['--format', 'json', '.'],
    okStatus: [0, 1],
    parse: (stdout) => parseEslint(stdout),
  },
  python: {
    resolve: (cwd) => {
      const venv = path.join(cwd, '.venv', 'bin', 'ruff');
      if (fs.existsSync(venv)) return { cmd: venv, args: [] };
      if (fs.existsSync(path.join(cwd, 'uv.lock')) && have('uv')) return { cmd: 'uv', args: ['run', '--no-sync', 'ruff'] };
      return have('ruff') ? { cmd: 'ruff', args: [] } : null;
    },
    args: ['check', '--select', 'C901,PLR0912,PLR0913,PLR0915', '--output-format', 'json', '.'],
    okStatus: [0, 1],
    parse: (stdout) => parseRuff(stdout),
  },
  rust: {
    resolve: () => (have('cargo') && have('cargo-clippy') ? { cmd: 'cargo', args: ['clippy'] } : null),
    args: ['--quiet', '--message-format', 'short'],
    okStatus: [0, 101],
    parse: (stdout, stderr) =>
      parseTextLimits(`${stdout}\n${stderr}`, [
        [/too many lines \((\d+)/, 'lines'],
        [/cognitive complexity of \((\d+)/, 'cognitive'],
        [/too many arguments \((\d+)/, 'args'],
      ]),
  },
  go: {
    resolve: () => (have('golangci-lint') ? { cmd: 'golangci-lint', args: ['run'] } : null),
    args: [],
    okStatus: [0, 1],
    parse: (stdout, stderr) =>
      parseTextLimits(`${stdout}\n${stderr}`, [
        [/is too long \((\d+)/, 'lines'],
        [/cyclomatic complexity (\d+)/, 'complexity'],
      ]),
  },
};

// measureLinter: run the stack's linter ONCE. { ok:true, maxima } or
// { ok:false, why, kind } — the caller writes nothing and prints `why`.
// `kind` is 'missing' when the linter is not installed (the only case where
// "install it" is the fix) and 'error' when it IS installed but the run
// failed, so the caller never prescribes installing a tool that is present.
function measureLinter(stackKey, cwd) {
  const spec = LINTERS[stackKey];
  const name = STACKS[stackKey].linter;
  const bin = spec.resolve(cwd);
  if (!bin) return { ok: false, kind: 'missing', why: `${name} is not installed for this project` };
  const r = spawnSync(bin.cmd, bin.args.concat(spec.args), {
    cwd,
    encoding: 'utf8',
    timeout: 120000,
    killSignal: 'SIGKILL',
    maxBuffer: 64 * 1024 * 1024,
  });
  if (r.error) return { ok: false, kind: 'error', why: `${name} could not run: ${r.error.code || r.error.message}` };
  if (r.signal) return { ok: false, kind: 'error', why: `${name} was killed (${r.signal}) after 120s` };
  if (spec.okStatus.indexOf(r.status) === -1) {
    const detail = ((r.stderr || r.stdout || '').trim().split('\n')[0] || '').slice(0, 160);
    return { ok: false, kind: 'error', why: `${name} exited ${r.status}: ${detail}` };
  }
  return { ok: true, maxima: spec.parse(r.stdout || '', r.stderr || '') };
}

// initThresholdPlan: { write:true, content, raised, unmeasured } when the
// linter ran, else { write:false, why }.
//
// FU-12 says thresholds land at or above the repo's CURRENT maximum, which
// only holds for keys the linter actually reported. A linter run against the
// repo's own config reports a rule only when that config enables it, so some
// keys routinely come back with no measurement at all: those get the harness
// default, and `unmeasured` names them so the caller can say so instead of
// printing a default as if it were measured (the default may sit below what
// the repo does today, and the gate would then start red).
function initThresholdPlan(stackKey, cwd) {
  const stack = STACKS[stackKey];
  const measured = measureLinter(stackKey, cwd);
  if (!measured.ok) return { write: false, why: measured.why, kind: measured.kind };
  const thresholds = {};
  const raised = [];
  const unmeasured = [];
  for (const key of Object.keys(stack.defaults)) {
    const observed = measured.maxima[key];
    if (observed === undefined) unmeasured.push(key);
    thresholds[key] = observed !== undefined && observed > stack.defaults[key] ? observed : stack.defaults[key];
    if (thresholds[key] !== stack.defaults[key]) raised.push(`${key} ${stack.defaults[key]}→${thresholds[key]}`);
  }
  return { write: true, content: stack.thresholdContent(thresholds), raised, unmeasured };
}

function renderGatesYml(tmplContent, stackKey, cmds, cwd) {
  const withSetup = tmplContent.replace('{{SETUP_STEP}}', setupStepFor(stackKey, cwd, cmds.pkg_mgr || ''));
  const stepDefs = [
    { placeholder: '{{TYPECHECK_CMD}}', cmd: cmds.typecheck_cmd },
    { placeholder: '{{LINT_CMD}}', cmd: cmds.lint_cmd },
    { placeholder: '{{TEST_CMD}}', cmd: cmds.test_cmd },
  ];
  const lines = withSetup.split('\n');
  const result = [];
  for (const line of lines) {
    const step = stepDefs.find((s) => line.indexOf(s.placeholder) !== -1);
    if (step) {
      if (!step.cmd) {
        result.pop(); // drop the "- name: <gate>" line pushed just before this one
        continue;
      }
      result.push(line.replace(step.placeholder, step.cmd));
      continue;
    }
    result.push(line);
  }
  return result.join('\n');
}

function renderTemplate(tmpl, vars) {
  let out = tmpl;
  for (const k of Object.keys(vars)) {
    out = out.split(`{{${k}}}`).join(vars[k]);
  }
  return out;
}

function printInitHelp() {
  stdout.write(`
${C.primary}${C.bold}flow init${C.reset} ${C.muted}— scaffold governance files, CI gate and lint thresholds${C.reset}

${C.accent}Usage:${C.reset}
  flow init [--stack auto|node|python|rust|go] [--dry-run] [--force]

${C.accent}Options:${C.reset}
  --stack <s>   Force a stack instead of auto-detecting it (default: auto)
  --dry-run     Print what would be written; write nothing
  --force       Overwrite files that already exist (CLAUDE.md is never overwritten;
                  REVIEW.md/PROGRESS.md are copied to <name>.pre-flow.<epoch> first)
  -h, --help    Show this help message
`);
}

const VALID_STACK_ARGS = ['auto', 'node', 'python', 'rust', 'go'];

// The destructive commands `flow init` denies in the project's own
// .claude/settings.json (FU-21). Written only when that file has no
// "permissions" key of its own — an existing one is never clobbered.
const INIT_DENY_RULES = [
  'Bash(git push --force*)',
  'Bash(git push -f*)',
  'Bash(git reset --hard*)',
  'Bash(git clean -f*)',
  'Bash(git branch -D*)',
  'Bash(git commit --no-verify*)',
  'Bash(rm -rf /*)',
  'Bash(rm -rf ~*)',
];

// planSettingsDeny: how (and whether) to add permissions.deny to the
// project's .claude/settings.json. Merge, never clobber.
function planSettingsDeny(cwd) {
  const rel = path.join('.claude', 'settings.json');
  const raw = safeRead(path.join(cwd, rel));
  if (raw === null) {
    return { path: rel, willWrite: true, reason: 'create (permissions.deny)', content: JSON.stringify({ permissions: { deny: INIT_DENY_RULES } }, null, 2) + '\n' };
  }
  let parsed = null;
  try {
    parsed = JSON.parse(raw);
  } catch {
    parsed = null;
  }
  if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
    return { path: rel, willWrite: false, reason: 'exists but does not parse, skip — add permissions.deny by hand', content: '' };
  }
  if (Object.prototype.hasOwnProperty.call(parsed, 'permissions')) {
    return { path: rel, willWrite: false, reason: 'has its own permissions key, skip (never clobbered)', content: '' };
  }
  parsed.permissions = { deny: INIT_DENY_RULES };
  return { path: rel, willWrite: true, reason: 'merge permissions.deny (your other keys untouched)', content: JSON.stringify(parsed, null, 2) + '\n' };
}

// initBackup: --force copies REVIEW.md/PROGRESS.md aside before overwriting.
function initBackup(cwd, rel, epoch) {
  if (rel !== 'REVIEW.md' && rel !== 'PROGRESS.md') return null;
  const abs = path.join(cwd, rel);
  if (!fs.existsSync(abs)) return null;
  const backup = `${abs}.pre-flow.${epoch}`;
  fs.copyFileSync(abs, backup);
  return path.basename(backup);
}

// thresholdNotes: what `flow init` says about a thresholds file it wrote —
// which keys it raised to a measured maximum, and which keys the linter did
// not report at all (those carry the harness default and are stated as such,
// because a default can sit below what this repo does today).
function thresholdNotes(stack, thresholds) {
  const notes = [];
  if (thresholds.raised.length) {
    notes.push(`${stack.thresholdFile}: raised to this repo's current maximum (${thresholds.raised.join(', ')}) so the gate starts green`);
  }
  if (thresholds.unmeasured.length) {
    const named = thresholds.unmeasured.map((k) => stack.settingNames[k] || k);
    const one = thresholds.unmeasured.length === 1;
    notes.push(
      `${stack.thresholdFile}: ${stack.linter} reported no ${named.join(', ')} today, so ${one ? 'that key is' : 'those keys are'} ` +
        `the harness default, not a measurement — this repo may already exceed ${one ? 'it' : 'them'} and the gate can start red`
    );
  }
  if (stack.thresholdInstruction) notes.push(stack.thresholdInstruction);
  return notes;
}

// initStackActions: the stack-specific half of the plan — CI gate, lint
// thresholds (only when the linter ran) and CLAUDE.md. Appends to `actions`
// and `notes`.
function initStackActions(ctx) {
  const { cwd, stackKey, cmds, templates, plan, actions, notes } = ctx;
  const stack = STACKS[stackKey];
  plan('.github/workflows/gates.yml', renderGatesYml(readTemplate(templates, 'gates.yml.tmpl'), stackKey, cmds, cwd));

  const thresholds = initThresholdPlan(stackKey, cwd);
  if (thresholds.write) {
    plan(stack.thresholdFile, thresholds.content, stack.thresholdForce);
    notes.push(...thresholdNotes(stack, thresholds));
  } else {
    // The fix depends on WHY the linter produced no measurement: telling a
    // user to install a linter that is already installed (it exited non-zero,
    // or was killed) is advice the tool cannot back up.
    const fix = thresholds.kind === 'missing'
      ? 'install it and re-run flow init to measure real thresholds'
      : 'fix the error above and re-run flow init to measure real thresholds';
    notes.push(`no ${stack.thresholdFile} written: ${thresholds.why} — ${fix}`);
  }

  // CLAUDE.md: written only when absent, from CLAUDE.project.md, never forced.
  const exists = fs.existsSync(path.join(cwd, 'CLAUDE.md'));
  actions.push({
    path: 'CLAUDE.md',
    willWrite: !exists,
    reason: exists ? 'exists, skip (never overwritten by init)' : 'create',
    content: renderTemplate(readTemplate(templates, 'CLAUDE.project.md'), {
      PROJECT_NAME: path.basename(cwd),
      TEST_CMD: cmds.test_cmd || '(none detected)',
      LINT_CMD: cmds.lint_cmd || '(none detected)',
      TYPECHECK_CMD: cmds.typecheck_cmd || '(none detected)',
      DEV_CMD: cmds.dev_cmd || '(none detected)',
      PROTECTED_PATHS: '.claude/flow.config.json, .github/workflows/gates.yml, tests/',
    }),
  });
}

// initApply: write the planned files (honouring --force backups) and report.
function initApply(cwd, actions, notes, opts) {
  const { dryRun, force, stackKey, loopGitignore } = opts;
  const epoch = Math.floor(Date.now() / 1000);
  const backups = [];
  if (!dryRun) {
    for (const a of actions) {
      if (!a.willWrite) continue;
      // .gitignore is appended to, never rewritten (its action has no content).
      if (a.path === '.gitignore') continue;
      if (force) {
        const b = initBackup(cwd, a.path, epoch);
        if (b) backups.push(b);
      }
      const abs = path.join(cwd, a.path);
      fs.mkdirSync(path.dirname(abs), { recursive: true });
      fs.writeFileSync(abs, a.content);
    }
    if (loopGitignore) writeLoopGitignore(loopGitignore);
  }

  const label = dryRun ? 'WOULD WRITE' : 'WROTE';
  stdout.write(`\n${C.primary}${C.bold}flow init${C.reset} ${C.muted}(${stackKey || 'no stack'})${C.reset}\n`);
  for (const a of actions) {
    const tag = a.willWrite ? `${C.success}${label}${C.reset}` : `${C.muted}SKIP${C.reset}`;
    stdout.write(`  ${tag} ${a.path}  ${C.muted}(${a.reason})${C.reset}\n`);
  }
  if (backups.length) stdout.write(`\n  kept your previous files as: ${backups.join(', ')}\n`);
  stdout.write('\n');

  const written = actions.filter((a) => a.willWrite).map((a) => a.path);
  if (written.length) stdout.write(`git add ${written.join(' ')}\n`);
  for (const n of notes) stdout.write(`${n}\n`);
  if (!stackKey) stdout.write('no stack detected — governance files written, gates skipped\n');
  return 0;
}

// K-A: `.claude/loop/*` (ignored) and `!.claude/loop/LEARNINGS.md` (kept) —
// appended once, idempotently. `flow init` never creates `.claude/loop/`
// itself; `flow loop init` does that.
function planLoopGitignore(cwd) {
  const abs = path.join(cwd, '.gitignore');
  const existing = fs.existsSync(abs) ? fs.readFileSync(abs, 'utf8') : '';
  const have = (line) => existing.split('\n').some((l) => l.trim() === line);
  let addition = '';
  if (!have('.claude/loop/*')) addition += '.claude/loop/*\n';
  if (!have('!.claude/loop/LEARNINGS.md')) addition += '!.claude/loop/LEARNINGS.md\n';
  return { abs, existing, addition };
}

function writeLoopGitignore(plan) {
  if (!plan.addition) return;
  const sep = plan.existing && !plan.existing.endsWith('\n') ? '\n' : '';
  fs.writeFileSync(plan.abs, plan.existing + sep + plan.addition);
}

function cmdInit(argv) {
  const dryRun = argv.includes('--dry-run');
  const force = argv.includes('--force');
  let stackArg = 'auto';
  const si = argv.indexOf('--stack');
  if (si !== -1 && argv[si + 1]) stackArg = argv[si + 1];

  if (VALID_STACK_ARGS.indexOf(stackArg) === -1) {
    stderr.write(
      `${C.error}flow: invalid --stack value '${stackArg}' (expected one of: ${VALID_STACK_ARGS.join('|')})${C.reset}\n`
    );
    return 1;
  }

  const cwd = process.cwd();
  const detected = runDetectProject(cwd);
  const stackKey = resolveStackKey(stackArg, detected, cwd);
  const cmds = detected || { test_cmd: '', lint_cmd: '', format_cmd: '', typecheck_cmd: '', dev_cmd: '', language: '', pkg_mgr: '' };

  const templates = templatesDir();
  const actions = [];
  const notes = [];

  function plan(relPath, content, forceable) {
    const exists = fs.existsSync(path.join(cwd, relPath));
    const willWrite = !exists || (force && forceable !== false);
    actions.push({ path: relPath, willWrite, reason: !exists ? 'create' : willWrite ? 'overwrite (--force)' : 'exists, skip', content });
  }

  plan('REVIEW.md', readTemplate(templates, 'REVIEW.md'));
  plan('PROGRESS.md', readTemplate(templates, 'PROGRESS.md'));
  plan('.claude/flow.config.json', JSON.stringify(C4_DEFAULTS, null, 2) + '\n');
  actions.push(planSettingsDeny(cwd));

  if (stackKey) initStackActions({ cwd, stackKey, cmds, templates, plan, actions, notes });

  // K-A: the loop state ignore lines are an append to an existing .gitignore,
  // not a whole-file write, so the action carries no content and initApply
  // hands it to writeLoopGitignore instead.
  const loopGitignore = planLoopGitignore(cwd);
  actions.push({
    path: '.gitignore',
    willWrite: Boolean(loopGitignore.addition),
    reason: loopGitignore.addition ? 'append loop ignore lines' : 'already present, skip',
    content: null,
  });

  return initApply(cwd, actions, notes, { dryRun, force, stackKey, loopGitignore });
}

// ─────────────────────────────────────────────────────────────────────────────
// install — C18: deploy the harness on this machine, idempotently
// ─────────────────────────────────────────────────────────────────────────────

// The 9 ~/.claude/<x> items C18 step 1 links; order matches the spec's list.
const INSTALL_CLAUDE_ITEMS = [
  'skills',
  'agents',
  'commands',
  'scripts',
  'hooks',
  'workflows',
  'flow-templates',
  'settings.json',
  'CLAUDE.md',
];

function printInstallHelp() {
  stdout.write(`
${C.primary}${C.bold}flow install${C.reset} ${C.muted}— deploy the harness on this machine (idempotent)${C.reset}

${C.accent}Usage:${C.reset}
  flow install [--dry-run] [--dotfiles <path>] [--marketplace <path>] [--force]

${C.accent}Options:${C.reset}
  --dotfiles <path>     Dotfiles repo root (default: $DOTFILES, $HOME/.dotfiles,
                         $HOME/dotfiles; a marketplace checkout never qualifies)
  --marketplace <path>  Marketplace repo root (default: $FLOW_REPO, else the
                         checkout this CLI runs from); for each plugins/<name>
                         found there, symlinks ~/.claude/skills/<name> to it
  --dry-run             Print every action; write nothing
  --force               Move a conflicting real file/dir aside, then link over it
  -h, --help            Show this help message

Ends by running \`flow doctor\` and printing its summary. That recheck includes
doctor's gates-runnable check, which EXECUTES this project's own test/lint/
format/typecheck scripts from the cwd (120s cap per gate) — run it from a
directory whose gates you are willing to have run.
`);
}

// Default dotfiles root: $HOME/.dotfiles when it looks like a real checkout,
// else the repo that contains this CLI's own real path (C18).
// Candidates, in order: --dotfiles, $DOTFILES, $HOME/.dotfiles, $HOME/dotfiles,
// then the CLI's own repo — but only when that repo carries claude/.claude.
// A marketplace checkout never qualifies (it has no user config), so a plugin
// CLI on a machine without a dotfiles checkout returns null instead of
// silently installing from the wrong tree.
// flagValue(argv, name) — the value after --<name>, or null when the flag is
// absent. B24: a flag-shaped value (`--dotfiles --force`) is a typo, never a
// path; it is reported by pathFlagError below instead of being resolved into
// a directory named "--force".
function flagValue(argv, name) {
  const i = argv.indexOf(name);
  if (i === -1) return null;
  const v = argv[i + 1];
  if (!v || v.charAt(0) === '-') return null;
  return v;
}

// pathFlagError(argv) — a message when --dotfiles/--marketplace was given
// without a usable path, else null.
function pathFlagError(argv) {
  for (const name of ['--dotfiles', '--marketplace']) {
    const i = argv.indexOf(name);
    if (i === -1) continue;
    const v = argv[i + 1];
    if (v === undefined) return `${name} needs a path (nothing followed it)`;
    if (v.charAt(0) === '-') return `${name} needs a path, got the flag '${v}'`;
  }
  return null;
}

function dotfilesCandidates(argv) {
  const out = [];
  const explicit = flagValue(argv, '--dotfiles');
  if (explicit) out.push(path.resolve(explicit));
  if (process.env.DOTFILES) out.push(path.resolve(process.env.DOTFILES));
  out.push(path.join(HOME, '.dotfiles'), path.join(HOME, 'dotfiles'), REPO_ROOT);
  return out;
}
function resolveDotfilesRoot(argv) {
  const explicit = flagValue(argv, '--dotfiles');
  if (explicit) return path.resolve(explicit);
  for (const c of dotfilesCandidates(argv)) {
    if (isDir(path.join(c, 'claude', '.claude'))) return c;
  }
  return null;
}

// Default marketplace root: --marketplace, else $FLOW_REPO, else REPO_ROOT —
// the checkout this CLI itself is running from (B24: never a hardcoded
// $HOME/Desktop/... path, which is wrong on every machine but one).
function resolveMarketplaceRoot(argv) {
  const explicit = flagValue(argv, '--marketplace');
  if (explicit) return path.resolve(explicit);
  if (process.env.FLOW_REPO) return path.resolve(process.env.FLOW_REPO);
  return REPO_ROOT;
}

// One reported install action line: "<status> <path> <detail?>", where status
// is one of create|ok|skip|FAIL (C18). Assembled as a single plain-text
// string first so the status/path/detail substring a test greps for is never
// split by an ANSI colour code — colour only ever wraps the whole line.
function makeInstallReporter(pushLine) {
  return function report(status, p, detail) {
    const line = `${status} ${p}${detail ? ' ' + detail : ''}`;
    const col = status === 'create' ? C.success : status === 'ok' ? C.muted : status === 'skip' ? C.warning : C.error;
    stdout.write(`  ${col}${line}${C.reset}\n`);
    pushLine(line);
    return line;
  };
}

// Ensures <linkPath> is a symlink to <targetAbs>, RELATIVE when the dotfiles
// root is exactly $HOME/.dotfiles, else absolute (C18 step 1/2).
function installEnsureLink(opts) {
  const { linkPath, targetAbs, relative, force, dryRun, epoch, report } = opts;
  const desired = relative ? path.relative(path.dirname(linkPath), targetAbs) : targetAbs;

  // B24: never create a link to something that is not there — a broken
  // symlink in ~/.claude looks deployed and fails at hook time instead.
  if (!fs.existsSync(targetAbs)) {
    report('FAIL', linkPath, `link target ${targetAbs} does not exist; nothing was linked`);
    return;
  }

  let lst = null;
  try {
    lst = fs.lstatSync(linkPath);
  } catch {
    lst = null;
  }

  if (!lst) {
    if (dryRun) {
      report('skip', linkPath, `would create -> ${desired}`);
      return;
    }
    fs.mkdirSync(path.dirname(linkPath), { recursive: true });
    fs.symlinkSync(desired, linkPath);
    report('create', linkPath, `-> ${desired}`);
    return;
  }

  if (lst.isSymbolicLink()) {
    const current = fs.readlinkSync(linkPath);
    if (current === desired) {
      report('ok', linkPath, `-> ${desired}`);
      return;
    }
    if (dryRun) {
      report('skip', linkPath, `would relink -> ${desired} (was -> ${current})`);
      return;
    }
    fs.unlinkSync(linkPath);
    fs.symlinkSync(desired, linkPath);
    report('create', linkPath, `-> ${desired} (relinked, was -> ${current})`);
    return;
  }

  // A real file or directory sits where the symlink should go.
  if (!force) {
    report('FAIL', linkPath, 'exists (not a symlink)');
    return;
  }
  const backup = `${linkPath}.pre-harness.${epoch}`;
  if (dryRun) {
    report('skip', linkPath, `would move to ${backup} and link -> ${desired}`);
    return;
  }
  fs.renameSync(linkPath, backup);
  fs.symlinkSync(desired, linkPath);
  report('create', linkPath, `-> ${desired} (previous moved to ${backup})`);
}

// Link one dotfiles entry into an existing real location. Absent → link;
// identical real file → replaced by the link (nothing is lost); differing
// real file (or a real directory) → kept unless --force, which moves it to
// <name>.pre-harness.<epoch> first. Returns 'linked' | 'kept'.
// samePhysicalPath(a, b): do these two paths name the same file on disk?
// Compares the resolved PARENT plus the basename, because realpath on a
// self-referential link throws ELOOP — which is exactly the case this guards.
function samePhysicalPath(a, b) {
  try {
    return path.join(fs.realpathSync(path.dirname(a)), path.basename(a))
      === path.join(fs.realpathSync(path.dirname(b)), path.basename(b));
  } catch {
    return false;
  }
}

function installLinkEntry(opts) {
  const { dest, targetAbs, relative, force, dryRun, epoch, report } = opts;
  // ~/.claude can itself be a symlink INTO the dotfiles, which makes dest and
  // targetAbs the same file. Without this guard the "identical real file"
  // branch below unlinks the source and symlinks it to itself: the content is
  // destroyed and every reader gets ELOOP. It ate this machine's five agents,
  // four commands and CLAUDE.md, and git was the only reason they came back.
  if (samePhysicalPath(dest, targetAbs)) {
    report('ok', dest, `is ${targetAbs} — the deployment already lives in the dotfiles; nothing to link`);
    return 'linked';
  }
  const desired = relative ? path.relative(path.dirname(dest), targetAbs) : targetAbs;
  let lst = null;
  try { lst = fs.lstatSync(dest); } catch { lst = null; }
  if (!lst) {
    if (!dryRun) fs.symlinkSync(desired, dest);
    report(dryRun ? 'skip' : 'create', dest, `${dryRun ? 'would link ' : ''}-> ${desired}`);
    return 'linked';
  }
  if (lst.isSymbolicLink()) {
    const current = fs.readlinkSync(dest);
    if (current === desired) { report('ok', dest, `-> ${desired}`); return 'linked'; }
    if (!dryRun) { fs.unlinkSync(dest); fs.symlinkSync(desired, dest); }
    report(dryRun ? 'skip' : 'create', dest, `${dryRun ? 'would relink ' : ''}-> ${desired} (was -> ${current})`);
    return 'linked';
  }
  let identical = false;
  if (lst.isFile()) {
    try { identical = fs.readFileSync(dest).equals(fs.readFileSync(targetAbs)); } catch { identical = false; }
  }
  if (identical) {
    if (!dryRun) { fs.unlinkSync(dest); fs.symlinkSync(desired, dest); }
    report(dryRun ? 'skip' : 'create', dest, `${dryRun ? 'would link ' : ''}-> ${desired} (was an identical copy)`);
    return 'linked';
  }
  if (!force) {
    report('skip', dest, `differs from ${targetAbs}; kept yours (--force moves it aside and links)`);
    return 'kept';
  }
  const backup = `${dest}.pre-harness.${epoch}`;
  if (!dryRun) { fs.renameSync(dest, backup); fs.symlinkSync(desired, dest); }
  report(dryRun ? 'skip' : 'create', dest, `${dryRun ? 'would move to ' : 'previous moved to '}${backup}${dryRun ? ' and link' : ''} -> ${desired}`);
  return 'linked';
}

// A real directory already sits where ~/.claude/<x> would be linked (agents,
// commands): link each dotfiles entry into it and leave everything else in
// the directory alone — the user's own agents and commands stay.
function installMergeDir(opts) {
  const { linkDir, targetDir, relative, force, dryRun, epoch, report } = opts;
  let entries = [];
  try { entries = fs.readdirSync(targetDir).sort(); } catch { entries = []; }
  let linked = 0;
  let kept = 0;
  for (const e of entries) {
    const r = installLinkEntry({ dest: path.join(linkDir, e), targetAbs: path.join(targetDir, e), relative, force, dryRun, epoch, report });
    if (r === 'linked') linked++; else kept++;
  }
  report('ok', linkDir, `merged: ${linked} linked from ${targetDir}${kept ? `, ${kept} kept (yours)` : ''}; other files untouched`);
}

// chmod +x a single file, reporting ok/create/skip/FAIL (C18 step 3).
function installChmodFile(p, dryRun, report) {
  let st;
  try {
    st = fs.statSync(p);
  } catch {
    return;
  }
  if (!st.isFile()) return;
  if ((st.mode & 0o111) !== 0) {
    report('ok', p, 'already executable');
    return;
  }
  if (dryRun) {
    report('skip', p, 'would chmod +x');
    return;
  }
  try {
    fs.chmodSync(p, st.mode | 0o111);
    report('create', p, 'chmod +x');
  } catch (e) {
    report('FAIL', p, `chmod +x failed: ${e.message}`);
  }
}

// chmod +x every regular file directly under <dir> whose name matches
// <predicate>. Non-recursive — a nested tests/ directory is never entered
// (satisfies "scripts/* (non-test)" without special-casing the name).
function installChmodDir(dir, predicate, dryRun, report) {
  let entries = [];
  try {
    entries = fs.readdirSync(dir).sort();
  } catch {
    entries = [];
  }
  for (const name of entries) {
    if (!predicate(name)) continue;
    installChmodFile(path.join(dir, name), dryRun, report);
  }
}

function cmdInstall(argv) {
  const dryRun = argv.includes('--dry-run');
  const force = argv.includes('--force');
  const flagErr = pathFlagError(argv);
  if (flagErr) {
    stderr.write(`${C.error}flow install: ${flagErr}${C.reset}\n`);
    return 1;
  }
  const dotfilesRoot = resolveDotfilesRoot(argv);
  if (dotfilesRoot === null) {
    stdout.write(
      `\n${C.error}flow install: no dotfiles checkout found${C.reset} (looked for claude/.claude under: ${dotfilesCandidates(argv).join(', ')})\n` +
        `  clone the dotfiles repo to ~/.dotfiles, or pass --dotfiles <path> / set DOTFILES=<path>\n`
    );
    return 1;
  }
  const relative = dotfilesRoot === path.join(HOME, '.dotfiles');
  const epoch = Math.floor(Date.now() / 1000);
  const lines = [];
  const report = makeInstallReporter((l) => lines.push(l));

  stdout.write(`\n${C.primary}${C.bold}flow install${C.reset} ${C.muted}(dotfiles: ${dotfilesRoot})${C.reset}\n`);

  // Step 1: user-level config from the dotfiles (C21: skills, hooks, scripts,
  // workflows and templates now come from the marketplace plugin, step 1b).
  const marketplaceRoot = resolveMarketplaceRoot(argv);
  const pluginMode = isDir(path.join(marketplaceRoot, 'plugins', 'flow'));
  let liveSettingsKept = false;
  for (const x of INSTALL_CLAUDE_ITEMS) {
    const fromDotfiles = path.join(dotfilesRoot, 'claude', '.claude', x);
    if (pluginMode && (!fs.existsSync(fromDotfiles) || ['skills','hooks','scripts','workflows','flow-templates'].indexOf(x) !== -1)) continue; // provided by the plugin below
    const linkPath = path.join(HOME, '.claude', x);
    let lst = null;
    try { lst = fs.lstatSync(linkPath); } catch { lst = null; }
    const isReal = !!(lst && !lst.isSymbolicLink());
    // A real ~/.claude/agents or /commands is merged, not replaced: every
    // dotfiles entry is linked in and the user's own files stay.
    if (isReal && lst.isDirectory() && (x === 'agents' || x === 'commands') && isDir(fromDotfiles)) {
      installMergeDir({ linkDir: linkPath, targetDir: fromDotfiles, relative, force, dryRun, epoch, report });
      continue;
    }
    // settings.json is machine-specific (gitignored in the dotfiles): a real
    // one in ~/.claude is the source of truth and is never replaced.
    if (isReal && x === 'settings.json') {
      liveSettingsKept = true;
      report('ok', linkPath, 'kept (machine-specific; not linked)');
      continue;
    }
    // A real CLAUDE.md: linked when identical, kept (with a note) when not.
    if (isReal && x === 'CLAUDE.md') {
      installLinkEntry({ dest: linkPath, targetAbs: fromDotfiles, relative, force, dryRun, epoch, report });
      continue;
    }
    installEnsureLink({
      linkPath,
      targetAbs: fromDotfiles,
      relative,
      force,
      dryRun,
      epoch,
      report,
    });
  }
  // Step 1b: plugin content — ~/.claude/skills is the marketplace plugins dir
  // (each plugin auto-loads in place as <name>@skills-dir); hooks, scripts and
  // templates point into the core plugin so $HOME/.claude/<x> paths keep working.
  if (pluginMode) {
    const core = path.join(marketplaceRoot, 'plugins', 'flow');
    const links = [
      ['skills', path.join(marketplaceRoot, 'plugins')],
      ['hooks', path.join(core, 'hooks')],
      ['scripts', path.join(core, 'scripts')],
      ['flow-templates', path.join(core, 'flow-templates')],
    ];
    for (const [x, targetAbs] of links) {
      installEnsureLink({ linkPath: path.join(HOME, '.claude', x), targetAbs, relative: false, force, dryRun, epoch, report });
    }
    // ~/.claude/workflows must NOT exist: the plugin registers flow:<name>; a bare
    // copy would register the same scripts twice under bare names.
    const wf = path.join(HOME, '.claude', 'workflows');
    try {
      if (fs.lstatSync(wf).isSymbolicLink()) { if (!dryRun) fs.unlinkSync(wf); report('ok', `${wf} removed (workflows come from the plugin as flow:<name>)`); }
    } catch { /* absent: fine */ }
  }

  // Step 2: ~/.local/bin/flow, plus a PATH sanity warning.
  const cliTarget = pluginMode && fs.existsSync(path.join(marketplaceRoot, 'plugins', 'flow', 'bin', 'flow'))
    ? path.join(marketplaceRoot, 'plugins', 'flow', 'bin', 'flow')
    : path.join(dotfilesRoot, 'bin', '.local', 'bin', 'flow');
  installEnsureLink({
    linkPath: path.join(HOME, '.local', 'bin', 'flow'),
    targetAbs: cliTarget,
    relative: relative && !pluginMode,
    force,
    dryRun,
    epoch,
    report,
  });
  const localBin = path.join(HOME, '.local', 'bin');
  const pathDirs = (process.env.PATH || '').split(path.delimiter);
  if (pathDirs.indexOf(localBin) === -1) {
    stdout.write(`  ${C.warning}warn ${localBin} is not on PATH${C.reset}\n`);
  }

  // Step 2b: marketplace plugins (C21 M3). Per-plugin symlinks are superseded
  // by step 1b, which links ~/.claude/skills -> <marketplace>/plugins wholesale;
  // all that is left here is telling the user when no marketplace was found.
  if (!pluginMode) {
    stdout.write(
      `\n  note: no marketplace checkout at ${path.join(marketplaceRoot, 'plugins')} (pass --marketplace <path> or set FLOW_REPO); ` +
        `alternative: claude plugin marketplace add TomasPalsson/flow && claude plugin install flow@flow\n`
    );
  }

  // Step 3: chmod +x hooks/*.sh, scripts/* (non-test), and the CLI itself.
  installChmodDir(path.join(dotfilesRoot, 'claude', '.claude', 'hooks'), (n) => n.endsWith('.sh'), dryRun, report);
  installChmodDir(path.join(dotfilesRoot, 'claude', '.claude', 'scripts'), () => true, dryRun, report);
  installChmodFile(path.join(dotfilesRoot, 'bin', '.local', 'bin', 'flow'), dryRun, report);

  // Step 4: settings.json must parse and carry a "hooks" key. The dotfiles
  // copy is gitignored (machine-specific), so in plugin mode a fresh checkout
  // has none: seed a minimal one (the only harness-required key is the skill
  // index budget) rather than failing on a file that was never going to exist.
  const settingsPath = liveSettingsKept
    ? path.join(HOME, '.claude', 'settings.json')
    : path.join(dotfilesRoot, 'claude', '.claude', 'settings.json');
  let raw = safeRead(settingsPath);
  if (raw === null && pluginMode) {
    raw = JSON.stringify({ skillListingBudgetFraction: 0.02 }, null, 2) + '\n';
    if (!dryRun) fs.writeFileSync(settingsPath, raw);
    report('create', settingsPath, 'seeded (gitignored, machine-specific; add your own keys)');
  }
  let settingsOk = false;
  if (raw !== null) {
    try {
      const parsed = JSON.parse(raw);
      settingsOk = !!(parsed && typeof parsed.hooks === 'object' && parsed.hooks !== null);
    } catch {
      settingsOk = false;
    }
  }
  // Plugin mode: hooks come from the plugin's hooks.json, so settings.json must NOT
  // carry a hooks block (every hook would fire twice). Legacy mode: it must.
  let parsedSettings = null;
  try { parsedSettings = JSON.parse(raw); } catch { parsedSettings = null; }
  const hasHooksKey = !!(parsedSettings && typeof parsedSettings.hooks === 'object' && parsedSettings.hooks !== null);
  if (pluginMode) {
    if (raw === null) report('FAIL', settingsPath, 'not found');
    else if (parsedSettings === null) report('FAIL', settingsPath, 'does not parse');
    else if (hasHooksKey) report('FAIL', settingsPath, 'has a hooks key AND the plugin provides hooks.json — remove the settings block or every hook fires twice');
    else report('ok', settingsPath, 'parses; hooks come from the plugin hooks.json');
  } else if (settingsOk) {
    report('ok', settingsPath, 'parses and has a hooks key');
  } else {
    report('FAIL', settingsPath, 'has no hooks key (edit the dotfiles copy)');
  }

  // Step 5: mkdir -p the two log directories hooks write into.
  for (const d of ['transcript-backups', 'subagent-log']) {
    const p = path.join(HOME, '.claude', d);
    if (isDir(p)) {
      report('ok', p, 'exists');
    } else if (dryRun) {
      report('skip', p, 'would mkdir -p');
    } else {
      fs.mkdirSync(p, { recursive: true });
      report('create', p, 'mkdir -p');
    }
  }

  // Step 6: Mac note — rtk/better-plan/worklog are optional everywhere.
  stdout.write(`\n  note: rtk, better-plan and worklog are optional; hooks exit 0 without them.\n`);

  // Step 7: run doctor and print its summary; exit 1 if any FAIL (C18).
  // Two things doctor's own checklist cannot see on its own:
  //  (a) an install-step FAIL for an item its checklist doesn't independently
  //      cover (flow-templates isn't checked there at all; workflows is
  //      WARN-only there) — so this command's own FAIL lines (steps 1-4
  //      above) are counted here and ORed into the exit code regardless of
  //      whether doctor's checklist happens to catch the same problem;
  //  (b) a --dotfiles root that differs from doctor's own default
  //      ($HOME/.dotfiles) — dotfilesRoot is passed through explicitly so
  //      the recheck compares against the SAME root this install used,
  //      instead of always assuming $HOME/.dotfiles.
  stdout.write(`\n${C.primary}${C.bold}flow install: doctor${C.reset}\n`);
  const installFailCount = lines.filter((l) => l.indexOf('FAIL ') === 0).length;
  const doctorRc = cmdDoctor([], dotfilesRoot);
  return installFailCount > 0 || doctorRc !== 0 ? 1 : 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// check / skills-lint — thin passthroughs
// ─────────────────────────────────────────────────────────────────────────────

function cmdCheck(argv) {
  const target = sharedScript('check-all');
  if (!target) {
    stderr.write(`${C.error}flow: check-all not found (deploy the claude package or run from the harness repo)${C.reset}\n`);
    return 1;
  }
  const env = Object.assign({}, process.env, { CI: 'true' });
  const r = spawnSync(target, argv, { stdio: 'inherit', env });
  if (r.error) {
    stderr.write(`${C.error}flow: failed to exec check-all: ${r.error.message}${C.reset}\n`);
    return 1;
  }
  return r.status === null ? 1 : r.status;
}

function cmdSkillsLint(argv) {
  const target = path.join(HOME, '.claude', 'scripts', 'skills-lint');
  if (!fs.existsSync(target)) {
    stderr.write(`${C.error}flow: ${target} not found${C.reset}\n`);
    return 1;
  }
  const r = spawnSync(target, argv, { stdio: 'inherit' });
  if (r.error) {
    stderr.write(`${C.error}flow: failed to exec skills-lint: ${r.error.message}${C.reset}\n`);
    return 1;
  }
  return r.status === null ? 1 : r.status;
}

// ─────────────────────────────────────────────────────────────────────────────
// next — spec 004 K-C: "Next: <command>" derived only from deterministic repo
// state (no network, no model). The 14-row state machine lives in
// bin/lib/router.js; computeNext below checks only the two things that come
// before it — is this a git repo, and is a loop contract active — and hands
// the rest to the router. Position is recomputed from disk on every call, so
// /clear, a crash, a compaction and a git checkout all self-heal.
// ─────────────────────────────────────────────────────────────────────────────

function printNextHelp() {
  stdout.write(`
${C.primary}${C.bold}flow next${C.reset} ${C.muted}— print the next command to run${C.reset}

${C.accent}Usage:${C.reset}
  flow next [--json] [--force] [--peek]

${C.accent}Options:${C.reset}
  --json        Print { state, state_no, command, why, after, gates, feature, wave }
                instead of the plain Next:/Why:/Then: lines.
  --force       Carry on past a hard stop: BLOCKED.md, another approved feature
                with open tasks, or five calls with no state change.
  --peek        Read the state without moving the consecutive-call counter, for
                a hook or a status line. A real turn must not pass it.
  -h, --help    Show this help message

${C.accent}Position is recomputed from disk on every call${C.reset}
  \$FLOW_SPEC → .specs/.current → branch flow/<slug>, anchored at the git
  toplevel. Nothing lives in the transcript, so /clear, a crash, a compaction
  and a git checkout all self-heal. PROGRESS.md is never consulted.
`);
}

// oneLine(s): s with every control character collapsed to a space, so a
// printed line is exactly one line. The last-resort guarantee that plain
// `flow next` emits at most 2 lines (C-D / G6's 2-line Next: block).
function oneLine(s) {
  return String(s).replace(/[\x00-\x1F\x7F]+/g, ' ').replace(/\s+$/, '');
}

function gitBranch(dir) {
  const r = spawnSync('git', ['-C', dir, 'branch', '--show-current'], { encoding: 'utf8' });
  if (r.status !== 0) return '';
  return (r.stdout || '').trim();
}

function gitDirty(dir) {
  const r = spawnSync('git', ['-C', dir, 'status', '--porcelain'], { encoding: 'utf8' });
  if (r.status !== 0) return false;
  return (r.stdout || '').trim() !== '';
}

function gitToplevel(dir) {
  const r = spawnSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], { encoding: 'utf8' });
  if (r.status !== 0) return null;
  return (r.stdout || '').trim();
}

// physicalPath: the fully resolved path, or the input when it cannot be
// resolved (B21-23: worktree comparisons must not fail over /var vs
// /private/var or a symlinked checkout).
function physicalPath(p) {
  try {
    return fs.realpathSync(p);
  } catch {
    return p;
  }
}

// K-L: null unless `.claude/loop/loop.md` at the git toplevel is active, in
// which case the loop's shape picks the resume command.
function computeNextLoopActive(toplevel, branch, dirty) {
  const loopRaw = safeRead(path.join(toplevel, '.claude', 'loop', 'loop.md'));
  if (loopRaw === null) return null;
  let loopFront = null;
  try {
    ({ front: loopFront } = require('./lib/loop.js').parseContract(loopRaw));
  } catch {
    loopFront = null;
  }
  if (!loopFront || loopFront.status !== 'active') return null;
  const command = loopFront.shape === 'fresh' ? 'flow loop run' : 'flow loop status';
  // why stays null: K-L pins `flow next` under an active loop to the single
  // line `Next: flow loop run` (test_loop.sh asserts it exactly), and the
  // loop's own status output is where the detail belongs.
  return {
    state: 'loop-active', state_no: 1, command, why: null,
    after: null, human_gate: false, feature: null, wave: null,
    gates: { blocked: false, lint_error: false, unreachable_done: false, scan_failed: false, consecutive_calls: 0 },
  };
}

// computeNext(cwd) -> { next, why (string|null), state }. Pure decision logic,
// no printing — cmdNext formats it for --json or plain-text output. `next` is
// always a runnable command or a slash command (C-D), never prose.
function computeNext(cwd, opts) {
  if (!isGitRepo(cwd)) {
    return {
      state: 'scan-failed', state_no: 0, command: 'flow init', why: `${cwd} is not a git repo`,
      after: null, human_gate: false, feature: null, wave: null,
      gates: { blocked: false, lint_error: false, unreachable_done: false, scan_failed: true, consecutive_calls: 0 },
    };
  }
  // FU-09/L2: every predicate below is read from the repo root, so `flow next`
  // gives the same answer at the root and in src/lib/api.
  const root = gitToplevel(cwd) || cwd;
  const ctx = { branch: gitBranch(root), dirty: gitDirty(root) };

  // K-L: an active loop contract is the one thing checked before the router.
  const loopNext = computeNextLoopActive(root, ctx.branch, ctx.dirty);
  if (loopNext) return loopNext;

  // PROGRESS.md is NEVER consulted here. A stale `## Now` bullet used to
  // return before any flow state was read and silently outrank the whole
  // router (research 11 §5, L5); the router owns the answer now.
  return require('./lib/router.js').routeWithCount(root, ctx, opts || {});
}

// flow off / flow on — a .claude/flow.off marker in <dir>. Every judging hook
// (format, size, tamper, spec, stop, git guard, lesson nudge, codebase map)
// exits 0 when the marker sits in the project dir or any ancestor; the
// session-start hook says so on the first line. The marker is kept out of
// git via .git/info/exclude (a local choice, never a tracked file).
// Keep a marker out of git via .git/info/exclude — a local choice, never a
// tracked file.
function excludeMarkerLocally(dir, rel) {
  const top = spawnSync('git', ['-C', dir, 'rev-parse', '--show-toplevel'], { encoding: 'utf8' });
  if (top.status !== 0) return;
  const exclude = path.join(top.stdout.trim(), '.git', 'info', 'exclude');
  try {
    const cur = safeRead(exclude) || '';
    if (cur.indexOf(rel) === -1) fs.appendFileSync(exclude, `${cur.endsWith('\n') || cur === '' ? '' : '\n'}${rel}\n`);
  } catch { /* not fatal */ }
}

function writeMarker(dir, name, body) {
  const marker = path.join(dir, '.claude', name);
  if (fs.existsSync(marker)) return false;
  fs.mkdirSync(path.dirname(marker), { recursive: true });
  fs.writeFileSync(marker, body);
  excludeMarkerLocally(dir, `.claude/${name}`);
  return true;
}

function cmdOffOn(cmd, argv) {
  const dirArg = argv.find((a) => !a.startsWith('--'));
  const unsafe = argv.includes('--unsafe');
  const dir = path.resolve(dirArg || process.cwd());
  if (!isDir(dir)) { stderr.write(`${C.error}flow ${cmd}: no such directory ${dir}${C.reset}\n`); return 2; }
  const off = path.join(dir, '.claude', 'flow.off');
  const unsafeMarker = path.join(dir, '.claude', 'flow.unsafe');
  const stamp = new Date().toISOString();
  if (cmd === 'off') {
    const wroteOff = writeMarker(dir, 'flow.off',
      `flow off — judging hooks disabled for this directory and everything under it.\nRun \`flow on\` here to re-enable. Written ${stamp}.\n`);
    // C-B: git-guard is NOT silenced by flow.off; only `flow off --unsafe`
    // writes the separate marker it honours.
    const wroteUnsafe = unsafe && writeMarker(dir, 'flow.unsafe',
      `flow off --unsafe — git-guard disabled for this directory and everything under it.\nRun \`flow on\` here to re-enable. Written ${stamp}.\n`);
    if (!wroteOff && !wroteUnsafe) {
      stdout.write(`flow: already off in ${dir}${unsafe ? ' (including git-guard)' : ''}\n`);
      return 0;
    }
    stdout.write(`flow: hooks OFF in ${dir} (marker ${off}; \`flow on\` re-enables)\n`);
    if (unsafe) stdout.write(`flow: git-guard OFF too (marker ${unsafeMarker}) — destructive git commands are no longer refused here\n`);
    else stdout.write(`flow: git-guard stays ON (it is not silenced by flow off; use \`flow off --unsafe\` to disable it too)\n`);
    return 0;
  }
  let removed = 0;
  for (const m of [off, unsafeMarker]) {
    if (fs.existsSync(m)) { fs.unlinkSync(m); removed++; }
  }
  if (removed === 0) { stdout.write(`flow: already on in ${dir}\n`); return 0; }
  stdout.write(`flow: hooks ON in ${dir}\n`);
  return 0;
}

function cmdNext(argv) {
  const jsonMode = argv.includes('--json');
  const result = computeNext(process.cwd(), {
    force: argv.includes('--force'),
    // The /flow:next skill's own read is `flow next --json`, so --json MUST
    // count or row 1c can never fire for the thing it exists to bound. The
    // read-only door is --peek, for session-context.sh, a status line or any
    // other passive observer (flow doctor asks in-process with count:false).
    count: !argv.includes('--peek'),
  });
  if (jsonMode) {
    stdout.write(JSON.stringify({
      state: result.state,
      state_no: result.state_no,
      command: result.command,
      why: result.why || '',
      after: result.after,
      human_gate: !!result.human_gate,
      gates: result.gates,
      feature: result.feature,
      wave: result.wave,
    }, null, 2) + '\n');
    return 0;
  }
  // Plain mode is read by session-context (G6) line by line, so every field
  // emits exactly one line no matter what any file on disk contains: a stray
  // newline here would forge a `Next:` the model then obeys.
  stdout.write(`Next: ${oneLine(result.command)}\n`);
  if (result.why) stdout.write(`Why: ${oneLine(result.why)}\n`);
  if (result.after) stdout.write(`Then: ${oneLine(result.after)}\n`);
  return 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// Main
// ─────────────────────────────────────────────────────────────────────────────

const COMMANDS = ['doctor', 'init', 'install', 'check', 'skills-lint', 'next', 'lint', 'tick', 'use', 'publish', 'loop', 'tutorial', 'off', 'on'];

// editDistance(a, b) — plain Levenshtein, used only to name the nearest known
// command when the user mistypes one ("did you mean").
function editDistance(a, b) {
  let prev = [];
  for (let j = 0; j <= b.length; j++) prev[j] = j;
  for (let i = 1; i <= a.length; i++) {
    const cur = [i];
    for (let j = 1; j <= b.length; j++) {
      const cost = a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1;
      cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
    }
    prev = cur;
  }
  return prev[b.length];
}

function nearestCommand(cmd) {
  let best = null;
  let bestD = Infinity;
  for (const c of COMMANDS) {
    const d = editDistance(cmd, c);
    if (d < bestD) {
      bestD = d;
      best = c;
    }
  }
  // Only a genuinely close typo gets a suggestion; anything else would be noise.
  return bestD <= Math.max(2, Math.ceil(cmd.length / 3)) ? best : null;
}

// `flow tutorial` — lib/tutorial.js sits beside this file in the plugin layout.
function cmdTutorial(argv) {
  const p = path.join(path.dirname(CLI_REAL), 'lib', 'tutorial.js');
  if (!fs.existsSync(p)) {
    stderr.write(`${C.error}flow: ${p} not found (the tutorial ships with the flow plugin)${C.reset}\n`);
    process.exit(1);
  }
  // eslint-disable-next-line global-require
  const tutorial = require(p);
  tutorial
    .run(argv, HOME)
    .then((code) => process.exit(code))
    .catch((err) => {
      const code = err && err.code ? err.code : 'ERROR';
      stderr.write(`flow tutorial: ${code}: ${err.message}\n`);
      process.exit(1);
    });
}

function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];

  if (!cmd || cmd === '--help' || cmd === '-h') {
    printTopHelp();
    process.exit(0);
  }

  const rest = argv.slice(1);

  // `loop` owns its own --help / <subcommand> --help handling (K-C); never
  // route it through the generic top-help interception below.
  if (cmd !== 'loop' && (rest.includes('--help') || rest.includes('-h'))) {
    if (cmd === 'init') {
      printInitHelp();
    } else if (cmd === 'install') {
      printInstallHelp();
    } else if (cmd === 'next') {
      printNextHelp();
    } else {
      printTopHelp();
    }
    process.exit(0);
  }

  if (cmd === 'doctor') process.exit(cmdDoctor(rest));
  else if (cmd === 'init') process.exit(cmdInit(rest));
  else if (cmd === 'install') process.exit(cmdInstall(rest));
  else if (cmd === 'check') process.exit(cmdCheck(rest));
  else if (cmd === 'skills-lint') process.exit(cmdSkillsLint(rest));
  else if (cmd === 'next') process.exit(cmdNext(rest));
  else if (cmd === 'lint') process.exit(require('./lib/lint.js').run(rest, gitToplevel(process.cwd()) || process.cwd(), { stdout, stderr }, process.env));
  else if (cmd === 'tick') process.exit(require('./lib/tick.js').run(rest, gitToplevel(process.cwd()) || process.cwd(), { stdout, stderr }, process.env));
  else if (cmd === 'use') process.exit(require('./lib/use.js').run(rest, gitToplevel(process.cwd()) || process.cwd(), { stdout, stderr }));
  else if (cmd === 'publish') process.exit(require('./lib/publish.js').run(rest, gitToplevel(process.cwd()) || process.cwd(), { stdout, stderr }, process.env));
  else if (cmd === 'loop') process.exit(require('./lib/loop.js').run(rest, process.cwd(), process.env));
  else if (cmd === 'tutorial') cmdTutorial(rest);
  else if (cmd === 'off' || cmd === 'on') process.exit(cmdOffOn(cmd, rest));
  else {
    const near = nearestCommand(cmd);
    stderr.write(
      `${C.error}flow: unknown command '${cmd}'${C.reset}` +
        `${near ? ` — did you mean 'flow ${near}'?` : ` — did you mean one of: ${COMMANDS.join(', ')}?`}\n`
    );
    printTopHelp();
    process.exit(1);
  }
}

main();
