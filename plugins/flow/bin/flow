#!/usr/bin/env node
'use strict';

// flow — deterministic Claude Code harness CLI (bin/.local/bin/flow).
// Node >= 18, zero runtime dependencies. See claude/.claude/flow-templates/
// for the file packet `flow init` writes and claude/.claude/scripts/tests/
// test_cli.sh for the tests this file is judged by (unit U5 / contract C9).

const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const { spawnSync } = require('node:child_process');

const { stdout, stderr } = process;

// ─────────────────────────────────────────────────────────────────────────────
// Tokyo Night colour theme — same palette/shape as skills/shared/scripts/check-all
// ─────────────────────────────────────────────────────────────────────────────

const C = {
  primary: '[38;2;122;162;247m', // #7aa2f7 blue
  accent: '[38;2;187;154;247m', // #bb9af7 purple
  success: '[38;2;158;206;106m', // #9ece6a green
  error: '[38;2;247;118;142m', // #f7768e red/pink
  warning: '[38;2;224;175;104m', // #e0af68 yellow
  text: '[38;2;192;202;245m', // #c0caf5 foreground
  muted: '[38;2;86;95;137m', // #565f89 comments
  border: '[38;2;59;66;97m', // #3b4261 borders
  bold: '[1m',
  reset: '[0m',
};

const HOME = process.env.HOME || os.homedir() || '';

// ─────────────────────────────────────────────────────────────────────────────
// Path resolution — real path of this file, so tests can run it from a repo
// checkout without anything deployed to ~/.claude.
// ─────────────────────────────────────────────────────────────────────────────

const CLI_REAL = fs.realpathSync(process.argv[1]);
// CLI_REAL is <repo>/bin/.local/bin/flow — three levels up is <repo>.
const REPO_ROOT = path.resolve(path.dirname(CLI_REAL), '..', '..', '..');
const REPO_TEMPLATES_DIR = path.join(REPO_ROOT, 'claude', '.claude', 'flow-templates');
const REPO_SHARED_SCRIPTS_DIR = path.join(REPO_ROOT, 'claude', '.claude', 'skills', 'shared', 'scripts');
// Plugin layout: <plugin>/bin/flow sits beside <plugin>/skills/shared/scripts.
const PLUGIN_SHARED_SCRIPTS_DIR = path.resolve(path.dirname(CLI_REAL), '..', 'skills', 'shared', 'scripts');
function sharedScript(name) {
  // FLOW_SHARED_SCRIPTS_DIR pins the lookup to one directory (tests use it to simulate absence).
  if (process.env.FLOW_SHARED_SCRIPTS_DIR) {
    const only = path.join(process.env.FLOW_SHARED_SCRIPTS_DIR, name);
    return fs.existsSync(only) ? only : null;
  }
  const candidates = [
    path.join(HOME, '.claude', 'skills', 'shared', 'scripts', name),
    path.join(PLUGIN_SHARED_SCRIPTS_DIR, name),
    path.join(REPO_SHARED_SCRIPTS_DIR, name),
  ];
  for (const c of candidates) { if (fs.existsSync(c)) return c; }
  return null;
}

function isDir(p) {
  try {
    return fs.statSync(p).isDirectory();
  } catch {
    return false;
  }
}

function safeRead(p) {
  try {
    return fs.readFileSync(p, 'utf8');
  } catch {
    return null;
  }
}

// shellQuote(s): s as a single POSIX shell word. Safe characters are left
// alone so the common case stays readable; anything else is single-quoted.
function shellQuote(s) {
  const v = String(s);
  if (v !== '' && /^[A-Za-z0-9_@%+=:,./-]+$/.test(v)) return v;
  return `'${v.split("'").join("'\\''")}'`;
}

function have(cmd) {
  // Portable PATH walk — no dependency on `which` being installed (a hook
  // subprocess may run with a minimal PATH that lacks it). Windows-style
  // PATHEXT is not considered: this repo targets bash 3.2/5 on macOS+Linux.
  const pathEnv = process.env.PATH || '';
  const dirs = pathEnv.split(path.delimiter).filter(Boolean);
  for (const dir of dirs) {
    const candidate = path.join(dir, cmd);
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
      if (fs.statSync(candidate).isFile()) return true;
    } catch {
      // not found or not executable in this dir — keep looking
    }
  }
  return false;
}

// Resolution order (C9 amended by C21 M3 — ${CLAUDE_PLUGIN_ROOT} is not set
// for the CLI itself, so it never substitutes into this file; it resolves
// its own templates dir relative to its own real path instead):
//   1. $HOME/.claude/flow-templates           (deployed, either mode)
//   2. <cli real dir>/../flow-templates        (plugin layout: bin/flow
//                                                   sibling of flow-templates/)
//   3. <repo>/claude/.claude/flow-templates    (dotfiles checkout fallback,
//                                                   used by the test suite)
function templatesDir() {
  const homeDir = path.join(HOME, '.claude', 'flow-templates');
  if (isDir(homeDir)) return homeDir;
  const siblingDir = path.resolve(path.dirname(CLI_REAL), '..', 'flow-templates');
  if (isDir(siblingDir)) return siblingDir;
  return REPO_TEMPLATES_DIR;
}

function readTemplate(dir, name) {
  const p = path.join(dir, name);
  const c = safeRead(p);
  if (c === null) {
    stderr.write(`${C.error}flow: missing template ${p}${C.reset}\n`);
    process.exit(1);
  }
  return c;
}

function detectProjectPath() {
  return sharedScript('detect-project');
}

