// ─────────────────────────────────────────────────────────────────────────────
// doctor
// ─────────────────────────────────────────────────────────────────────────────

const C4_DEFAULTS = {
  maxFileLines: 400,
  maxFuncLines: 60,
  stopGate: 'scoped',
  stopGateBudgetSec: 150,
  sizeGuard: true,
  formatOnEdit: true,
  ignore: ['migrations/', 'generated/', 'locales/', 'i18n/', '.generated.'],
  requireSpec: 'flow-branches',
};

// Every name here must be a hook file this repo actually ships (see
// plugins/flow/hooks/): `flow doctor` tells the user to run `flow install`
// when one is missing, and install can only link what exists in the source
// tree. test_cli.sh asserts the two lists agree with the shipped hooks.
const C5_HOOK_FILES = [
  'session-context.sh',
  'turn-stamp.sh',
  'git-guard.sh',
  'format-lint.sh',
  'size-guard.sh',
  'tamper-notice.sh',
  'stop-gate.sh',
  'pre-compact-backup.sh',
];

// C5's event -> matcher/hook-file mapping. Used to confirm the settings.json
// "hooks" object actually *wires* each C5 hook file to its event/matcher, not
// merely that the key exists and the files are present+executable on disk.
const C5_WIRING = {
  SessionStart: { matcher: null, files: ['session-context.sh'] },
  UserPromptSubmit: { matcher: null, files: ['turn-stamp.sh'] },
  PreToolUse: { matcher: 'Bash', files: ['git-guard.sh'] },
  PostToolUse: { matcher: 'Edit|Write|NotebookEdit', files: ['format-lint.sh', 'size-guard.sh', 'tamper-notice.sh'] },
  Stop: { matcher: null, files: ['stop-gate.sh'] },
  PreCompact: { matcher: null, files: ['pre-compact-backup.sh'] },
};

// Returns a list of human-readable problems for events/hook-files declared in
// C5 that are not actually wired inside the parsed `hooks` object.
function hooksWiringProblems(hooksObj) {
  const problems = [];
  for (const event of Object.keys(C5_WIRING)) {
    const spec = C5_WIRING[event];
    const blocks = Array.isArray(hooksObj[event]) ? hooksObj[event] : [];
    if (blocks.length === 0) {
      problems.push(`${event}: not wired`);
      continue;
    }
    // Only commands from blocks whose matcher equals the C5-required matcher
    // for this event count as "wired" (events with no required matcher, i.e.
    // spec.matcher === null, accept commands from any block). A hook file
    // whose command string merely appears somewhere in the event — inside a
    // different, wrong-matcher block of a multi-block event — must NOT count
    // as wired, or a hook parked on the wrong matcher is invisible to this
    // check and reported as a clean PASS while never actually firing.
    const commands = [];
    let matcherOk = spec.matcher === null;
    for (const block of blocks) {
      if (!block || typeof block !== 'object') continue;
      const blockMatchesSpec = spec.matcher === null || block.matcher === spec.matcher;
      if (blockMatchesSpec) matcherOk = true;
      if (blockMatchesSpec && Array.isArray(block.hooks)) {
        for (const h of block.hooks) {
          if (h && typeof h.command === 'string') commands.push(h.command);
        }
      }
    }
    if (spec.matcher !== null && !matcherOk) {
      problems.push(`${event}: missing matcher "${spec.matcher}"`);
    }
    for (const file of spec.files) {
      const wired = commands.some((c) => c.indexOf(file) !== -1);
      if (!wired) problems.push(`${event}: ${file} not wired`);
    }
  }
  return problems;
}

// dotfilesRoot defaults to $HOME/.dotfiles (bare `flow doctor` behaviour,
// unchanged). `flow install` (C18 step 7) passes the SAME root it was
// actually invoked with (via --dotfiles), so a deployment from a non-default
// checkout is checked against the root it was built from instead of always
// being compared to $HOME/.dotfiles.
// installSourceCandidates(name, dotfilesRoot) -> every path `flow install`
// could link ~/.claude/<name> FROM, most-likely first. In plugin mode
// skills/hooks/scripts come from the marketplace checkout and nowhere else
// (cmdInstall step 1b); everything else comes from a dotfiles root, and a
// bare `flow install` resolves that root by searching $DOTFILES, ~/.dotfiles,
// ~/dotfiles and REPO_ROOT (dotfilesCandidates). The doctor's own root (from
// `flow install --dotfiles <p>`'s step-7 recheck) is searched first when given.
function installSourceCandidates(name, dotfilesRoot) {
  const marketplaceRoot = resolveMarketplaceRoot([]);
  if (isDir(path.join(marketplaceRoot, 'plugins', 'flow'))) {
    if (name === 'skills') return [path.join(marketplaceRoot, 'plugins')];
    if (name === 'hooks' || name === 'scripts') return [path.join(marketplaceRoot, 'plugins', 'flow', name)];
  }
  const roots = [];
  if (dotfilesRoot) roots.push(path.resolve(dotfilesRoot));
  for (const c of dotfilesCandidates([])) if (roots.indexOf(c) === -1) roots.push(c);
  return roots.map((r) => path.join(r, 'claude', '.claude', name));
}

// installSourceGap(name, dotfilesRoot) -> a clause naming the source paths
// when NONE of them exists, else ''. install SKIPS an item whose source is
// absent, so such a symlink FAIL must not answer with `flow install --force`:
// running it would leave the same FAIL standing. The claim "install has no
// source" is only made when every root install would search comes up empty —
// a machine whose dotfiles live at ~/dotfiles or $DOTFILES still gets the
// `→ run: flow install --force` that actually fixes the FAIL.
function installSourceGap(name, dotfilesRoot) {
  const candidates = installSourceCandidates(name, dotfilesRoot);
  for (const c of candidates) if (fs.existsSync(c)) return '';
  const detail = candidates.length === 1
    ? `${candidates[0]} does not exist`
    : `none of ${candidates.join(', ')} exists`;
  return `; install has no source for it either (${detail})`;
}

function doctorSymlinkChecks(push, dotfilesRoot) {
  const dotfilesClaude = path.join(dotfilesRoot || path.join(HOME, '.dotfiles'), 'claude', '.claude');
  // Resolve the expected prefix through any symlinked ancestor directories
  // too (e.g. macOS's /var -> /private/var, or a symlinked $TMPDIR used by a
  // test's $HOME) — fs.realpathSync on the deployed symlink below fully
  // canonicalises its target, so the expected prefix must be canonicalised
  // the same way or a fully-correct deployment compares unequal. Fall back
  // to the un-resolved path when it doesn't exist so the comparison below
  // still fails cleanly instead of throwing.
  let dotfilesClaudeReal = dotfilesClaude;
  try {
    dotfilesClaudeReal = fs.realpathSync(dotfilesClaude);
  } catch {
    dotfilesClaudeReal = dotfilesClaude;
  }
  const items = [
    ['skills', 'FAIL'],
    ['agents', 'FAIL'],
    ['commands', 'FAIL'],
    ['scripts', 'FAIL'],
    ['hooks', 'FAIL'],
    ['settings.json', 'FAIL'],
    ['CLAUDE.md', 'FAIL'],
  ];
  // workflows: provided by the plugin (flow:<name>); a bare ~/.claude/workflows would double-register.
  if (fs.existsSync(path.join(HOME, '.claude', 'skills', 'flow', 'workflows'))) {
    push('symlink:workflows', 'PASS', 'workflows provided by the harness plugin (flow:<name>)');
  } else if (fs.existsSync(path.join(HOME, '.claude', 'workflows'))) {
    push('symlink:workflows', 'PASS', `${path.join(HOME, '.claude', 'workflows')} present (legacy layout)`);
  } else {
    push('symlink:workflows', 'WARN', `${path.join(HOME, '.claude', 'workflows')} does not exist and no plugin provides workflows`);
  }
  for (const [name, missingSeverity] of items) {
    const p = path.join(HOME, '.claude', name);
    const absent = installSourceGap(name, dotfilesRoot);
    let lst;
    try {
      lst = fs.lstatSync(p);
    } catch {
      lst = null;
    }
    if (!lst) {
      push(`symlink:${name}`, missingSeverity, `${p} does not exist${absent}`, absent ? false : undefined);
      continue;
    }
    if (!lst.isSymbolicLink()) {
      const src = path.join(dotfilesClaude, name);
      if ((name === 'agents' || name === 'commands') && lst.isDirectory() && isDir(src)) {
        // Merged layout: every dotfiles entry must be a link into the dotfiles.
        let entries = [];
        try { entries = fs.readdirSync(src).sort(); } catch { entries = []; }
        const unlinked = entries.filter((e) => {
          let real = null;
          try { real = fs.realpathSync(path.join(p, e)); } catch { real = null; }
          const linkedIn = real && (real === dotfilesClaudeReal || real.startsWith(dotfilesClaudeReal + path.sep));
          let l = null;
          try { l = fs.lstatSync(path.join(p, e)); } catch { l = null; }
          return !(l && l.isSymbolicLink() && linkedIn);
        });
        if (unlinked.length === 0) push(`symlink:${name}`, 'PASS', `${p} (merged: ${entries.length} dotfiles entries linked; your own files kept)`);
        else push(`symlink:${name}`, 'WARN', `${p} (merged) has ${unlinked.length} dotfiles entr${unlinked.length === 1 ? 'y' : 'ies'} not linked: ${unlinked.join(', ')} — flow install links them (--force replaces differing files, backup kept)`);
        continue;
      }
      if (name === 'settings.json' && lst.isFile()) {
        let ok = false;
        try { ok = JSON.parse(safeRead(p) || 'null') !== null; } catch { ok = false; }
        push(`symlink:${name}`, ok ? 'PASS' : 'FAIL', ok ? `${p} (machine-specific real file; not linked)` : `${p} does not parse`);
        continue;
      }
      if (name === 'CLAUDE.md' && lst.isFile() && fs.existsSync(src)) {
        let identical = false;
        try { identical = fs.readFileSync(p).equals(fs.readFileSync(src)); } catch { identical = false; }
        if (identical) push(`symlink:${name}`, 'PASS', `${p} is an identical copy of ${src} (flow install links it)`);
        else push(`symlink:${name}`, 'WARN', `${p} differs from ${src}: the harness rules in it may be missing here — diff them, then flow install --force replaces it (backup kept)`);
        continue;
      }
      push(`symlink:${name}`, missingSeverity, `${p} exists but is not a symlink${absent}`, absent ? false : undefined);
      continue;
    }
    let real;
    try {
      real = fs.realpathSync(p);
    } catch {
      real = null;
    }
    const underDotfiles = real === dotfilesClaudeReal || (real && real.startsWith(dotfilesClaudeReal + path.sep));
    // Plugin layout (C21): skills → <marketplace>/plugins; hooks, scripts and
    // flow-templates → <marketplace>/plugins/flow/<x>. Accept any target
    // that sits inside a plugin directory (an ancestor holds .claude-plugin/plugin.json)
    // or is the plugins dir of a marketplace (a sibling .claude-plugin/marketplace.json).
    const underPlugin = real && (hasAncestorWith(real, ['.claude-plugin', 'plugin.json']) ||
      fs.existsSync(path.join(path.dirname(real), '.claude-plugin', 'marketplace.json')));
    if (!underDotfiles && !underPlugin) {
      push(`symlink:${name}`, missingSeverity, `${p} -> ${real || '(broken link)'} (not under ${dotfilesClaude} or a marketplace plugin)${absent}`, absent ? false : undefined);
      continue;
    }
    push(`symlink:${name}`, 'PASS', `${p} -> ${real}`);
  }
}

// True when the C21 plugin bundle's own hooks.json exists at
// ~/.claude/skills/flow/hooks/hooks.json — i.e. hooks are (or should be)
// registered by the plugin loader instead of by settings.json's "hooks" key.
function pluginHooksJsonPresent() {
  return fs.existsSync(path.join(HOME, '.claude', 'skills', 'flow', 'hooks', 'hooks.json'));
}

function doctorHooksKeyCheck(push) {
  const settingsPath = path.join(HOME, '.claude', 'settings.json');
  let settings = null;
  const raw = safeRead(settingsPath);
  if (raw !== null) {
    try {
      settings = JSON.parse(raw);
    } catch {
      settings = null;
    }
  }
  if (!settings || typeof settings.hooks !== 'object' || settings.hooks === null) {
    // C21 M3: once the core plugin is loaded, settings.json is SUPPOSED to
    // lose its "hooks" key (the plugin's own hooks/hooks.json registers the
    // hooks instead; double registration would fire every hook twice — see
    // doctorPluginDoubleRegistrationCheck). A missing hooks key while the
    // plugin's hooks.json exists is therefore the correct post-cutover
    // end state, not a failure; only a pre-migration deployment (no plugin
    // hooks.json at all) still requires settings.json to carry the key.
    if (pluginHooksJsonPresent()) {
      push(
        'settings:hooks-key',
        'PASS',
        `${settingsPath} has no "hooks" key; plugin mode is active (~/.claude/skills/flow/hooks/hooks.json present) — this is the expected post-cutover state`
      );
      return;
    }
    push('settings:hooks-key', 'FAIL', `${settingsPath} is missing, unreadable, or has no "hooks" key`);
    return;
  }
  const problems = [];
  for (const h of C5_HOOK_FILES) {
    const hp = path.join(HOME, '.claude', 'hooks', h);
    let st;
    try {
      st = fs.statSync(hp);
    } catch {
      st = null;
    }
    if (!st) {
      problems.push(`${h} missing`);
      continue;
    }
    if ((st.mode & 0o111) === 0) problems.push(`${h} not executable`);
  }
  // Presence+executable on disk is necessary but not sufficient: also confirm
  // the hooks object actually wires each C5 file to its event/matcher, so a
  // vacuous `"hooks": {}` (or one wired to the wrong keys) is caught here
  // instead of being reported as a clean PASS.
  problems.push(...hooksWiringProblems(settings.hooks));
  if (problems.length) {
    push('settings:hooks-key', 'FAIL', `hooks key present but: ${problems.join(', ')}`);
  } else {
    push('settings:hooks-key', 'PASS', 'hooks key present; all C5 hook files present, executable, and wired');
  }
}

function hasAncestorWith(start, parts) {
  let d = start;
  for (let i = 0; i < 12; i++) {
    if (fs.existsSync(path.join(d, ...parts))) return true;
    const up = path.dirname(d);
    if (up === d) break;
    d = up;
  }
  return false;
}

function doctorHooksDriftCheck(push) {
  // Plugin layout: compare the hooks the session actually uses against the
  // marketplace repo's HEAD instead of the dotfiles tree.
  let hooksReal = null;
  try { hooksReal = fs.realpathSync(path.join(HOME, '.claude', 'hooks')); } catch { hooksReal = null; }
  if (hooksReal && hasAncestorWith(hooksReal, ['.claude-plugin', 'plugin.json'])) {
    let repo = hooksReal;
    for (let i = 0; i < 8 && !isDir(path.join(repo, '.git')); i++) repo = path.dirname(repo);
    if (isDir(path.join(repo, '.git'))) {
      const rel = path.relative(repo, hooksReal);
      const r = spawnSync('git', ['-C', repo, 'diff', '--quiet', '--', rel], { encoding: 'utf8' });
      if (r.status === 1) push('hooks-drift', 'WARN', `${rel} has uncommitted changes relative to HEAD in ${repo}`);
      else if (r.status === 0) push('hooks-drift', 'PASS', `${rel} matches HEAD in ${repo}`);
      else push('hooks-drift', 'PASS', 'drift check not applicable');
      return;
    }
  }
  const dotfilesRoot = path.join(HOME, '.dotfiles');
  if (!isDir(path.join(dotfilesRoot, '.git'))) {
    push('hooks-drift', 'PASS', `drift check skipped: ${dotfilesRoot} is not a git repo`);
    return;
  }
  const r = spawnSync('git', ['-C', dotfilesRoot, 'diff', '--quiet', '--', 'claude/.claude/hooks'], {
    encoding: 'utf8',
  });
  if (r.status === 1) {
    push('hooks-drift', 'WARN', 'claude/.claude/hooks has uncommitted changes relative to HEAD');
  } else if (r.status === 0) {
    push('hooks-drift', 'PASS', 'claude/.claude/hooks matches HEAD');
  } else {
    push('hooks-drift', 'PASS', 'drift check not applicable');
  }
}

function doctorHarnessJsonOverridesCheck(push) {
  const hp = path.join(process.cwd(), '.claude', 'flow.config.json');
  const raw = safeRead(hp);
  if (raw === null) {
    push('flow-config-overrides', 'PASS', 'no .claude/flow.config.json in current repo (defaults apply)');
    return;
  }
  let cfg = null;
  try {
    cfg = JSON.parse(raw);
  } catch {
    cfg = null;
  }
  if (!cfg) {
    push('flow-config-overrides', 'WARN', `${hp} present but not valid JSON`);
    return;
  }
  const diffs = [];
  for (const k of Object.keys(C4_DEFAULTS)) {
    if (Object.prototype.hasOwnProperty.call(cfg, k)) {
      if (JSON.stringify(cfg[k]) !== JSON.stringify(C4_DEFAULTS[k])) diffs.push(k);
    }
  }
  if (diffs.length) {
    push('flow-config-overrides', 'WARN', `.claude/flow.config.json overrides C4 defaults: ${diffs.join(', ')}`);
  } else {
    push('flow-config-overrides', 'PASS', '.claude/flow.config.json matches C4 defaults');
  }
}

function doctorThresholdsReferencedCheck(push) {
  const harnessDir = path.join(process.cwd(), '.flow');
  if (!isDir(harnessDir)) {
    push('flow-thresholds-referenced', 'PASS', 'no .flow/ directory in current repo');
    return;
  }
  let files = [];
  try {
    files = fs.readdirSync(harnessDir).filter((f) => f.indexOf('.thresholds.') !== -1);
  } catch {
    files = [];
  }
  if (files.length === 0) {
    push('flow-thresholds-referenced', 'PASS', 'no .flow/*.thresholds.* files present');
    return;
  }
  const unreferenced = [];
  for (const f of files) {
    const candidates =
      f.endsWith('.toml')
        ? ['pyproject.toml', 'ruff.toml']
        : ['eslint.config.js', 'eslint.config.mjs', 'eslint.config.cjs', '.eslintrc.js', '.eslintrc.json', '.eslintrc'];
    let referenced = false;
    for (const c of candidates) {
      const content = safeRead(path.join(process.cwd(), c));
      if (content && content.indexOf(f) !== -1) {
        referenced = true;
        break;
      }
    }
    if (!referenced) unreferenced.push(f);
  }
  if (unreferenced.length) {
    push('flow-thresholds-referenced', 'WARN', `not referenced by any lint config: ${unreferenced.join(', ')}`);
  } else {
    push('flow-thresholds-referenced', 'PASS', 'all .flow/*.thresholds.* files referenced');
  }
}

// True when <dir> is inside a git work tree (including a repo rooted above
// it). Never throws: a missing `git` binary or a non-repo dir both count as
// "not a git repo" rather than crashing doctor.
function isGitRepo(dir) {
  const r = spawnSync('git', ['-C', dir, 'rev-parse', '--is-inside-work-tree'], { encoding: 'utf8' });
  if (r.error) return false;
  return r.status === 0 && (r.stdout || '').trim() === 'true';
}

// specs-state (spec 004 K-C): print the router's own state, and FAIL on the
// three the user has to act on before anything else works — a scan failure
// (row 0), an invalid TASKS.md (1d) and a lying tick (1e). Everything else is
// a normal position in the build, not a health problem.
const DOCTOR_SPECS_FAIL = ['scan-failed', 'invalid', 'lying'];

function doctorSpecsStateCheck(push) {
  const cwd = process.cwd();
  if (!isGitRepo(cwd)) {
    push('specs-state', 'PASS', 'skipped: current directory is not a git repo');
    return;
  }
  let r;
  try {
    // count:false — doctor asks without moving the consecutive-call counter.
    r = computeNext(cwd, { count: false });
  } catch (e) {
    push('specs-state', 'FAIL', `router threw: ${e.message}`, 'flow next --json');
    return;
  }
  const where = r.feature ? ` (${r.feature.dir})` : '';
  const detail = `${r.state}${where} → ${r.command}`;
  if (DOCTOR_SPECS_FAIL.indexOf(r.state) !== -1) {
    push('specs-state', 'FAIL', `${detail} — ${r.why}`, 'flow lint');
    return;
  }
  push('specs-state', 'PASS', detail);
}

// C17 delta: flow doctor gains a PROGRESS.md check (WARN-only, never
// FAIL): present in a git repo, <= 60 lines, and no "## Done" bullet dated
// more than 30 days back (dates are YYYY-MM-DD at the start of a bullet).
// Applies to the current repo (process.cwd()), same as the other
// per-project checks (flow-config-overrides, flow-thresholds-referenced).
function doctorProgressCheck(push) {
  const cwd = process.cwd();
  if (!isGitRepo(cwd)) {
    push('progress-md', 'PASS', 'skipped: current directory is not a git repo');
    return;
  }
  const p = path.join(cwd, 'PROGRESS.md');
  const raw = safeRead(p);
  if (raw === null) {
    push('progress-md', 'WARN', `${p} not found`);
    return;
  }

  const rawLines = raw.split('\n');
  // A trailing newline produces a spurious empty final element; a bare
  // count of split('\n') would over-count by one for a well-formed file.
  const lineCount = raw.endsWith('\n') ? rawLines.length - 1 : rawLines.length;
  const problems = [];
  if (lineCount > 60) problems.push(`${lineCount} lines (> 60 max)`);

  // Walk the "## Done" section (until the next "## " heading) and find the
  // oldest dated bullet, e.g. "- 2026-08-01: shipped X (abc1234)".
  let inDone = false;
  let oldest = null; // { ms: number, raw: string }
  for (const line of rawLines) {
    const trimmed = line.trim();
    if (/^##\s/.test(trimmed)) {
      inDone = trimmed === '## Done';
      continue;
    }
    if (!inDone) continue;
    const m = trimmed.match(/^-\s*(\d{4}-\d{2}-\d{2})\b/);
    if (!m) continue;
    const ms = Date.parse(`${m[1]}T00:00:00Z`);
    if (Number.isNaN(ms)) continue;
    if (!oldest || ms < oldest.ms) oldest = { ms, raw: m[1] };
  }
  if (oldest) {
    const thirtyDaysMs = 30 * 24 * 60 * 60 * 1000;
    if (Date.now() - oldest.ms > thirtyDaysMs) {
      problems.push(`oldest ## Done bullet dated ${oldest.raw} (> 30 days back)`);
    }
  }

  if (problems.length) {
    push('progress-md', 'WARN', problems.join('; '));
  } else {
    push('progress-md', 'PASS', `${p} present, ${lineCount} lines, no stale ## Done bullets`);
  }
}

// A contract whose iteration/max_iterations are non-numeric or whose verify
// is empty is corrupt (K-B); doctor only reports it here, `flow loop`
// itself is what renames it to loop.md.corrupt.
function doctorLoopContractCorrupt(front) {
  if (!/^\d+$/.test(String(front.iteration || '').trim())) return true;
  if (!/^\d+$/.test(String(front.max_iterations || '').trim())) return true;
  return !front.verify || String(front.verify).trim() === '';
}

// C006 K-L: project-scoped, like progress-md — reads the CURRENT repo's
// .claude/loop/loop.md (process.cwd()), not $HOME.
function doctorLoopCheck(push) {
  const cwd = process.cwd();
  if (!isGitRepo(cwd)) return;
  const p = path.join(cwd, '.claude', 'loop', 'loop.md');
  const raw = safeRead(p);
  if (raw === null) return;
  let front;
  try {
    ({ front } = require('./lib/loop.js').parseContract(raw));
  } catch {
    push('loop-contract', 'FAIL', `${p} does not parse`);
    return;
  }
  if (doctorLoopContractCorrupt(front)) {
    push('loop-contract', 'FAIL', `${p} is corrupt`);
    return;
  }
  if (front.status === 'active') {
    push(
      'loop-contract',
      'WARN',
      `loop: active contract since ${front.started_at} (shape ${front.shape}, iteration ${front.iteration}/${front.max_iterations}) — flow loop status | flow loop stop`
    );
    return;
  }
  push('loop-contract', 'PASS', `${p} status=${front.status}`);
}

function doctorToolChecks(push) {
  const required = ['git', 'jq', 'node', 'python3'];
  for (const t of required) {
    push(`tool:${t}`, have(t) ? 'PASS' : 'FAIL', have(t) ? `${t} on PATH` : `${t} not found on PATH`);
  }
  const optional = [
    ['shellcheck', ''],
    ['rtk', ' (Mac-only by design)'],
    ['better-plan', ' (Mac-only by design)'],
    ['ruff', ''],
    ['gh', ''],
  ];
  for (const [t, note] of optional) {
    push(`tool:${t}`, have(t) ? 'PASS' : 'WARN', have(t) ? `${t} on PATH` : `${t} not found on PATH${note}`);
  }
  const hasFormatter = have('prettier') || have('biome');
  push(
    'tool:prettier-or-biome',
    hasFormatter ? 'PASS' : 'WARN',
    hasFormatter ? 'a JS/TS formatter is on PATH' : 'neither prettier nor biome found on PATH'
  );
}

function extractFrontmatterDescription(content) {
  const lines = content.split('\n');
  if (!lines[0] || lines[0].trim() !== '---') return '';
  let end = -1;
  for (let i = 1; i < lines.length; i++) {
    if (lines[i].trim() === '---') {
      end = i;
      break;
    }
  }
  if (end === -1) return '';
  const fm = lines.slice(1, end);
  const idx = fm.findIndex((l) => /^description:\s*/.test(l));
  if (idx === -1) return '';
  const m = fm[idx].match(/^description:\s*(.*)$/);
  const rest = (m && m[1] ? m[1] : '').trim();
  const parts = [];
  const isIndicator = /^[|>][+-]?\s*$/.test(rest);
  if (!isIndicator && rest !== '') parts.push(stripQuotes(rest));
  let i = idx + 1;
  while (i < fm.length) {
    const line = fm[i];
    if (line.trim() === '') {
      parts.push('');
      i++;
      continue;
    }
    if (/^\s+\S/.test(line)) {
      parts.push(line.replace(/^\s+/, ''));
      i++;
      continue;
    }
    break;
  }
  return parts.join(' ').replace(/\s+/g, ' ').trim();
}

function stripQuotes(s) {
  if ((s.charAt(0) === '"' && s.charAt(s.length - 1) === '"') || (s.charAt(0) === "'" && s.charAt(s.length - 1) === "'")) {
    return s.slice(1, -1);
  }
  return s;
}

// A skills/ entry is either (a) a plain skill dir with SKILL.md directly
// inside it (legacy/dotfiles-only layout), or (b) a marketplace plugin root
// (has .claude-plugin/plugin.json) whose own skills live under skills/<name>/
// SKILL.md (C21 target layout: ~/.claude/skills/flow -> plugins/flow,
// containing skills/{flow,feature,...}/SKILL.md). Counting both means the
// skill index cost stays accurate whether a machine is on the pre-migration
// dotfiles-only layout, the post-migration plugin layout, or a mix of both
// during the cut-over.
function collectSkillDescriptions(skillsDir) {
  const fat = [];
  if (!isDir(skillsDir)) return fat;
  let entries = [];
  try {
    entries = fs.readdirSync(skillsDir, { withFileTypes: true });
  } catch {
    entries = [];
  }
  for (const e of entries) {
    if (!e.isDirectory()) continue;
    const entryDir = path.join(skillsDir, e.name);
    const direct = safeRead(path.join(entryDir, 'SKILL.md'));
    if (direct !== null) {
      const desc = extractFrontmatterDescription(direct);
      if (desc) fat.push({ name: e.name, chars: desc.length });
      continue;
    }
    if (!fs.existsSync(path.join(entryDir, '.claude-plugin', 'plugin.json'))) continue;
    let nested = [];
    try {
      nested = fs.readdirSync(path.join(entryDir, 'skills'), { withFileTypes: true });
    } catch {
      nested = [];
    }
    for (const n of nested) {
      if (!n.isDirectory()) continue;
      const content = safeRead(path.join(entryDir, 'skills', n.name, 'SKILL.md'));
      if (!content) continue;
      const desc = extractFrontmatterDescription(content);
      if (desc) fat.push({ name: `${e.name}/${n.name}`, chars: desc.length });
    }
  }
  return fat;
}

function doctorSkillIndexCostCheck(push) {
  const skillsDir = path.join(HOME, '.claude', 'skills');
  const fat = collectSkillDescriptions(skillsDir);
  let totalChars = 0;
  for (const x of fat) totalChars += x.chars;
  fat.sort((a, b) => b.chars - a.chars);
  const top3 = fat
    .slice(0, 3)
    .map((x) => `${x.name} (${x.chars} chars)`)
    .join(', ');
  const tokens = Math.round(totalChars / 4);
  const status = tokens > 10000 ? 'WARN' : 'PASS';
  push('skill-index-cost', status, `${totalChars} chars ≈ ${tokens} tokens${top3 ? '; fattest: ' + top3 : ''}`);
}

function doctorSkillsLintCheck(push) {
  const target = path.join(HOME, '.claude', 'scripts', 'skills-lint');
  if (!fs.existsSync(target)) return; // skip, not fail, per C9
  const r = spawnSync(target, [], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 120000, killSignal: 'SIGKILL' });
  if (r.signal) {
    push('skills-lint', 'WARN', `skills-lint killed (${r.signal}) after 120s; run it by hand with --verbose`);
    return;
  }
  const out = (r.stdout || '') + (r.stderr || '');
  const missingCount = (out.match(/^MISSING /gm) || []).length;
  const toolCount = (out.match(/^TOOL /gm) || []).length;
  if (r.status !== 0 || missingCount > 0) {
    push('skills-lint', 'FAIL', `${missingCount} missing reference(s)${toolCount ? `, ${toolCount} tool note(s)` : ''}`);
  } else if (toolCount > 0) {
    push('skills-lint', 'WARN', `${toolCount} tool note(s), no missing references`);
  } else {
    push('skills-lint', 'PASS', 'no missing references');
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Plugin-mode doctor checks (C21 M3). Each of these is gated on
// ~/.claude/skills/flow existing at all EXCEPT doctorLocalBinHarnessCheck
// and doctorPluginListCheck, which apply universally: on a machine still in
// dotfiles-only (pre-migration) mode, ~/.claude/skills/flow never exists,
// so the gated checks silently skip (push nothing) rather than warn/fail on
// a state that is simply "not migrated yet".
// ─────────────────────────────────────────────────────────────────────────────

// Recursively collects every string value found under a "command" key,
// anywhere in a hooks.json-shaped object (event -> [ { hooks: [ {type,
// command} ] } ]). Walking generically (rather than assuming one exact
// nesting) tolerates a hooks.json that wraps the event map in a top-level
// "hooks" key or not — both are plausible plugin hooks.json shapes.
function collectHookCommands(node, acc) {
  const out = acc || [];
  if (Array.isArray(node)) {
    for (const item of node) collectHookCommands(item, out);
  } else if (node && typeof node === 'object') {
    for (const k of Object.keys(node)) {
      if (k === 'command' && typeof node[k] === 'string') {
        out.push(node[k]);
      } else {
        collectHookCommands(node[k], out);
      }
    }
  }
  return out;
}

// Resolves a hooks.json command string (e.g. `"${CLAUDE_PLUGIN_ROOT}"/hooks/
// session-context.sh`) to an absolute path: substitute the placeholder with
// the plugin root, strip any remaining shell quoting, then take only the
// first whitespace-separated token (the executable itself, not trailing args).
function resolvePluginHookCommandPath(cmd, pluginRoot) {
  let s = cmd.split('${CLAUDE_PLUGIN_ROOT}').join(pluginRoot);
  s = s.split('"').join('');
  s = s.trim();
  return s.split(/\s+/)[0] || '';
}

function doctorPluginSkillsHarnessCheck(push) {
  const p = path.join(HOME, '.claude', 'skills', 'flow');
  let lst;
  try {
    lst = fs.lstatSync(p);
  } catch {
    return; // not deployed in plugin mode; nothing to check yet
  }
  if (!lst.isSymbolicLink()) {
    // ~/.claude/skills itself may be the symlink to <marketplace>/plugins (C21 live loading).
    let skillsReal = null;
    try { skillsReal = fs.realpathSync(path.join(HOME, '.claude', 'skills')); } catch { skillsReal = null; }
    if (skillsReal && fs.existsSync(path.join(path.dirname(skillsReal), '.claude-plugin', 'marketplace.json'))) {
      push('plugin-skills-flow', 'PASS', `~/.claude/skills -> ${skillsReal} (marketplace plugins dir; harness loads in place)`);
      return;
    }
    push('plugin-skills-flow', 'WARN', `${p} is a real directory (expected a symlink into a marketplace repo)`);
    return;
  }
  let real;
  try {
    real = fs.realpathSync(p);
  } catch {
    push('plugin-skills-flow', 'WARN', `${p} is a broken symlink`);
    return;
  }
  const pluginJson = path.join(real, '.claude-plugin', 'plugin.json');
  if (!fs.existsSync(pluginJson)) {
    push(
      'plugin-skills-flow',
      'WARN',
      `${p} -> ${real} (target has no .claude-plugin/plugin.json; not recognized as a marketplace plugin root)`
    );
    return;
  }
  push('plugin-skills-flow', 'PASS', `${p} -> ${real} (marketplace plugin root)`);
}

function doctorPluginHooksJsonCheck(push) {
  const skillsHarness = path.join(HOME, '.claude', 'skills', 'flow');
  if (!fs.existsSync(skillsHarness)) return; // plugin not deployed; skip
  const hooksJsonPath = path.join(skillsHarness, 'hooks', 'hooks.json');
  const raw = safeRead(hooksJsonPath);
  if (raw === null) {
    push('plugin-hooks-json', 'FAIL', `${hooksJsonPath} not found`);
    return;
  }
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch (e) {
    push('plugin-hooks-json', 'FAIL', `${hooksJsonPath} does not parse: ${e.message}`);
    return;
  }
  let pluginRoot;
  try {
    pluginRoot = fs.realpathSync(path.dirname(path.dirname(hooksJsonPath)));
  } catch {
    pluginRoot = path.dirname(path.dirname(hooksJsonPath));
  }
  const commands = collectHookCommands(parsed);
  const problems = [];
  for (const cmd of commands) {
    const resolved = resolvePluginHookCommandPath(cmd, pluginRoot);
    let st;
    try {
      st = fs.statSync(resolved);
    } catch {
      st = null;
    }
    if (!st) problems.push(`${resolved} missing`);
    else if ((st.mode & 0o111) === 0) problems.push(`${resolved} not executable`);
  }
  if (commands.length === 0) {
    push('plugin-hooks-json', 'FAIL', `${hooksJsonPath} parses but declares no hook commands`);
  } else if (problems.length) {
    push('plugin-hooks-json', 'FAIL', problems.join(', '));
  } else {
    push('plugin-hooks-json', 'PASS', `${hooksJsonPath} parses; ${commands.length} hook command(s) present and executable`);
  }
}

// WARN (not FAIL) when settings.json still carries a "hooks" key while the
// plugin's own hooks/hooks.json also exists — every hook would fire twice
// once the plugin loads (C21: "settings.json loses its hooks block once the
// core plugin is loaded ... double registration would fire every hook
// twice"). SPEC.md C21 M3 is explicit this is a WARN, not a FAIL: "settings
// .json has NO `hooks` key (WARN \"double registration\" if both present)" —
// a machine mid-cutover (plugin loaded, settings.json not yet edited) is an
// expected, spec-acknowledged transient state, not a fatal deployment error.
function doctorPluginDoubleRegistrationCheck(push) {
  const skillsHarness = path.join(HOME, '.claude', 'skills', 'flow');
  if (!fs.existsSync(skillsHarness)) return; // plugin not deployed; skip
  const hooksJsonPath = path.join(skillsHarness, 'hooks', 'hooks.json');
  const hooksJsonExists = fs.existsSync(hooksJsonPath);
  if (!hooksJsonExists) {
    push('plugin-double-registration', 'PASS', `no ${hooksJsonPath}; nothing to double-register`);
    return;
  }
  const settingsPath = path.join(HOME, '.claude', 'settings.json');
  const raw = safeRead(settingsPath);
  let hasHooksKey = false;
  if (raw !== null) {
    try {
      const parsed = JSON.parse(raw);
      hasHooksKey = !!(parsed && typeof parsed.hooks === 'object' && parsed.hooks !== null);
    } catch {
      hasHooksKey = false;
    }
  }
  if (hasHooksKey) {
    push(
      'plugin-double-registration',
      'WARN',
      `${settingsPath} still has a "hooks" key while ${hooksJsonPath} exists` +
        ` — every hook would fire twice; remove settings.json's hooks key once the plugin is loaded`
    );
  } else {
    push('plugin-double-registration', 'PASS', `${hooksJsonPath} present and settings.json has no "hooks" key`);
  }
}

// WARN when the same plugin is loaded twice: ~/.claude/skills/flow (the
// live checkout, loaded as flow@skills-dir) AND enabledPlugins
// "flow@flow" (the copied marketplace install). Both register every
// skill, hook and workflow; disable the marketplace copy when the checkout
// is linked (edits then apply without `claude plugin update`).
function doctorPluginDoubleLoadCheck(push) {
  const skillsHarness = path.join(HOME, '.claude', 'skills', 'flow');
  if (!fs.existsSync(skillsHarness)) return; // no skills-dir load; nothing to double
  const settingsPath = path.join(HOME, '.claude', 'settings.json');
  let enabled = false;
  try {
    const parsed = JSON.parse(safeRead(settingsPath) || 'null');
    // 'harness@harness' is the pre-rename marketplace id: still a second copy.
    enabled = !!(parsed && parsed.enabledPlugins && (parsed.enabledPlugins['flow@flow'] === true || parsed.enabledPlugins['harness@harness'] === true));
  } catch {
    enabled = false;
  }
  if (enabled) {
    push(
      'plugin-double-load',
      'WARN',
      `${settingsPath} enables "flow@flow" or the pre-rename "harness@harness" (marketplace copy) while ${skillsHarness} is linked (flow@skills-dir)` +
        ` — every skill, hook and workflow loads twice; run \`claude plugin uninstall harness@harness\` / \`claude plugin uninstall flow@flow\` and \`claude plugin marketplace remove harness\``
    );
  } else {
    push('plugin-double-load', 'PASS', `harness loads once (skills-dir; "flow@flow" not enabled)`);
  }
}

function doctorLocalBinHarnessCheck(push) {
  const p = path.join(HOME, '.local', 'bin', 'flow');
  let lst;
  try {
    lst = fs.lstatSync(p);
  } catch {
    push('local-bin-harness', 'WARN', `${p} is missing; run flow install`);
    return;
  }
  if (!lst.isSymbolicLink()) {
    push('local-bin-harness', 'WARN', `${p} is a real file (expected a symlink to the harness CLI)`);
    return;
  }
  push('local-bin-harness', 'PASS', `${p} -> ${fs.readlinkSync(p)}`);
}

// `claude plugin list --json` is best-effort and environment-dependent (the
// binary may be absent, or the caller may be running in a machine that has
// never installed the marketplace) — WARN, never FAIL, on any of that.
function doctorPluginListCheck(push) {
  if (!have('claude')) {
    push('plugin-list', 'WARN', 'claude CLI not found on PATH; cannot verify flow@skills-dir is loaded');
    return;
  }
  // No pipes: stdout goes to a temp file and every stdio is 'ignore'. With a
  // pipe, a background process left behind by `claude` (daemon, updater)
  // keeps the pipe open and spawnSync waits on it forever even after the
  // timeout has killed claude itself — that hung `flow install` on macOS.
  const tmpOut = path.join(os.tmpdir(), `flow-plugin-list-${process.pid}.json`);
  const r = spawnSync('sh', ['-c', 'exec "$0" plugin list --json >"$1" 2>/dev/null </dev/null', 'claude', tmpOut], {
    stdio: 'ignore',
    timeout: 5000,
    killSignal: 'SIGKILL',
  });
  let out = '';
  try { out = fs.readFileSync(tmpOut, 'utf8'); } catch { out = ''; }
  try { fs.unlinkSync(tmpOut); } catch { /* absent: fine */ }
  if (r.error || r.status !== 0) {
    const timedOut = (r.error && r.error.code === 'ETIMEDOUT') || r.signal;
    const why = timedOut ? 'killed after 5s: claude did not answer' : r.error ? r.error.message : `exit ${r.status}`;
    push('plugin-list', 'WARN', `claude plugin list --json failed (${why}); cannot verify flow@skills-dir`);
    return;
  }
  // SPEC.md C21 M3: "claude plugin list --json (if available) shows
  // flow@skills-dir enabled". A substring match on the raw JSON only
  // proves the id is mentioned somewhere — it says nothing about the
  // per-entry `enabled` boolean, so a disabled or partially-loaded plugin
  // (verified schema: `claude plugin list --json` entries carry
  // "enabled": false/true) would be misreported as healthy. Parse the JSON
  // and read `enabled` explicitly.
  let parsed = null;
  try {
    parsed = JSON.parse(out);
  } catch {
    parsed = null;
  }
  const entry = Array.isArray(parsed) ? parsed.find((e) => e && e.id === 'flow@skills-dir') : null;
  if (!entry) {
    push('plugin-list', 'WARN', 'flow@skills-dir not found in claude plugin list --json');
  } else if (entry.enabled !== true) {
    push('plugin-list', 'WARN', 'flow@skills-dir present in claude plugin list --json but not enabled — run: claude plugin enable flow@skills-dir');
  } else {
    push('plugin-list', 'PASS', 'flow@skills-dir present and enabled in claude plugin list --json');
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Project-facing doctor checks (B25, FU-16, R1): what is wrong with THIS repo's
// harness configuration, not just with the deployment.
// ─────────────────────────────────────────────────────────────────────────────

// The type/enum contract for .claude/flow.config.json. `check` returns null
// when the value is acceptable, else a description of what is expected.
const CONFIG_SCHEMA = {
  stopGate: (v) => (v === 'scoped' || v === true || v === false ? null : 'one of "scoped", true, false'),
  requireSpec: (v) => (v === 'flow-branches' || v === true || v === false ? null : 'one of "flow-branches", true, false'),
  sizeGuard: (v) => (typeof v === 'boolean' ? null : 'a boolean'),
  formatOnEdit: (v) => (typeof v === 'boolean' ? null : 'a boolean'),
  maxFileLines: (v) => (typeof v === 'number' && v > 0 ? null : 'a positive number'),
  maxFuncLines: (v) => (typeof v === 'number' && v > 0 ? null : 'a positive number'),
  stopGateBudgetSec: (v) => (typeof v === 'number' && v > 0 ? null : 'a positive number'),
  shfmt: (v) => (typeof v === 'boolean' ? null : 'a boolean'),
  plan: (v) => (typeof v === 'string' && v !== '' ? null : 'a path to the active plan'),
  ignore: (v) => (Array.isArray(v) && v.every((x) => typeof x === 'string') ? null : 'an array of path substrings'),
  deny: (v) => (Array.isArray(v) && v.every((x) => typeof x === 'string') ? null : 'an array of command prefixes'),
};

function doctorConfigSchemaCheck(push) {
  const p = path.join(process.cwd(), '.claude', 'flow.config.json');
  const raw = safeRead(p);
  if (raw === null) {
    push('config-schema', 'PASS', 'no .claude/flow.config.json in this repo (defaults apply)');
    return;
  }
  let cfg = null;
  try {
    cfg = JSON.parse(raw);
  } catch (e) {
    push('config-schema', 'FAIL', `${p} does not parse: ${e.message}`);
    return;
  }
  if (!cfg || typeof cfg !== 'object' || Array.isArray(cfg)) {
    push('config-schema', 'FAIL', `${p} must be a JSON object`);
    return;
  }
  const bad = [];
  const unknown = [];
  for (const k of Object.keys(cfg)) {
    if (!Object.prototype.hasOwnProperty.call(CONFIG_SCHEMA, k)) {
      unknown.push(k);
      continue;
    }
    const want = CONFIG_SCHEMA[k](cfg[k]);
    if (want) bad.push(`${k} must be ${want} (got ${JSON.stringify(cfg[k])})`);
  }
  // One run reports everything wrong with the file: a type error must not hide
  // the unknown keys until the user fixes it and runs again.
  const unknownMsg = unknown.length ? `unknown key(s) ignored by every hook: ${unknown.join(', ')}` : '';
  if (bad.length) push('config-schema', 'FAIL', unknownMsg ? `${bad.join('; ')}; ${unknownMsg}` : bad.join('; '));
  else if (unknown.length) push('config-schema', 'WARN', unknownMsg);
  else push('config-schema', 'PASS', `${p} matches the documented schema`);
}

// Events flow registers hooks on; a project that registers its own on the same
// event runs both, and the project's can hide flow's decision.
const FLOW_HOOK_EVENTS = ['SessionStart', 'SessionEnd', 'UserPromptSubmit', 'PreToolUse', 'PostToolUse', 'Stop', 'PreCompact'];

function doctorProjectHooksCheck(push) {
  const hits = [];
  for (const rel of [path.join('.claude', 'settings.json'), path.join('.claude', 'hooks.json')]) {
    const raw = safeRead(path.join(process.cwd(), rel));
    if (raw === null) continue;
    let parsed = null;
    try {
      parsed = JSON.parse(raw);
    } catch {
      continue;
    }
    const hooksObj = parsed && typeof parsed.hooks === 'object' && parsed.hooks !== null ? parsed.hooks : parsed;
    if (!hooksObj || typeof hooksObj !== 'object') continue;
    for (const ev of FLOW_HOOK_EVENTS) {
      if (Array.isArray(hooksObj[ev]) && hooksObj[ev].length) hits.push(`${rel}:${ev}`);
    }
  }
  if (hits.length) {
    push('project-hooks', 'WARN', `this project registers its own hooks on events flow also uses (${hits.join(', ')}) — both run; a project hook that exits 2 hides flow's own result`);
  } else {
    push('project-hooks', 'PASS', 'this project registers no hooks on flow-owned events');
  }
}

// gates-runnable: can this repo's gates actually execute here? Runs
// detect-project and check-all --json from the cwd (C-C shapes).
function doctorGatesRunnableCheck(push) {
  const cwd = process.cwd();
  const detected = runDetectProject(cwd);
  const checkAll = sharedScript('check-all');
  if (!checkAll) {
    push('gates-runnable', 'WARN', 'check-all not found; cannot verify this project\'s gates', 'flow install');
    return;
  }
  const r = spawnSync('node', [checkAll, '--json', '--continue'], { cwd, encoding: 'utf8', timeout: 120000, killSignal: 'SIGKILL' });
  if (r.signal) {
    push('gates-runnable', 'WARN', `check-all --json was killed (${r.signal}) after 120s`);
    return;
  }
  let parsed = null;
  try {
    parsed = JSON.parse(r.stdout || '');
  } catch {
    parsed = null;
  }
  if (!parsed) {
    push('gates-runnable', 'WARN', `check-all --json printed no JSON (exit ${r.status}); gates could not be checked`, 'flow check');
    return;
  }
  if (!parsed.ecosystem || parsed.error === 'no_project_file') {
    push('gates-runnable', 'WARN', `no ecosystem detected in ${cwd}${detected && detected.language ? ` (detect-project says ${detected.language})` : ''}; no gates to run`);
    return;
  }
  const gates = Array.isArray(parsed.gates) ? parsed.gates : [];
  const broken = gates.filter((g) => g && g.status === 'unavailable');
  if (broken.length) {
    const named = broken.map((g) => `${g.name} (${g.message || 'unavailable'})`).join('; ');
    // `flow check` is NOT offered here: it re-runs the very commands that just
    // failed to start, so it cannot clear this FAIL. The only command that
    // provably has to happen first is a dependency install, and only when the
    // dependencies are demonstrably absent — otherwise this FAIL carries no
    // `→ run:` at all (the spec's "where one exists" clause).
    const depsMissing = fs.existsSync(path.join(cwd, 'package.json')) && !fs.existsSync(path.join(cwd, 'node_modules'));
    if (depsMissing) {
      const pkgMgr = (detected && detected.pkg_mgr) || 'npm';
      push('gates-runnable', 'FAIL', `gate binary cannot run: ${named}; this project has a package.json but no node_modules/`, `${pkgMgr} install`);
      return;
    }
    push('gates-runnable', 'FAIL', `gate binary cannot run: ${named}; no flow command starts a runner that is not installed — install it, or correct the script it names`, false);
    return;
  }
  push('gates-runnable', 'PASS', `${parsed.ecosystem}: ${gates.length} gate(s), every runner executable`);
}

// live-hooks-match-cwd: editing hooks in a worktree while ~/.claude/hooks
// points at another checkout means the edits do not affect this session.
function doctorLiveHooksMatchCwdCheck(push) {
  let hooksReal = null;
  try {
    hooksReal = fs.realpathSync(path.join(HOME, '.claude', 'hooks'));
  } catch {
    return; // nothing deployed; the symlink checks already say so
  }
  const hooksTop = gitToplevel(hooksReal);
  const cwdTop = gitToplevel(process.cwd());
  if (!hooksTop || !cwdTop) return;
  if (physicalPath(hooksTop) === physicalPath(cwdTop)) {
    push('live-hooks-match-cwd', 'PASS', `~/.claude/hooks resolves inside this checkout (${cwdTop})`);
    return;
  }
  if (!isDir(path.join(cwdTop, 'plugins', 'flow', 'hooks'))) {
    push('live-hooks-match-cwd', 'PASS', 'this checkout does not carry harness hooks; nothing to keep live');
    return;
  }
  // The `→ run:` here repoints this machine's ~/.claude at THIS checkout —
  // useful while working in a worktree, wrong to leave behind (the links dangle
  // once the worktree is removed), so the detail states the consequence and the
  // exact reversal rather than presenting the relink as the plain fix.
  push(
    'live-hooks-match-cwd',
    'FAIL',
    `edits here are not live until merged into ${hooksTop} (~/.claude/hooks resolves there, not to ${cwdTop}); ` +
      `the run below repoints this machine at ${cwdTop} until you revert it with: flow install --marketplace ${hooksTop}`,
    `flow install --marketplace ${shellQuote(cwdTop)}`
  );
}

function hasForcePushDeny(settingsPath) {
  const raw = safeRead(settingsPath);
  if (raw === null) return false;
  try {
    const parsed = JSON.parse(raw);
    const deny = parsed && parsed.permissions && parsed.permissions.deny;
    return Array.isArray(deny) && deny.some((d) => typeof d === 'string' && d.indexOf('git push --force') !== -1);
  } catch {
    return false;
  }
}

function doctorPermissionsDenyCheck(push) {
  const user = path.join(HOME, '.claude', 'settings.json');
  const project = path.join(process.cwd(), '.claude', 'settings.json');
  if (hasForcePushDeny(user) || hasForcePushDeny(project)) {
    push('permissions-deny', 'PASS', 'a permissions.deny rule covers `git push --force`');
    return;
  }
  push(
    'permissions-deny',
    'WARN',
    `neither ${user} nor ${project} denies \`git push --force\` — git-guard still refuses it, but the permission layer would not`
  );
}

// dotfilesRoot: see doctorSymlinkChecks above — forwarded through so a
// `flow install --dotfiles <path>` recheck (C18 step 7) compares against
// the root that install actually used, not always $HOME/.dotfiles.
// --verbose (or FLOW_VERBOSE=1) names each check on stderr before it runs,
// so a check that hangs (a subprocess that never returns) is identifiable.
const VERBOSE = process.argv.includes('--verbose') || process.env.FLOW_VERBOSE === '1';

// A FAIL the user can act on names the command that fixes it. Checks that
// pass an explicit fix win; otherwise the id decides.
const DEFAULT_FIXES = [
  [/^symlink:/, 'flow install --force'],
  [/^settings:hooks-key$/, 'flow install'],
  [/^plugin-hooks-json$/, 'flow install --force'],
  [/^skills-lint$/, '~/.claude/scripts/skills-lint'],
];

// `explicit === false` means the check PROVED no command fixes this one, and
// suppresses the id's default: a `→ run:` that cannot clear the FAIL is worse
// than none (the spec only asks for one "where one exists").
function fixCommandFor(id, explicit) {
  if (explicit === false) return null;
  if (explicit) return explicit;
  for (const [re, cmd] of DEFAULT_FIXES) if (re.test(id)) return cmd;
  return null;
}

function buildDoctorChecks(dotfilesRoot, deep) {
  const checks = [];
  const push = (id, status, detail, fix) => {
    const cmd = status === 'FAIL' ? fixCommandFor(id, fix) : null;
    checks.push({ id, status, detail: cmd ? `${detail} → run: ${cmd}` : detail });
  };
  const run = (name, fn) => {
    if (VERBOSE) process.stderr.write(`  check ${name}`);
    const t0 = Date.now();
    fn();
    if (VERBOSE) process.stderr.write(` (${Date.now() - t0} ms)\n`);
  };
  run('symlinks', () => doctorSymlinkChecks(push, dotfilesRoot));
  run('settings:hooks-key', () => doctorHooksKeyCheck(push));
  run('hooks-drift', () => doctorHooksDriftCheck(push));
  run('flow-config-overrides', () => doctorHarnessJsonOverridesCheck(push));
  run('config-schema', () => doctorConfigSchemaCheck(push));
  run('project-hooks', () => doctorProjectHooksCheck(push));
  run('thresholds-referenced', () => doctorThresholdsReferencedCheck(push));
  run('progress-md', () => doctorProgressCheck(push));
  run('specs-state', () => doctorSpecsStateCheck(push));
  run('gates-runnable', () => doctorGatesRunnableCheck(push));
  run('loop-contract', () => doctorLoopCheck(push));
  run('tools', () => doctorToolChecks(push));
  run('skill-index-cost', () => doctorSkillIndexCostCheck(push));
  // skills-lint walks every skill file: too slow for the default run (B25).
  if (deep) run('skills-lint', () => doctorSkillsLintCheck(push));
  run('plugin-skills-flow', () => doctorPluginSkillsHarnessCheck(push));
  run('plugin-hooks-json', () => doctorPluginHooksJsonCheck(push));
  run('plugin-double-registration', () => doctorPluginDoubleRegistrationCheck(push));
  run('plugin-double-load', () => doctorPluginDoubleLoadCheck(push));
  run('local-bin-harness', () => doctorLocalBinHarnessCheck(push));
  run('live-hooks-match-cwd', () => doctorLiveHooksMatchCwdCheck(push));
  run('permissions-deny', () => doctorPermissionsDenyCheck(push));
  run('plugin-list', () => doctorPluginListCheck(push));
  return checks;
}

// dotfilesRoot: optional override of the symlink-check target root, used
// only by `flow install`'s own trailing doctor recheck (C18 step 7); the
// plain `flow doctor` command (main()) never passes it, so its behaviour
// is unchanged ($HOME/.dotfiles default).
function cmdDoctor(argv, dotfilesRoot) {
  const jsonMode = argv.includes('--json');
  const checks = buildDoctorChecks(dotfilesRoot, argv.includes('--deep'));
  const summary = { pass: 0, warn: 0, fail: 0 };
  for (const c of checks) {
    if (c.status === 'PASS') summary.pass++;
    else if (c.status === 'WARN') summary.warn++;
    else if (c.status === 'FAIL') summary.fail++;
  }
  if (jsonMode) {
    stdout.write(JSON.stringify({ checks, summary }, null, 2) + '\n');
  } else {
    stdout.write(`\n${C.primary}${C.bold}flow doctor${C.reset}\n`);
    for (const c of checks) {
      const col = c.status === 'PASS' ? C.success : c.status === 'WARN' ? C.warning : C.error;
      stdout.write(`  ${col}${c.status.padEnd(4)}${C.reset} ${c.id}: ${c.detail}\n`);
    }
    stdout.write(`\n  ${summary.pass} pass, ${summary.warn} warn, ${summary.fail} fail\n\n`);
  }
  return summary.fail > 0 ? 1 : 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// init
// ─────────────────────────────────────────────────────────────────────────────

const STACKS = {
  node: {
    thresholdFile: '.flow/eslint.thresholds.mjs',
    thresholdForce: true,
    linter: 'eslint',
    defaults: { maxFileLines: 400, maxFuncLines: 60, complexity: 10, maxParams: 4, maxDepth: 4 },
    // key -> the setting name written into thresholdContent, so a note about
    // an unmeasured key names something the reader can find in the file.
