#!/usr/bin/env bash
# flow-lint — validate a TASKS.md against the flow v2 grammar (spec 004 K-B).
#
# Folds the v1 plan grammar linter, the v1 [P]-disjointness checker and the
# git joins (done: sha reachable in Base..HEAD and touching the task's files:,
# plus the ID-vanish diff against HEAD:) into one pass.
#
# Fence-aware: lines inside ``` or ~~~ fences are never headings or tasks,
# so a fenced example in a spec can never become a routing predicate.
set -u

print_help() {
  cat <<'EOF'
Usage: flow-lint [<TASKS.md>] [--json] [--waves]

Validates a TASKS.md against the flow v2 task grammar:

  header   Spec: · Design: · Base: <sha> · Route: bounded|oneshot|dispatch
           · Test: <cmd>          (optional Approved:/Verified: lines)
  sections ## Behaviors, ## Phase N — <title>, ## Gates
  task     - [ |x|~] <ID> [P]? <desc> — files: <p,p> — verify: <`cmd`|human: <obs>>
                     [— after: <IDs>] [— follow: <path>] [— no_claim: <text>]
                     [— dropped: <reason>] [— done: <sha>]
           no_claim: what a green verify does not prove (a mocked model or
           cloud call, an in-memory database); only for a verify that mocks
           an external seam. Lint reads it as a known key and ignores the text.
  IDs      T### tasks · CHK### human checkpoints · G### gates

ERRORS   [P] tasks whose files: intersect inside one wave; missing verify:;
         an [x] whose done: sha is not in Base..HEAD or whose commit touched
         none of its files:; an ID present at HEAD: and absent now; [~] with
         no dropped:; unknown or cyclic after:; a malformed task line; a
         follow: path that does not exist; a ## Review focus line naming an
         unknown id, or more than 5 such lines; when Spec: numbers FR-NN rows
         (and Approved: is absent or dated on/after BEHAVIORS_FROM): an FR with
         no Behaviors row, a row citing an id the spec lacks, a row whose Task
         cell names no task; design-marker (Design: names a file that does not
         exist, or is none/absent while design.md sits beside TASKS.md) and
         parity-marker (the Spec: file says **Behaviour-preserving**: yes but
         the header lacks Parity: or no task T000 exists), both only for a
         feature that is unapproved or approved on/after MARKERS_FROM;
         baseline-missing (Test: is set and no task T000 records the suite at
         Base), spec-criterion-changed (an FR-NN row of the Spec: file was
         removed or reworded since Base, with no later ## Amendment and no
         Ruling: naming it), open-question-blocks-tasks (the Spec: file still
         holds a [NEEDS CLARIFICATION: ... blocks: tasks] marker); these three
         apply when Approved: (else the Base commit) is dated on/after
         NEW_RULES_FROM.
WARNINGS a phase with no Goal: or no Independent test:; [x] with no done:;
         a files: path the task's done: commit did not change (files-untouched);
         a Parity: header with no task verify: naming verify/parity-redcheck.txt;
         task-joined (a T### description that joins two actions with "and");
         task-generic (a T### description that opens with explore, investigate,
         research, look into or spike: discovery is done while drafting).
INFO     Route: oneshot with more than 5 tasks.

Every ERROR carries a fix: string. --json prints the machine form
{ok, errors, warnings, info, waves, tasks, header}. --waves prints the
computed dispatch waves. Exit 1 when there is at least one ERROR.

With no <TASKS.md>, resolves the active feature the way the router does:
$FLOW_SPEC → .specs/.current → branch flow/<slug>.
EOF
}

JSON=0
WAVES=0
FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
  --help | -h)
    print_help
    exit 0
    ;;
  --json)
    JSON=1
    shift
    ;;
  --waves)
    WAVES=1
    shift
    ;;
  --)
    shift
    break
    ;;
  -*)
    printf 'flow-lint: unknown option: %s\n' "$1" >&2
    exit 2
    ;;
  *)
    FILE=$1
    shift
    ;;
  esac
done
[ -z "$FILE" ] && [ $# -gt 0 ] && FILE=$1

if ! command -v git >/dev/null 2>&1; then
  printf 'flow lint: git not found on PATH\n' >&2
  exit 1
fi

TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null || true)

# ---------- resolve the active TASKS.md the way the router does ----------

# _rf_is_stealth <root> — rc 0 when <root>/.specs is a symlink whose physical
# target is outside <root>'s own physical path (docs/research/16-stealth-
# specs-2026.md §0/§3): a private store, not an in-tree directory.
_rf_is_stealth() {
  [ -L "$1/.specs" ] || return 1
  local rootp specsp
  rootp=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  specsp=$(cd "$1/.specs" 2>/dev/null && pwd -P) || return 1
  case "$specsp" in
  "$rootp"/*) return 1 ;;
  esac
  return 0
}

# _rf_slug_exists <root> <slug> — rc 0 when <slug> names a .specs/ feature
# dir, exactly or with its NNN- prefix stripped (the same match below).
# [0-9][0-9][0-9]-$slug, not *-$slug: flow/login must match 002-login, not
# 001-auth-login (the router's own match is d.slice(4) === slug — an EXACT
# NNN- prefix strip, not "ends with -slug").
_rf_slug_exists() {
  [ -d "$1/.specs/$2" ] && return 0
  local d
  for d in "$1"/.specs/[0-9][0-9][0-9]-"$2"; do
    [ -d "$d" ] && return 0
  done
  return 1
}

resolve_file() {
  [ -n "$FILE" ] && return 0
  local root=${TOPLEVEL:-.} slug="" br bslug
  if [ -n "${FLOW_SPEC:-}" ]; then
    slug=$FLOW_SPEC
  else
    # Stealth: .specs/.current lives in the store and is shared by every
    # worktree through the link, so flow/<slug> has to outrank it here or a
    # worktree routes to whatever feature another worktree last made current.
    if _rf_is_stealth "$root"; then
      br=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
      case "$br" in
      flow/*)
        bslug=${br#flow/}
        _rf_slug_exists "$root" "$bslug" && slug=$bslug
        ;;
      esac
    fi
    if [ -z "$slug" ] && [ -f "$root/.specs/.current" ]; then
      slug=$(head -1 "$root/.specs/.current" | tr -d '\r' | tr -d '[:space:]')
    fi
    if [ -z "$slug" ]; then
      br=${br:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)}
      case "$br" in
      flow/*) slug=${br#flow/} ;;
      esac
    fi
  fi
  [ -z "$slug" ] && return 1
  if [ -f "$root/.specs/$slug/TASKS.md" ]; then
    FILE="$root/.specs/$slug/TASKS.md"
    return 0
  fi
  # branch slug may omit the NNN- prefix — match it exactly, not "ends with"
  local d
  for d in "$root"/.specs/[0-9][0-9][0-9]-"$slug"; do
    if [ -f "$d/TASKS.md" ]; then
      FILE="$d/TASKS.md"
      return 0
    fi
  done
  return 1
}

if ! resolve_file; then
  printf 'flow-lint: no TASKS.md given and none resolvable (set $FLOW_SPEC, write .specs/.current, or pass a path)\n' >&2
  exit 2
fi

if [ ! -f "$FILE" ]; then
  if [ "$JSON" -eq 1 ]; then
    printf '{"ok":false,"errors":[{"line":0,"id":"","rule":"file-missing","message":"file not found: %s","fix":"create it with new-spec, or pass the right path"}],"warnings":[],"info":[],"waves":[],"tasks":[],"header":{}}\n' "$FILE"
  else
    printf 'ERROR 0: [file-missing] file not found: %s\n  fix: create it with new-spec, or pass the right path\n' "$FILE"
  fi
  exit 1
fi

# ---------- json helpers ----------
TAB=$(printf '\t')
# jstr_var writes $R_JS; jstr echoes. The emitters call this a dozen times per
# task, and on a slow-fork machine every command substitution is ~15ms.
R_JS=""
jstr_var() {
  R_JS=${1//\\/\\\\}
  R_JS=${R_JS//\"/\\\"}
  R_JS=${R_JS//"$TAB"/\\t}
  R_JS="\"$R_JS\""
}
jstr() {
  jstr_var "$1"
  printf '%s' "$R_JS"
}

jlist() { # comma-separated -> json array of strings
  local rest=$1 out="" item
  while [ -n "$rest" ]; do
    case "$rest" in
    *,*)
      item=${rest%%,*}
      rest=${rest#*,}
      ;;
    *)
      item=$rest
      rest=""
      ;;
    esac
    trim_var "$item"
    item=$R_TRIM
    [ -z "$item" ] && continue
    jstr_var "$item"
    out="$out${out:+,}$R_JS"
  done
  printf '[%s]' "$out"
}

# trim / lstrip write to $R_TRIM rather than echoing, because a command
# substitution is a fork and these run per line and per field. flow-lint used
# to spend all of its time in `printf | sed`: on a machine where sed costs
# ~110ms (a shim, a scanned binary, a slow FS) that pushed a 200-line TASKS.md
# past the router's 30s timeout, and every state read scan-failed.
R_TRIM=""
trim_var() {
  R_TRIM=$1
  while :; do
    case "$R_TRIM" in
    [[:space:]]*) R_TRIM=${R_TRIM#?} ;;
    *) break ;;
    esac
  done
  while :; do
    case "$R_TRIM" in
    *[[:space:]]) R_TRIM=${R_TRIM%?} ;;
    *) break ;;
    esac
  done
}
lstrip_var() {
  R_TRIM=$1
  while :; do
    case "$R_TRIM" in
    [[:space:]]*) R_TRIM=${R_TRIM#?} ;;
    *) break ;;
    esac
  done
}
trim() {
  trim_var "$1"
  printf '%s' "$R_TRIM"
}

# seg_key <seg> — rc 0 and sets $R_KEY when <seg> looks like a field key
# ("<key>:…" with key made only of letters, dash, underscore); rc 1 and
# empty $R_KEY otherwise. Catches a typo'd field (e.g. "afetr: T001") instead
# of silently folding it into the description.
R_KEY=""
seg_key() {
  R_KEY=""
  case "$1" in
  *:*) ;;
  *) return 1 ;;
  esac
  local k=${1%%:*}
  case "$k" in
  '') return 1 ;;
  *[!a-zA-Z_-]*) return 1 ;;
  esac
  R_KEY=$k
  return 0
}

# hyphen_hint <text> — rc 0 and sets $R_HINT to the first " - field:" or
# " -- field:" substring found in <text> (field one of verify/files/after);
# rc 1 otherwise. A plain hyphen where the grammar wants an em dash makes the
# field fold into the previous segment and vanish, so the user otherwise only
# sees a generic missing-verify with no clue why.
R_HINT=""
hyphen_hint() {
  R_HINT=""
  case "$1" in
  *' -- verify:'*) R_HINT=' -- verify:' ;;
  *' - verify:'*) R_HINT=' - verify:' ;;
  *' -- files:'*) R_HINT=' -- files:' ;;
  *' - files:'*) R_HINT=' - files:' ;;
  *' -- after:'*) R_HINT=' -- after:' ;;
  *' - after:'*) R_HINT=' - after:' ;;
  *) return 1 ;;
  esac
  return 0
}

# ---------- finding accumulators ----------
ERRN=0
ERRJ=""
ERRT=""
WARNN=0
WARNJ=""
WARNT=""
INFON=0
INFOJ=""
INFOT=""

add_err() { # line id rule message fix
  ERRN=$((ERRN + 1))
  ERRJ="$ERRJ${ERRJ:+,}{\"line\":$1,\"id\":$(jstr "$2"),\"rule\":$(jstr "$3"),\"message\":$(jstr "$4"),\"fix\":$(jstr "$5")}"
  ERRT="$ERRT$(printf 'ERROR %s:%s [%s] %s\n  fix: %s\n' "$1" "$2" "$3" "$4" "$5")
"
}
add_warn() { # line id rule message
  WARNN=$((WARNN + 1))
  WARNJ="$WARNJ${WARNJ:+,}{\"line\":$1,\"id\":$(jstr "$2"),\"rule\":$(jstr "$3"),\"message\":$(jstr "$4"),\"fix\":$(jstr "${5:-}")}"
  WARNT="$WARNT$(printf 'WARN  %s:%s [%s] %s\n' "$1" "$2" "$3" "$4")${5:+
  fix: $5}
"
}
add_info() { # line id rule message
  INFON=$((INFON + 1))
  INFOJ="$INFOJ${INFOJ:+,}{\"line\":$1,\"id\":$(jstr "$2"),\"rule\":$(jstr "$3"),\"message\":$(jstr "$4"),\"fix\":$(jstr "${5:-}")}"
  INFOT="$INFOT$(printf 'INFO  %s:%s [%s] %s\n' "$1" "$2" "$3" "$4")${5:+
  fix: $5}
"
}

# ---------- parse ----------
EMD=' — ' # em dash separator, U+2014 with single spaces

H_SPEC=""
H_DESIGN=""
H_BASE=""
H_ROUTE=""
H_TEST=""
H_APPROVED=""
H_VERIFIED=""
H_PARITY=""
H_TITLE=""

# Behaviors coverage by spec id (ERROR) applies to features approved on or
# after this date, or not yet approved, so in-flight features keep linting as
# before (the way lint.js gates claim-check).
BEHAVIORS_FROM="2026-10-11"
MARKERS_FROM="2026-10-12"
# baseline-missing, spec-criterion-changed and open-question-blocks-tasks apply
# to a feature whose Approved: date (else its Base commit date) is on or after
# this, so plans already in flight keep linting clean.
NEW_RULES_FROM="2026-10-13"

T_ID=()
T_STATE=()
T_PAR=()
T_FILES=()
T_VERIFY=()
T_AFTER=()
T_DONE=()
T_BYUSER=()
T_DROPPED=()
T_FOLLOW=()
T_NOCLAIM=()
T_PHASE=()
T_LINE=()
T_DESC=()
T_KIND=()
N=0

SECTION=""
PHASE=""
PHASE_LINE=0
PHASE_GOAL=0
PHASE_ITEST=0
SEEN_BEHAVIORS=0
SEEN_GATES=0
BEH_ROWS=()
BEH_LINES=()
FOCUS_LINES=()
FOCUS_LNS=()
IN_FENCE=0
FENCE_CH=""
LN=0

flush_phase() {
  [ -z "$PHASE" ] && return 0
  [ "$PHASE_GOAL" -eq 0 ] && add_warn "$PHASE_LINE" "" "phase-no-goal" "phase \"$PHASE\" has no Goal: line"
  [ "$PHASE_ITEST" -eq 0 ] && add_warn "$PHASE_LINE" "" "phase-no-independent-test" "phase \"$PHASE\" has no Independent test: line"
  return 0
}

read_header_fields() { # one physical line, fields may be joined by ·
  local rest=$1 seg
  case "$rest" in '<!--'*) return 0 ;; esac # a comment documents fields, it sets none
  while [ -n "$rest" ]; do
    case "$rest" in
    *·*)
      seg=${rest%%·*}
      rest=${rest#*·}
      ;;
    *)
      seg=$rest
      rest=""
      ;;
    esac
    trim_var "$seg"
    seg=$R_TRIM
    case "$seg" in
    Spec:*) trim_var "${seg#Spec:}"; H_SPEC=$R_TRIM ;;
    Design:*) trim_var "${seg#Design:}"; H_DESIGN=$R_TRIM ;;
    Base:*) trim_var "${seg#Base:}"; H_BASE=$R_TRIM ;;
    Route:*) trim_var "${seg#Route:}"; H_ROUTE=$R_TRIM ;;
    Test:*) trim_var "${seg#Test:}"; H_TEST=$R_TRIM ;;
    Approved:*) trim_var "${seg#Approved:}"; H_APPROVED=$R_TRIM ;;
    Verified:*) trim_var "${seg#Verified:}"; H_VERIFIED=$R_TRIM ;;
    Parity:*) trim_var "${seg#Parity:}"; H_PARITY=$R_TRIM ;;
    esac
  done
}

while IFS= read -r raw || [ -n "$raw" ]; do
  LN=$((LN + 1))
  line=${raw%$'\r'}

  # fence tracking
  lstrip_var "$line"
  stripped=$R_TRIM
  case "$stripped" in
  '```'* | '~~~'*)
    ch=${stripped:0:3} # ASCII fence marker, so byte == char here
    if [ "$IN_FENCE" -eq 0 ]; then
      IN_FENCE=1
      FENCE_CH=$ch
    elif [ "$ch" = "$FENCE_CH" ]; then
      IN_FENCE=0
      FENCE_CH=""
    fi
    continue
    ;;
  esac
  [ "$IN_FENCE" -eq 1 ] && continue

  case "$line" in
  '# '*)
    trim_var "${line#\# }"
    H_TITLE=$R_TRIM
    continue
    ;;
  '## Behaviors'*)
    flush_phase
    PHASE=""
    SECTION=behaviors
    SEEN_BEHAVIORS=1
    continue
    ;;
  '## Review focus'*)
    flush_phase
    PHASE=""
    SECTION=focus
    continue
    ;;
  '## Gates'*)
    flush_phase
    PHASE=""
    SECTION=gates
    SEEN_GATES=1
    continue
    ;;
  '## Phase '*)
    flush_phase
    SECTION=phase
    trim_var "${line#\#\# }"
    PHASE=$R_TRIM
    PHASE_LINE=$LN
    PHASE_GOAL=0
    PHASE_ITEST=0
    continue
    ;;
  '## '*)
    flush_phase
    PHASE=""
    SECTION=other
    continue
    ;;
  esac

  case "$stripped" in
  'Goal:'*) [ -n "$PHASE" ] && PHASE_GOAL=1 ;;
  'Independent test:'*) [ -n "$PHASE" ] && PHASE_ITEST=1 ;;
  esac

  # ## Review focus lines and ## Behaviors table rows are kept for the checks below
  if [ "$SECTION" = focus ]; then
    case "$stripped" in
    '' | '<!--'* | '>'*) ;;
    *)
      FOCUS_LINES[${#FOCUS_LINES[@]}]=$stripped
      FOCUS_LNS[${#FOCUS_LNS[@]}]=$LN
      ;;
    esac
    continue
  fi
  if [ "$SECTION" = behaviors ]; then
    case "$stripped" in
    '|'*)
      BEH_ROWS[${#BEH_ROWS[@]}]=$stripped
      BEH_LINES[${#BEH_LINES[@]}]=$LN
      ;;
    esac
  fi

  # header fields live above the first section
  if [ -z "$SECTION" ]; then
    read_header_fields "$line"
  else
    case "$stripped" in
    Approved:*) trim_var "${stripped#Approved:}"; H_APPROVED=$R_TRIM ;;
    Verified:*) trim_var "${stripped#Verified:}"; H_VERIFIED=$R_TRIM ;;
    esac
  fi

  # ---- task lines ----
  case "$stripped" in
  '- ['?'] '*) ;;
  *) continue ;;
  esac

  st=${stripped:3:1} # the checkbox char in the fixed "- [S] " prefix
  case "$st" in
  ' ' | x | '~') ;;
  *)
    add_err "$LN" "" "bad-state" "task state must be one of ' ', 'x', '~', got '$st'" "write '- [ ] ', '- [x] ' or '- [~] '"
    continue
    ;;
  esac

  # strip the fixed 6-char "- [S] " prefix (all ASCII, so byte == char here)
  trim_var "${stripped:6}"
  body=$R_TRIM

  id=${body%% *}
  case "$id" in
  T[0-9][0-9][0-9] | CHK[0-9][0-9][0-9] | G[0-9][0-9][0-9]) ;;
  *)
    add_err "$LN" "$id" "bad-id" "task id must be T###, CHK### or G###, got \"$id\"" "renumber the line, e.g. '- [ ] T00${LN} <description> — files: … — verify: …'"
    continue
    ;;
  esac
  rest=${body#"$id"}
  trim_var "$rest"
  rest=$R_TRIM

  par=0
  case "$rest" in
  '[P] '*)
    par=1
    trim_var "${rest#\[P\]}"
    rest=$R_TRIM
    ;;
  esac

  # split the remainder on the em dash into keyed segments
  desc=""
  f_files=""
  f_verify=""
  f_after=""
  f_done=""
  f_byuser=0
  f_dropped=""
  f_follow=""
  f_noclaim=""
  has_verify=0
  seg_rest="$rest"
  first=1
  while :; do
    case "$seg_rest" in
    *"$EMD"*)
      seg=${seg_rest%%"$EMD"*}
      seg_rest=${seg_rest#*"$EMD"}
      ;;
    *)
      seg=$seg_rest
      seg_rest=""
      ;;
    esac
    trim_var "$seg"
    seg=$R_TRIM
    if [ "$first" -eq 1 ]; then
      desc=$seg
      first=0
    else
      case "$seg" in
      files:*) trim_var "${seg#files:}"; f_files=$R_TRIM ;;
      verify:*)
        trim_var "${seg#verify:}"
        f_verify=$R_TRIM
        has_verify=1
        ;;
      after:*) trim_var "${seg#after:}"; f_after=$R_TRIM ;;
      # `flow tick --by <who>` writes "done: <sha> by <who>", and a CHK can
      # only be ticked that way — so the sha is the first word, never the tail.
      done:*)
        trim_var "${seg#done:}"
        f_done=${R_TRIM%% by *}
        case "$R_TRIM" in *' by user') f_byuser=1 ;; esac
        ;;
      dropped:*) trim_var "${seg#dropped:}"; f_dropped=$R_TRIM ;;
      follow:*) trim_var "${seg#follow:}"; f_follow=$R_TRIM ;;
      no_claim:*) trim_var "${seg#no_claim:}"; f_noclaim=$R_TRIM ;;
      *)
        if seg_key "$seg"; then
          add_err "$LN" "$id" "unknown-field" "$id has unknown field \"$R_KEY:\"" "known keys are files:, verify:, after:, follow:, no_claim:, done:, dropped: — fix \"$R_KEY:\" or move it into the description before the first em dash"
        else
          desc="$desc — $seg"
        fi
        ;;
      esac
    fi
    [ -z "$seg_rest" ] && break
  done

  case "$id" in
  T*) kind=task ;;
  CHK*) kind=checkpoint ;;
  *) kind=gate ;;
  esac
  [ "$SECTION" = gates ] && kind=gate

  T_ID[$N]=$id
  T_STATE[$N]=$st
  T_PAR[$N]=$par
  T_FILES[$N]=$f_files
  T_VERIFY[$N]=$f_verify
  T_AFTER[$N]=$f_after
  T_DONE[$N]=$f_done
  T_BYUSER[$N]=$f_byuser
  T_DROPPED[$N]=$f_dropped
  T_FOLLOW[$N]=$f_follow
  T_NOCLAIM[$N]=$f_noclaim
  T_PHASE[$N]=$PHASE
  T_LINE[$N]=$LN
  T_DESC[$N]=$desc
  T_KIND[$N]=$kind
  N=$((N + 1))

  # ---- per-line rules ----
  if [ "$has_verify" -eq 0 ] || [ -z "$f_verify" ]; then
    mv_fix="append ' — verify: \`<command>\`' (or ' — verify: human: <observable>') to the $id line"
    if hyphen_hint "$rest" || hyphen_hint "$f_files"; then
      mv_fix="found '$R_HINT' — the separator must be an em dash ' — '"
    fi
    add_err "$LN" "$id" "missing-verify" "$id has no verify:" "$mv_fix"
  fi
  if [ "$st" = '~' ] && [ -z "$f_dropped" ]; then
    add_err "$LN" "$id" "dropped-no-reason" "$id is [~] with no dropped: reason" "append ' — dropped: <why>' to the $id line, or restore it to '- [ ]'"
  fi
  if [ "$st" = 'x' ] && [ -z "$f_done" ] && [ "$kind" != gate ]; then
    add_warn "$LN" "$id" "checked-no-sha" "$id is [x] with no done: sha" "run flow tick $id"
  fi
  if [ "$par" -eq 1 ] && [ -z "$f_files" ]; then
    add_err "$LN" "$id" "parallel-no-files" "$id is [P] but declares no files:" "add ' — files: <path,path>' so flow lint can prove the wave is disjoint"
  fi
  if [ "$kind" = task ]; then
    # Two actions joined by "and" overflow one developer context. Needs an action
    # verb after an object, so "Read and write cache" (one noun phrase) passes.
    jn_low=$(printf '%s' "$desc" | tr '[:upper:]' '[:lower:]')
    if [[ "$jn_low" =~ [^[:space:]]+[[:space:]]+.+[[:space:]]and[[:space:]]+(add|create|implement|build|export|import|remove|delete|migrate|wire|rename|replace)([^[:alnum:]_]|$) ]]; then
      add_warn "$LN" "$id" "task-joined" "$id joins two actions with \"and\": $desc" "split into two tasks ordered with after:"
    fi
    # Discovery is done while drafting, so the task names the concrete change.
    if [[ "$jn_low" =~ ^(explore|investigate|research|look[[:space:]]+into|spike)([^[:alnum:]_]|$) ]]; then
      add_warn "$LN" "$id" "task-generic" "$id opens with a discovery verb: $desc" "do the discovery now and name the concrete change, or route it to /flow:prep"
    fi
  fi
  if [ -n "$f_follow" ]; then
    case "$f_follow" in
    /*) fw_path=$f_follow ;;
    *) fw_path="${TOPLEVEL:-.}/$f_follow" ;;
    esac
    [ -e "$fw_path" ] || add_err "$LN" "$id" "follow-missing" "$id follows $f_follow, which does not exist" "point follow: at an existing file (a repo-relative path), or drop it"
  fi
done <"$FILE"
flush_phase

[ "$SEEN_BEHAVIORS" -eq 0 ] && add_warn 0 "" "no-behaviors" "no ## Behaviors section"
[ "$SEEN_GATES" -eq 0 ] && add_warn 0 "" "no-gates" "no ## Gates section"

# ---------- waves ----------
# idx_of sets $R_IDX instead of echoing: it is called inside the wave
# levelling loop, so a fork here is O(tasks^3) subshells.
R_IDX=-1
idx_of() { # id -> $R_IDX, or -1
  local want=$1 i=0
  R_IDX=-1
  while [ "$i" -lt "$N" ]; do
    if [ "${T_ID[$i]}" = "$want" ]; then
      R_IDX=$i
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

WAVE=()
i=0
while [ "$i" -lt "$N" ]; do
  WAVE[$i]=-1
  i=$((i + 1))
done

# validate after: targets, seed wave 0
i=0
while [ "$i" -lt "$N" ]; do
  if [ "${T_KIND[$i]}" = gate ] || [ "${T_STATE[$i]}" = '~' ]; then
    WAVE[$i]=-2 # excluded from wave scheduling
    i=$((i + 1))
    continue
  fi
  deps=${T_AFTER[$i]//,/ }
  ok=1
  for d in $deps; do
    trim_var "$d"
    d=$R_TRIM
    [ -z "$d" ] && continue
    idx_of "$d"
    j=$R_IDX
    if [ "$j" -lt 0 ]; then
      add_err "${T_LINE[$i]}" "${T_ID[$i]}" "unknown-after" "${T_ID[$i]} depends on \"$d\", which is not a task in this file" "fix the after: list on ${T_ID[$i]}, or add the missing task"
      ok=0
    fi
  done
  trim_var "${T_AFTER[$i]}"
  if [ "$ok" -eq 0 ]; then
    WAVE[$i]=-2 # dangling after: — already an ERROR, do not also report a cycle
  elif [ -z "$R_TRIM" ]; then
    WAVE[$i]=0  # no after: at all — this task is in wave 0
  fi
  i=$((i + 1))
done

# level: wave = 1 + max(wave of deps); iterate to a fixed point
pass=0
while [ "$pass" -le "$N" ]; do
  changed=0
  i=0
  while [ "$i" -lt "$N" ]; do
    if [ "${WAVE[$i]}" -eq -1 ]; then
      deps=${T_AFTER[$i]//,/ }
      maxw=-1
      ready=1
      for d in $deps; do
        trim_var "$d"
        d=$R_TRIM
        [ -z "$d" ] && continue
        idx_of "$d"
    j=$R_IDX
        if [ "$j" -lt 0 ]; then
          ready=0
          continue
        fi
        if [ "${WAVE[$j]}" -eq -2 ]; then continue; fi
        if [ "${WAVE[$j]}" -lt 0 ]; then
          ready=0
          break
        fi
        [ "${WAVE[$j]}" -gt "$maxw" ] && maxw=${WAVE[$j]}
      done
      if [ "$ready" -eq 1 ]; then
        WAVE[$i]=$((maxw + 1))
        changed=1
      fi
    fi
    i=$((i + 1))
  done
  [ "$changed" -eq 0 ] && break
  pass=$((pass + 1))
done

i=0
while [ "$i" -lt "$N" ]; do
  if [ "${WAVE[$i]}" -eq -1 ]; then
    add_err "${T_LINE[$i]}" "${T_ID[$i]}" "after-cycle" "${T_ID[$i]} is in an after: cycle (or depends on one)" "break the cycle: remove one after: entry so the dependency graph is acyclic"
    WAVE[$i]=-2
  fi
  i=$((i + 1))
done

MAXW=-1
i=0
while [ "$i" -lt "$N" ]; do
  [ "${WAVE[$i]}" -gt "$MAXW" ] && MAXW=${WAVE[$i]}
  i=$((i + 1))
done

# ---------- [P] disjointness within a wave ----------
files_intersect() { # "a, b" "b, c" -> 0 when they share a path
  local a b x y
  for x in ${1//,/ }; do
    trim_var "$x"
    a=$R_TRIM
    [ -z "$a" ] && continue
    for y in ${2//,/ }; do
      trim_var "$y"
      b=$R_TRIM
      [ -z "$b" ] && continue
      if [ "$a" = "$b" ]; then
        printf '%s' "$a"
        return 0
      fi
    done
  done
  return 1
}

w=0
while [ "$w" -le "$MAXW" ]; do
  i=0
  while [ "$i" -lt "$N" ]; do
    if [ "${WAVE[$i]}" -eq "$w" ] && [ "${T_PAR[$i]}" -eq 1 ]; then
      j=$((i + 1))
      while [ "$j" -lt "$N" ]; do
        if [ "${WAVE[$j]}" -eq "$w" ] && [ "${T_PAR[$j]}" -eq 1 ]; then
          if shared=$(files_intersect "${T_FILES[$i]}" "${T_FILES[$j]}"); then
            add_err "${T_LINE[$j]}" "${T_ID[$j]}" "parallel-overlap" \
              "${T_ID[$i]} and ${T_ID[$j]} are both [P] in wave $w and both own $shared" \
              "drop [P] from ${T_ID[$j]}, or add ' — after: ${T_ID[$i]}' so they land in different waves"
          fi
        fi
        j=$((j + 1))
      done
    fi
    i=$((i + 1))
  done
  w=$((w + 1))
done

# ---------- ## Review focus ----------
# Up to 5 lines "<input class> — T###[, T###]"; every id must be a task here.
FOCUS_MAX=5
if [ "${#FOCUS_LINES[@]}" -gt "$FOCUS_MAX" ]; then
  add_err "${FOCUS_LNS[$FOCUS_MAX]}" "" "review-focus-too-many" "## Review focus has ${#FOCUS_LINES[@]} lines (max $FOCUS_MAX)" "keep the $FOCUS_MAX input classes that matter most; the rest are covered by the generic review lenses"
fi
fi_i=0
while [ "$fi_i" -lt "${#FOCUS_LINES[@]}" ]; do
  fl=${FOCUS_LINES[$fi_i]}
  fl=${fl#- }
  case "$fl" in
  *"$EMD"*)
    for fid in ${fl##*"$EMD"}; do
      fid=${fid//,/}
      [ -z "$fid" ] && continue
      idx_of "$fid" || add_err "${FOCUS_LNS[$fi_i]}" "$fid" "review-focus-unknown-id" "## Review focus names $fid, which is not a task in this file" "fix the id, or add the task"
    done
    ;;
  esac
  fi_i=$((fi_i + 1))
done

# ---------- Behaviors coverage by spec id ----------
# Applies when Spec: names a file beside TASKS.md that numbers FR-NN rows, and
# the feature is unapproved or approved on/after BEHAVIORS_FROM.
spec_path=""
if [ -n "$H_SPEC" ]; then
  sp_name=${H_SPEC%% *}
  spec_path="$(dirname "$FILE")/$sp_name"
fi
beh_apply=1
case "$H_APPROVED" in
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*)
  [[ "${H_APPROVED:0:10}" < "$BEHAVIORS_FROM" ]] && beh_apply=0
  ;;
esac
if [ "$beh_apply" -eq 1 ] && [ -n "$spec_path" ] && [ -f "$spec_path" ]; then
  SPEC_FRS=" "
  sp_fence=0
  while IFS= read -r sl || [ -n "$sl" ]; do
    sl=${sl%$'\r'}
    lstrip_var "$sl"
    case "$R_TRIM" in
    '```'* | '~~~'*) sp_fence=$((1 - sp_fence)); continue ;;
    esac
    [ "$sp_fence" -eq 1 ] && continue
    case "$R_TRIM" in
    '|'*)
      IFS='|' read -r -a sp_cells <<<"$R_TRIM"
      trim_var "${sp_cells[1]:-}"
      case "$R_TRIM" in
      FR-[0-9]*) SPEC_FRS="$SPEC_FRS${R_TRIM%% *} " ;;
      esac
      ;;
    esac
  done <"$spec_path"
  # a table that cites no FR-NN at all is a legacy (B1, B2) table, not coverage
  beh_cites_fr=0
  for br_row in "${BEH_ROWS[@]}"; do
    IFS='|' read -r -a br_c <<<"$br_row"
    trim_var "${br_c[1]:-}"
    case "$R_TRIM" in *FR-[0-9]*) beh_cites_fr=1 ;; esac
  done
  if [ "$SPEC_FRS" != " " ] && [ "$beh_cites_fr" -eq 1 ]; then
    CITED=" "
    br_i=0
    while [ "$br_i" -lt "${#BEH_ROWS[@]}" ]; do
      IFS='|' read -r -a br_cells <<<"${BEH_ROWS[$br_i]}"
      trim_var "${br_cells[1]:-}"
      br_id=$R_TRIM
      # header row: the row just before the separator
      if [ "$br_i" -eq 0 ] && [ "${#BEH_ROWS[@]}" -gt 1 ] && [ -z "${BEH_ROWS[1]//[-:| ]/}" ]; then br_i=$((br_i + 1)); continue; fi
      case "$br_id" in
      ID) br_i=$((br_i + 1)); continue ;;
      esac
      # separator row: nothing but '-', ':', '|' and spaces
      br_sep=${BEH_ROWS[$br_i]//[-:| ]/}
      if [ -z "$br_sep" ]; then br_i=$((br_i + 1)); continue; fi
      br_ln=${BEH_LINES[$br_i]}
      # id cell: drop "(P0)" and punctuation, each remaining word is a cited id
      br_id=${br_id//(/ (}
      br_cited=""
      for br_w in ${br_id//,/ }; do
        case "$br_w" in '('*) continue ;; esac
        br_w=${br_w%:}
        [ -z "$br_w" ] && continue
        br_cited="$br_cited $br_w"
        CITED="$CITED$br_w "
        case "$SPEC_FRS" in
        *" $br_w "*) ;;
        *) add_err "$br_ln" "$br_w" "behaviors-unknown-id" "Behaviors row cites $br_w, which $sp_name does not number" "use the spec's own id (FR-NN) in the row, or add the requirement to the spec" ;;
        esac
      done
      br_has_task=0
      for br_t in ${br_cells[3]:-}; do
        br_t=${br_t//,/}
        case "$br_t" in
        T[0-9][0-9][0-9] | CHK[0-9][0-9][0-9]) idx_of "$br_t" && br_has_task=1 ;;
        esac
      done
      [ "$br_has_task" -eq 0 ] && add_err "$br_ln" "${br_cited# }" "behaviors-no-task" "Behaviors row${br_cited:+ for$br_cited} names no existing T### or CHK### in its Task cell" "put the task (or checkpoint) that proves this row in the Task cell"
      br_i=$((br_i + 1))
    done
    for fr in $SPEC_FRS; do
      case "$CITED" in
      *" $fr "*) ;;
      *) add_err 0 "$fr" "behaviors-missing-id" "$sp_name has $fr, but no ## Behaviors row cites it" "add a Behaviors row that opens with $fr, or remove the row from the spec" ;;
      esac
    done
  fi
fi

# ---------- git joins ----------
GIT_OK=0
if [ -n "$TOPLEVEL" ] && git rev-parse --verify -q HEAD >/dev/null 2>&1; then GIT_OK=1; fi

if [ "$GIT_OK" -eq 1 ] && [ -n "$H_BASE" ]; then
  if ! git rev-parse --verify -q "$H_BASE^{commit}" >/dev/null 2>&1; then
    add_warn 0 "" "base-unknown" "Base: $H_BASE is not a commit in this repo; skipping the done:-sha checks"
  else
    i=0
    while [ "$i" -lt "$N" ]; do
      sha=${T_DONE[$i]}
      if [ "${T_STATE[$i]}" = 'x' ] && [ -n "$sha" ]; then
        id=${T_ID[$i]}
        ln=${T_LINE[$i]}
        if ! git rev-parse --verify -q "$sha^{commit}" >/dev/null 2>&1; then
          add_err "$ln" "$id" "done-sha-unknown" "TASKS.md claims $id done at $sha — no such commit in this repo" "uncheck $id and re-run it, or correct the sha to a real commit"
        elif ! git merge-base --is-ancestor "$sha" HEAD >/dev/null 2>&1; then
          add_err "$ln" "$id" "done-sha-unreachable" "TASKS.md claims $id done at $sha — not on this branch" "uncheck $id and run it here, or check out the branch that has $sha"
        elif git merge-base --is-ancestor "$sha" "$H_BASE" >/dev/null 2>&1; then
          add_err "$ln" "$id" "done-sha-before-base" "TASKS.md claims $id done at $sha, which is at or before Base: $H_BASE" "uncheck $id — nothing was committed for it since Base"
        else
          hit=0
          # a by-user T whose files: are all untracked at HEAD lives outside
          # this repo (stealth store, another repo) — nothing here to join.
          ext=0
          if [ "${T_BYUSER[$i]}" = 1 ] && [ "${id#T}" != "$id" ]; then
            ext=1
            for p in ${T_FILES[$i]//,/ }; do
              trim_var "$p"
              [ -z "$R_TRIM" ] && continue
              if [ -n "$(git -C "$TOPLEVEL" ls-tree -r --name-only HEAD -- "$R_TRIM" 2>/dev/null)" ]; then ext=0; break; fi
            done
          fi
          [ "$ext" -eq 1 ] && hit=1
          for p in ${T_FILES[$i]//,/ }; do
            [ "$hit" -eq 1 ] && break
            trim_var "$p"
            p=$R_TRIM
            [ -z "$p" ] && continue
            # pathspec, not exact-line match: matches like `flow tick`'s
            # `git log -- <files>` join, so `.` and a directory entry catch
            # any path underneath, evaluated from the repo top so a lint run
            # from a subdirectory doesn't narrow `.` to that subdirectory.
            if [ -n "$(git -C "$TOPLEVEL" show --name-only --format= "$sha" -- "$p" 2>/dev/null)" ]; then
              hit=1
              break
            fi
          done
          trim_var "${T_FILES[$i]}"
          if [ -z "$R_TRIM" ]; then
            # Gates (G###) never declare files: — they assert a repo-wide
            # property, not an owned path — so the missing join is by design.
            case "$id" in
            G*) : ;;
            *) add_warn "$ln" "$id" "done-no-files" "$id is done at $sha but declares no files:, so the join cannot be checked" ;;
            esac
          elif [ "$hit" -eq 0 ]; then
            add_err "$ln" "$id" "done-touches-nothing" "$id claims $sha, but that commit touched none of ${T_FILES[$i]}" "uncheck $id and re-tick it against the commit that changed its files: (flow tick $id --sha <sha>), or fix files:"
          elif [ "$ext" -eq 0 ]; then
            for p in ${T_FILES[$i]//,/ }; do
              trim_var "$p"
              p=$R_TRIM
              [ -z "$p" ] && continue
              if [ -z "$(git -C "$TOPLEVEL" show --name-only --format= "$sha" -- "$p" 2>/dev/null)" ]; then
                add_warn "$ln" "$id" "files-untouched" "$id lists $p in files:, but its done: commit $sha did not change it" "drop $p from files:, or land the missing change before ticking $id"
              fi
            done
          fi
        fi
      fi
      i=$((i + 1))
    done
  fi
fi

# ---------- ID-vanish diff against HEAD: ----------
# In stealth, $FILE physically lives in another git repo (the store): the
# check must join against that repo's HEAD, not the target's.
check_vanished_ids() { # gitdir rel
  local gitdir=$1 relp=$2 old_ids oid
  git -C "$gitdir" rev-parse --verify -q HEAD >/dev/null 2>&1 || return 0
  git -C "$gitdir" cat-file -e "HEAD:$relp" 2>/dev/null || return 0
  # fence-aware on the HEAD side too: a fenced example in the committed
  # file was never a task, so its disappearance is not a deletion.
  old_ids=$(git -C "$gitdir" show "HEAD:$relp" 2>/dev/null | awk '
    BEGIN { fence = 0 }
    { line = $0; sub(/\r$/, "", line); sub(/^[ \t]+/, "", line) }
    line ~ /^```/ || line ~ /^~~~/ { fence = !fence; next }
    fence { next }
    line ~ /^- \[[ x~]\] / {
      sub(/^- \[[ x~]\][ \t]*/, "", line)
      split(line, w, " ")
      print w[1]
    }')
  for oid in $old_ids; do
    case "$oid" in
    T[0-9][0-9][0-9] | CHK[0-9][0-9][0-9] | G[0-9][0-9][0-9]) ;;
    *) continue ;;
    esac
    if ! idx_of "$oid"; then
      add_err 0 "$oid" "id-vanished" "$oid was in $relp at HEAD and is gone from the working copy" "TASKS.md is append-only: restore $oid and mark it '- [~] $oid … — dropped: <reason>' instead of deleting it"
    fi
  done
}

FILE_PHYSDIR=$(cd "$(dirname "$FILE")" 2>/dev/null && pwd -P || true)
FILE_TOP=""
[ -n "$FILE_PHYSDIR" ] && FILE_TOP=$(git -C "$FILE_PHYSDIR" rev-parse --show-toplevel 2>/dev/null || true)

if [ -n "$FILE_TOP" ] && [ "$FILE_TOP" != "$TOPLEVEL" ]; then
  # stealth: FILE's physical directory is outside the target repo.
  reldir=${FILE_PHYSDIR#"$FILE_TOP"/}
  [ "$reldir" = "$FILE_PHYSDIR" ] && reldir=""
  rel="${reldir:+$reldir/}${FILE##*/}"
  check_vanished_ids "$FILE_TOP" "$rel"
elif [ "$GIT_OK" -eq 1 ]; then
  rel=${FILE#"$TOPLEVEL"/}
  case "$rel" in
  /*) rel="" ;;
  esac
  [ -n "$rel" ] && check_vanished_ids "$TOPLEVEL" "$rel"
fi

# ---------- header rules ----------
case "$H_ROUTE" in
bounded | oneshot | dispatch) ;;
"") add_warn 0 "" "no-route" "no Route: in the header" "add 'Route: bounded|oneshot|dispatch' to the header line" ;;
*) add_err 0 "" "bad-route" "Route: \"$H_ROUTE\" is not one of bounded, oneshot, dispatch" "set Route: to bounded, oneshot or dispatch" ;;
esac
[ -z "$H_BASE" ] && add_warn 0 "" "no-base" "no Base: sha in the header" "add 'Base: $(git rev-parse --short HEAD 2>/dev/null || echo '<sha>')' so done: shas can be checked"

if [ -n "$H_PARITY" ]; then
  par_ok=0
  i=0
  while [ "$i" -lt "$N" ]; do
    case "${T_VERIFY[$i]}" in *verify/parity-redcheck.txt*) par_ok=1 ;; esac
    i=$((i + 1))
  done
  [ "$par_ok" -eq 0 ] && add_warn 0 "" "parity-no-redcheck" "Parity: is declared but no task's verify: names verify/parity-redcheck.txt" "have T000 write verify/parity-redcheck.txt (alter one character of the raw output before the filter, re-diff, record the non-zero exit) and name it in its verify:"
fi

# Marker-vs-disk: the header says one thing, the files beside it say another.
# Spared for a feature approved before MARKERS_FROM so in-flight ones do not flip.
mk_apply=1
case "$H_APPROVED" in
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*)
  [[ "${H_APPROVED:0:10}" < "$MARKERS_FROM" ]] && mk_apply=0
  ;;
esac
if [ "$mk_apply" -eq 1 ]; then
  mk_dir=$(dirname "$FILE")
  mk_design=${H_DESIGN%% *}
  case "$mk_design" in
  "" | none | None | NONE | -)
    [ -f "$mk_dir/design.md" ] && add_err 0 "" "design-marker" "Design: is ${mk_design:-absent} but design.md sits beside TASKS.md" "set the header to 'Design: design.md' so the contract is read, or delete design.md if it is stale"
    ;;
  *)
    case "$mk_design" in
    /*) mk_dp=$mk_design ;;
    *) mk_dp="$mk_dir/$mk_design" ;;
    esac
    if [ ! -e "$mk_dp" ] && { [ -z "$TOPLEVEL" ] || [ ! -e "$TOPLEVEL/$mk_design" ]; }; then
      add_err 0 "" "design-marker" "Design: names $mk_design, which does not exist" "write that file, point Design: at the real design file, or write 'Design: none'"
    fi
    ;;
  esac
  if [ -n "$spec_path" ] && [ -f "$spec_path" ] && grep -Eiq '^[[:space:]]*([-*][[:space:]]+)?\*\*Behaviou?r-preserving\*\*:[[:space:]]*yes' "$spec_path"; then
    if [ -z "$H_PARITY" ]; then
      add_err 0 "" "parity-marker" "$sp_name says Behaviour-preserving: yes, but the header has no Parity:" "add '· Parity: <cmd>' (a command whose output is the behaviour) to the header, or change the spec if behaviour is allowed to change"
    fi
    mk_t000=0
    mk_i=0
    while [ "$mk_i" -lt "$N" ]; do
      [ "${T_ID[$mk_i]}" = T000 ] && mk_t000=1
      mk_i=$((mk_i + 1))
    done
    if [ "$mk_t000" -eq 0 ]; then
      add_err 0 "" "parity-marker" "$sp_name says Behaviour-preserving: yes, but there is no task T000 to record the baseline" "add T000 first: it runs the Parity: command at Base into verify/baseline.txt before any other task commits"
    fi
  fi
fi

# ---------- rules for plans dated on/after NEW_RULES_FROM ----------
# nr_date: the Approved: date; empty while the plan is unapproved, which exempts
# it (a Base commit date would flip the verdict the moment the plan is approved,
# and would date fixtures by a commit made at run time).
nr_date=""
case "$H_APPROVED" in
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*) nr_date=${H_APPROVED:0:10} ;;
esac
nr_apply=0
if [ -n "$nr_date" ] && [[ ! "$nr_date" < "$NEW_RULES_FROM" ]]; then nr_apply=1; fi

# fr_rows (stdin: spec.md text) -> "FR-NN<TAB>normalised row" per FR table row
fr_rows() {
  awk '
    BEGIN { fence = 0 }
    { line = $0; sub(/\r$/, "", line); t = line; sub(/^[ \t]+/, "", t) }
    t ~ /^```/ || t ~ /^~~~/ { fence = !fence; next }
    fence { next }
    t ~ /^\|[ \t]*FR-[0-9]+/ {
      id = t; sub(/^\|[ \t]*/, "", id); sub(/[^A-Za-z0-9-].*$/, "", id)
      gsub(/[ \t]+/, " ", t); sub(/ \|$/, "|", t)
      print id "\t" t
    }'
}

# check_spec_criteria <gitdir> <rel> — compare the Spec: file's FR rows with
# the baseline: the file at Base, else at the first commit that added it after
# Base (a stealth store does not hold Base, so its first commit stands in).
check_spec_criteria() {
  local gitdir=$1 relp=$2 sc_commit="" sc_base_ok=0 sc_old sc_new sc_date sc_id sc_oldrow sc_newrow sc_notes
  [ -n "$H_BASE" ] && git -C "$gitdir" rev-parse --verify -q "$H_BASE^{commit}" >/dev/null 2>&1 && sc_base_ok=1
  if [ "$sc_base_ok" -eq 1 ] && git -C "$gitdir" cat-file -e "$H_BASE:$relp" 2>/dev/null; then
    sc_commit=$H_BASE
  else
    sc_commit=$(git -C "$gitdir" log --diff-filter=A --format=%H --reverse -- "$relp" 2>/dev/null | sed -n 1p)
    [ -n "$sc_commit" ] || return 0
    if [ "$sc_base_ok" -eq 1 ] && ! git -C "$gitdir" merge-base --is-ancestor "$H_BASE" "$sc_commit" 2>/dev/null; then
      return 0
    fi
  fi
  sc_oldtext=$(git -C "$gitdir" show "$sc_commit:$relp" 2>/dev/null || true)
  sc_old=$(printf '%s\n' "$sc_oldtext" | fr_rows)
  [ -n "$sc_old" ] || return 0
  sc_new=$(fr_rows <"$spec_path")
  sc_date=$(git -C "$gitdir" show -s --format=%cs "$sc_commit" 2>/dev/null || true)
  sc_notes="$(dirname "$FILE")/NOTES.md"
  while IFS=$'\t' read -r sc_id sc_oldrow; do
    [ -n "$sc_id" ] || continue
    sc_newrow=$(printf '%s\n' "$sc_new" | awk -F'\t' -v id="$sc_id" '$1 == id { print $2; exit }')
    [ "$sc_newrow" = "$sc_oldrow" ] && continue
    if [ -n "$sc_date" ] && grep -E '^##[[:space:]]+Amendment[[:space:]]+[0-9]{4}-[0-9]{2}-[0-9]{2}' "$spec_path" 2>/dev/null |
      grep -vxFf <(printf '%s\n' "$sc_oldtext") |
      awk -v d="$sc_date" '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ && substr($i, 1, 10) >= d) ok = 1 } END { exit ok ? 0 : 1 }'; then
      continue
    fi
    if [ -f "$sc_notes" ] && grep -Eq "Ruling:.*$sc_id([^0-9]|\$)" "$sc_notes"; then continue; fi
    if [ -z "$sc_newrow" ]; then
      add_err 0 "$sc_id" "spec-criterion-changed" "$sc_id was in $sp_name at its baseline commit and is gone from the working copy" "restore the row, or record the change: /flow:spec --amend (appends ## Amendment <date>), or a NOTES.md 'Ruling:' naming $sc_id"
    else
      add_err 0 "$sc_id" "spec-criterion-changed" "$sc_id was reworded in $sp_name since its baseline commit" "restore the row, or record the change: /flow:spec --amend (appends ## Amendment <date>), or a NOTES.md 'Ruling:' naming $sc_id"
    fi
  done <<<"$sc_old"
}

if [ "$nr_apply" -eq 1 ]; then
  case "$H_TEST" in
  "" | none | None | NONE | -) ;;
  *)
    nr_t000=0
    nr_i=0
    while [ "$nr_i" -lt "$N" ]; do
      [ "${T_ID[$nr_i]}" = T000 ] && nr_t000=1
      nr_i=$((nr_i + 1))
    done
    if [ "$nr_t000" -eq 0 ]; then
      add_err 0 "" "baseline-missing" "Test: is set but no task T000 records the suite at Base" "add T000 first: it runs the Test: command at Base into verify/baseline-tests.txt (exit code plus failing test names); with Parity: the same T000 also writes verify/baseline.txt"
    fi
    ;;
  esac
  if [ -n "$spec_path" ] && [ -f "$spec_path" ]; then
    if grep -Eq '\[NEEDS CLARIFICATION[^]]*blocks:[[:space:]]*tasks' "$spec_path"; then
      add_err 0 "" "open-question-blocks-tasks" "$sp_name has an open question marked blocks: tasks" "answer it via /flow:spec --amend, then remove the marker"
    fi
    if [ "$GIT_OK" -eq 1 ]; then
      sc_phys=$(cd "$(dirname "$spec_path")" 2>/dev/null && pwd -P || true)
      sc_top=""
      [ -n "$sc_phys" ] && sc_top=$(git -C "$sc_phys" rev-parse --show-toplevel 2>/dev/null || true)
      if [ -n "$sc_top" ]; then
        sc_rel="${sc_phys#"$sc_top"}"
        sc_rel="${sc_rel#/}"
        sc_rel="${sc_rel:+$sc_rel/}${sp_name##*/}"
        check_spec_criteria "$sc_top" "$sc_rel"
      fi
    fi
  fi
fi

NTASK=0
i=0
while [ "$i" -lt "$N" ]; do
  [ "${T_KIND[$i]}" = task ] && NTASK=$((NTASK + 1))
  i=$((i + 1))
done
if [ "$H_ROUTE" = oneshot ] && [ "$NTASK" -gt 5 ]; then
  add_info 0 "" "oneshot-too-big" "Route: oneshot with $NTASK tasks (>5)" "run /flow:next --escalate to move this feature to dispatch"
fi

# ---------- output ----------
wave_ids() { # w -> "T002 T003"
  local w=$1 i=0 out=""
  while [ "$i" -lt "$N" ]; do
    [ "${WAVE[$i]}" -eq "$w" ] && out="$out${out:+ }${T_ID[$i]}"
    i=$((i + 1))
  done
  printf '%s' "$out"
}

if [ "$JSON" -eq 1 ]; then
  wj=""
  w=0
  while [ "$w" -le "$MAXW" ]; do
    ids=$(wave_ids "$w")
    if [ -n "$ids" ]; then
      inner=""
      for wid in $ids; do inner="$inner${inner:+,}$(jstr "$wid")"; done
      wj="$wj${wj:+,}[$inner]"
    fi
    w=$((w + 1))
  done

  tj=""
  i=0
  while [ "$i" -lt "$N" ]; do
    case "${T_STATE[$i]}" in
    x) sname="done" ;;
    '~') sname="dropped" ;;
    *) sname="open" ;;
    esac
    pbool=false
    [ "${T_PAR[$i]}" -eq 1 ] && pbool=true
    wv=${WAVE[$i]}
    [ "$wv" -lt 0 ] && wv=null
    jstr_var "${T_ID[$i]}"
    j_id=$R_JS
    jstr_var "$sname"
    j_state=$R_JS
    jstr_var "${T_KIND[$i]}"
    j_kind=$R_JS
    jstr_var "${T_VERIFY[$i]}"
    j_verify=$R_JS
    jstr_var "${T_NOCLAIM[$i]}"
    j_noclaim=$R_JS
    jstr_var "${T_DONE[$i]}"
    j_done=$R_JS
    jstr_var "${T_DROPPED[$i]}"
    j_dropped=$R_JS
    jstr_var "${T_PHASE[$i]}"
    j_phase=$R_JS
    jstr_var "${T_DESC[$i]}"
    j_desc=$R_JS
    tj="$tj${tj:+,}{\"id\":$j_id,\"state\":$j_state,\"kind\":$j_kind,\"parallel\":$pbool,\"wave\":$wv,\"files\":$(jlist "${T_FILES[$i]}"),\"verify\":$j_verify,\"no_claim\":$j_noclaim,\"after\":$(jlist "${T_AFTER[$i]}"),\"done\":$j_done,\"dropped\":$j_dropped,\"phase\":$j_phase,\"line\":${T_LINE[$i]},\"description\":$j_desc}"
    i=$((i + 1))
  done

  okv=true
  [ "$ERRN" -gt 0 ] && okv=false
  printf '{"ok":%s,"file":%s,"errors":[%s],"warnings":[%s],"info":[%s],"waves":[%s],"tasks":[%s],"header":{"title":%s,"spec":%s,"design":%s,"base":%s,"route":%s,"test":%s,"approved":%s,"verified":%s}}\n' \
    "$okv" "$(jstr "$FILE")" "$ERRJ" "$WARNJ" "$INFOJ" "$wj" "$tj" \
    "$(jstr "$H_TITLE")" "$(jstr "$H_SPEC")" "$(jstr "$H_DESIGN")" "$(jstr "$H_BASE")" \
    "$(jstr "$H_ROUTE")" "$(jstr "$H_TEST")" "$(jstr "$H_APPROVED")" "$(jstr "$H_VERIFIED")"
elif [ "$WAVES" -eq 1 ]; then
  w=0
  while [ "$w" -le "$MAXW" ]; do
    ids=$(wave_ids "$w")
    [ -n "$ids" ] && printf 'wave %s: %s\n' "$w" "$ids"
    w=$((w + 1))
  done
  [ -n "$ERRT" ] && printf '%s' "$ERRT"
else
  [ -n "$ERRT" ] && printf '%s' "$ERRT"
  [ -n "$WARNT" ] && printf '%s' "$WARNT"
  [ -n "$INFOT" ] && printf '%s' "$INFOT"
  if [ "$ERRN" -eq 0 ] && [ "$WARNN" -eq 0 ] && [ "$INFON" -eq 0 ]; then
    printf 'OK %s — %s tasks, %s waves\n' "${FILE##*/}" "$NTASK" "$((MAXW + 1))"
  elif [ "$ERRN" -eq 0 ]; then
    printf 'OK %s — %s tasks, %s waves (%s warnings, %s info)\n' "${FILE##*/}" "$NTASK" "$((MAXW + 1))" "$WARNN" "$INFON"
  fi
fi

[ "$ERRN" -gt 0 ] && exit 1
exit 0
