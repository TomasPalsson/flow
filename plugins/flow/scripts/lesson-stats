#!/usr/bin/env bash
# lesson-stats — read PROGRESS.md's "## Rulings" and lesson-fires.log to
# report whether each ruling's guard is actually catching recurrences, has
# escaped, or is unmeasured. Bash 3.2 compatible; see --help.
set -u

usage() {
  cat <<'HELP'
Usage: lesson-stats [--dir <project>] [--file <PROGRESS.md>] [--log <lesson-fires.log>] [--now <YYYY-MM-DD>] [--prune-days <days, default 30>] [--json]

<project> defaults to the current directory's git toplevel, else the
current directory (pwd -P). <PROGRESS.md> defaults to PROGRESS.md and
<lesson-fires.log> to .claude/lesson-fires.log, both under <project>
unless given as an absolute path.

Reads the "## Rulings" section of <file> and <log> and prints one row per
ruling, in file order, then one row per orphan fire (a fire whose
(date, what) pair matches no ruling), grouped by date and what, in
first-seen order:

  date  rung  caught  last  escaped  verdict  what

caught is the number of matching lesson-fires.log lines; last is days
since the most recent one, relative to --now (default: today); escaped
counts later rulings with the same what; verdict is one of unmeasured,
escaped, held, prune?, young (or orphan, for an unmatched fire). Missing
values print as "-" in the default tab-separated output, or as null with
--json (a JSON array of objects, numbers unquoted, keys in the order
date, rung, caught, last, escaped, verdict, what). Malformed
lesson-fires.log lines are skipped and counted in a single warning on
stderr. --help prints this text.

Exit codes: 0 printed · 2 usage, a malformed --now, or no PROGRESS.md
HELP
}

DIR=""
FILE="PROGRESS.md"
LOG=".claude/lesson-fires.log"
NOW=""
PRUNE_DAYS="30"
AS_JSON=0

while [ $# -gt 0 ]; do
  case "$1" in
  --help | -h) usage; exit 0 ;;
  --dir) DIR=${2:-}; shift 2 ;;
  --file) FILE=${2:-}; shift 2 ;;
  --log) LOG=${2:-}; shift 2 ;;
  --now) NOW=${2:-}; shift 2 ;;
  --prune-days) PRUNE_DAYS=${2:-}; shift 2 ;;
  --json) AS_JSON=1; shift ;;
  *) printf 'lesson-stats: unknown argument %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

[ -n "$DIR" ] || DIR=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)

[ -n "$NOW" ] || NOW=$(date -u +%Y-%m-%d)
case "$NOW" in
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
*) printf 'lesson-stats: --now must be YYYY-MM-DD\n' >&2; usage >&2; exit 2 ;;
esac
case "$PRUNE_DAYS" in
'' | *[!0-9]*) printf 'lesson-stats: --prune-days must be a non-negative integer\n' >&2; usage >&2; exit 2 ;;
esac

case "$FILE" in
/*) PROGRESS_PATH="$FILE" ;;
*) PROGRESS_PATH="$DIR/$FILE" ;;
esac
case "$LOG" in
/*) FIRE_PATH="$LOG" ;;
*) FIRE_PATH="$DIR/$LOG" ;;
esac
[ -f "$PROGRESS_PATH" ] || { printf 'lesson-stats: no PROGRESS.md in %s\n' "$DIR" >&2; exit 2; }

AWK_FILES=("$PROGRESS_PATH")
[ -f "$FIRE_PATH" ] && AWK_FILES+=("$FIRE_PATH")

awk -v now="$NOW" -v prune="$PRUNE_DAYS" -v as_json="$AS_JSON" \
  -v progress_path="$PROGRESS_PATH" -v fire_path="$FIRE_PATH" -F'\t' '
# Julian day number of a Gregorian year/month/day (Fliegel & Van Flandern), integer-only.
function jdn(year, month, day,    century_adjustment, adjusted_year, adjusted_month) {
  century_adjustment = int((14 - month) / 12)
  adjusted_year = year + 4800 - century_adjustment
  adjusted_month = month + 12 * century_adjustment - 3
  return day + int((153 * adjusted_month + 2) / 5) + 365 * adjusted_year + int(adjusted_year / 4) - int(adjusted_year / 100) + int(adjusted_year / 400) - 32045
}
function jdn_of_date(s,    date_parts) {
  split(s, date_parts, "-")
  return jdn(date_parts[1] + 0, date_parts[2] + 0, date_parts[3] + 0)
}
function days_since(s) {
  return jdn_of_date(now) - jdn_of_date(s)
}
function json_escape(s) {
  gsub(/\\/, "\\\\", s)
  gsub(/"/, "\\\"", s)
  return s
}
function json_string(s) {
  return (s == "") ? "null" : "\"" s "\""
}
FILENAME == progress_path {
  raw = $0
  trimmed = raw
  sub(/^[ \t]*/, "", trimmed)
  if (trimmed ~ /^(```|~~~)/) { fence = !fence; next }
  if (fence) { next }
  if (trimmed ~ /^## Rulings/) { in_rulings = 1; next }
  if (in_rulings && trimmed ~ /^## /) { in_rulings = 0; next }
  if (in_rulings && trimmed ~ /^- Ruling: /) {
    line = raw
    sub(/^[ \t]*- Ruling: /, "", line)
    field_count = split(line, parts, " — ")
    if (field_count < 3) next
    what = parts[1]
    cost = parts[field_count]
    mechanism = parts[2]
    for (field_idx = 3; field_idx < field_count; field_idx++) mechanism = mechanism " — " parts[field_idx]
    ruling_date = ""
    if (match(cost, / \([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\)$/)) {
      ruling_date = substr(cost, RSTART + 2, RLENGTH - 3)
    }
    split(mechanism, mechanism_tokens, " ")
    ruling_count++
    r_what[ruling_count] = what
    r_date[ruling_count] = ruling_date
    r_rung[ruling_count] = tolower(mechanism_tokens[1])
  }
  next
}
FILENAME == fire_path {
  field_count = split($0, fire_fields, "\t")
  if (field_count != 4 || fire_fields[1] !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ || fire_fields[2] == "" || fire_fields[3] == "" || fire_fields[4] == "") {
    malformed++
    next
  }
  fire_count++
  fi_date[fire_count] = fire_fields[1]
  fi_what[fire_count] = fire_fields[2]
  fi_tsdate[fire_count] = substr(fire_fields[3], 1, 10)
  next
}
END {
  for (i = 1; i <= ruling_count; i++) {
    escape_count = 0
    for (j = i + 1; j <= ruling_count; j++) if (r_what[j] == r_what[i]) escape_count++
    r_escaped[i] = escape_count
  }
  for (i = 1; i <= ruling_count; i++) {
    match_count = 0; latest_fire_date = ""
    for (k = 1; k <= fire_count; k++) {
      if (fi_what[k] != r_what[i]) continue
      if (fi_date[k] != r_date[i]) continue
      match_count++
      fi_matched[k] = 1
      if (latest_fire_date == "" || jdn_of_date(fi_tsdate[k]) > jdn_of_date(latest_fire_date)) latest_fire_date = fi_tsdate[k]
    }
    r_caught[i] = match_count
    if (match_count > 0) r_last[i] = days_since(latest_fire_date)
  }
  orphan_group_count = 0
  for (k = 1; k <= fire_count; k++) {
    if (fi_matched[k]) continue
    key = fi_date[k] SUBSEP fi_what[k]
    if (!(key in group_index)) {
      orphan_group_count++
      group_index[key] = orphan_group_count
      g_date[orphan_group_count] = fi_date[k]
      g_what[orphan_group_count] = fi_what[k]
      g_count[orphan_group_count] = 0
      g_best[orphan_group_count] = ""
    }
    group_idx = group_index[key]
    g_count[group_idx]++
    if (g_best[group_idx] == "" || jdn_of_date(fi_tsdate[k]) > jdn_of_date(g_best[group_idx])) g_best[group_idx] = fi_tsdate[k]
  }
  for (i = 1; i <= ruling_count; i++) {
    if (r_date[i] == "" || (r_rung[i] != "hook" && r_rung[i] != "lint")) {
      r_verdict[i] = "unmeasured"
    } else if (r_escaped[i] > 0) {
      r_verdict[i] = "escaped"
    } else if (r_caught[i] > 0) {
      r_verdict[i] = "held"
    } else if (days_since(r_date[i]) >= prune + 0) {
      r_verdict[i] = "prune?"
    } else {
      r_verdict[i] = "young"
    }
  }
  total_rows = ruling_count + orphan_group_count
  if (as_json == 1) {
    printf "[\n"
    row_index = 0
    for (i = 1; i <= ruling_count; i++) {
      row_index++
      last_field = (r_caught[i] > 0) ? r_last[i] : "null"
      printf "  {\"date\": %s, \"rung\": \"%s\", \"caught\": %d, \"last\": %s, \"escaped\": %d, \"verdict\": \"%s\", \"what\": \"%s\"}%s\n", \
        json_string(r_date[i]), r_rung[i], r_caught[i], last_field, r_escaped[i], r_verdict[i], json_escape(r_what[i]), (row_index < total_rows ? "," : "")
    }
    for (group_num = 1; group_num <= orphan_group_count; group_num++) {
      row_index++
      last_field = (g_count[group_num] > 0) ? days_since(g_best[group_num]) : "null"
      printf "  {\"date\": \"%s\", \"rung\": null, \"caught\": %d, \"last\": %s, \"escaped\": 0, \"verdict\": \"orphan\", \"what\": \"%s\"}%s\n", \
        g_date[group_num], g_count[group_num], last_field, json_escape(g_what[group_num]), (row_index < total_rows ? "," : "")
    }
    printf "]\n"
  } else {
    printf "date\trung\tcaught\tlast\tescaped\tverdict\twhat\n"
    for (i = 1; i <= ruling_count; i++) {
      date_field = (r_date[i] == "") ? "-" : r_date[i]
      last_field = (r_caught[i] > 0) ? r_last[i] : "-"
      printf "%s\t%s\t%d\t%s\t%d\t%s\t%s\n", date_field, r_rung[i], r_caught[i], last_field, r_escaped[i], r_verdict[i], r_what[i]
    }
    for (group_num = 1; group_num <= orphan_group_count; group_num++) {
      last_field = (g_count[group_num] > 0) ? days_since(g_best[group_num]) : "-"
      printf "%s\t-\t%d\t%s\t0\torphan\t%s\n", g_date[group_num], g_count[group_num], last_field, g_what[group_num]
    }
  }
  if (malformed > 0) print "lesson-stats: skipped " malformed " malformed line(s)" > "/dev/stderr"
}
' "${AWK_FILES[@]}"
