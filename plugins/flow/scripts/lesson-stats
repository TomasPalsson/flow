#!/usr/bin/env bash
# lesson-stats — read PROGRESS.md's "## Rulings" and lesson-fires.log to
# report whether each ruling's guard is actually catching recurrences, has
# escaped, or is unmeasured. Bash 3.2 compatible; see --help.
set -u

usage() {
  cat <<'HELP'
Usage: lesson-stats [--dir <project>] [--file <PROGRESS.md>] [--log <lesson-fires.log>] [--now <YYYY-MM-DD>] [--prune-days <days, default 30>] [--json]

Reads the "## Rulings" section of <dir>/<file> (default ./PROGRESS.md) and
<dir>/<log> (default lesson-fires.log) and prints one row per ruling, in
file order, then one row per orphan fire (a fire whose "what" matches no
ruling), grouped by date and what, in first-seen order:

  date  rung  caught  last  escaped  verdict  what

caught is the number of matching lesson-fires.log lines; last is days
since the most recent one, relative to --now (default: today); escaped
counts later rulings with the same what; verdict is one of unmeasured,
escaped, held, prune?, young (or orphan, for an unmatched fire). Missing
values print as "-" in the default tab-separated output, or as null with
--json (a JSON array of objects, numbers unquoted, keys in the order
date, rung, caught, last, escaped, verdict, what). Malformed
lesson-fires.log lines are skipped and counted in a single warning on
stderr. --help prints this text.

Exit codes: 0 printed · 2 usage, a malformed --now, or no PROGRESS.md
HELP
}

DIR="."
FILE="PROGRESS.md"
LOG="lesson-fires.log"
NOW=""
PRUNE_DAYS="30"
AS_JSON=0

while [ $# -gt 0 ]; do
  case "$1" in
  --help | -h) usage; exit 0 ;;
  --dir) DIR=${2:-}; shift 2 ;;
  --file) FILE=${2:-}; shift 2 ;;
  --log) LOG=${2:-}; shift 2 ;;
  --now) NOW=${2:-}; shift 2 ;;
  --prune-days) PRUNE_DAYS=${2:-}; shift 2 ;;
  --json) AS_JSON=1; shift ;;
  *) printf 'lesson-stats: unknown argument %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

[ -n "$NOW" ] || NOW=$(date +%Y-%m-%d)
case "$NOW" in
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
*) printf 'lesson-stats: --now must be YYYY-MM-DD\n' >&2; usage >&2; exit 2 ;;
esac
case "$PRUNE_DAYS" in
'' | *[!0-9]*) printf 'lesson-stats: --prune-days must be a non-negative integer\n' >&2; usage >&2; exit 2 ;;
esac

PROGRESS_PATH="$DIR/$FILE"
FIRE_PATH="$DIR/$LOG"
[ -f "$PROGRESS_PATH" ] || { printf 'lesson-stats: no PROGRESS.md in %s\n' "$DIR" >&2; exit 2; }

AWK_FILES=("$PROGRESS_PATH")
[ -f "$FIRE_PATH" ] && AWK_FILES+=("$FIRE_PATH")

awk -v now="$NOW" -v prune="$PRUNE_DAYS" -v as_json="$AS_JSON" \
  -v progress_path="$PROGRESS_PATH" -v fire_path="$FIRE_PATH" -F'\t' '
# Julian day number of a Gregorian y/m/d (Fliegel & Van Flandern), integer-only.
function jdn(y, m, d,    a, yy, mm) {
  a = int((14 - m) / 12)
  yy = y + 4800 - a
  mm = m + 12 * a - 3
  return d + int((153 * mm + 2) / 5) + 365 * yy + int(yy / 4) - int(yy / 100) + int(yy / 400) - 32045
}
function jdn_of_date(s,    p) {
  split(s, p, "-")
  return jdn(p[1] + 0, p[2] + 0, p[3] + 0)
}
function days_since(s) {
  return jdn_of_date(now) - jdn_of_date(s)
}
function json_escape(s) {
  gsub(/\\/, "\\\\", s)
  gsub(/"/, "\\\"", s)
  return s
}
function json_string(s) {
  return (s == "") ? "null" : "\"" s "\""
}
FILENAME == progress_path {
  raw = $0
  t = raw
  sub(/^[ \t]*/, "", t)
  if (t ~ /^(```|~~~)/) { fence = !fence; next }
  if (fence) { next }
  if (t ~ /^## Rulings/) { inr = 1; next }
  if (inr && t ~ /^## /) { inr = 0; next }
  if (inr && t ~ /^- Ruling: /) {
    line = raw
    sub(/^[ \t]*- Ruling: /, "", line)
    n = split(line, parts, " — ")
    if (n < 3) next
    what = parts[1]
    cost = parts[n]
    mech = parts[2]
    for (k = 3; k < n; k++) mech = mech " — " parts[k]
    rdate = ""
    if (match(cost, / \([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\)$/)) {
      rdate = substr(cost, RSTART + 2, RLENGTH - 3)
    }
    split(mech, mtok, " ")
    nrul++
    r_what[nrul] = what
    r_date[nrul] = rdate
    r_rung[nrul] = tolower(mtok[1])
  }
  next
}
FILENAME == fire_path {
  n = split($0, ff, "\t")
  if (n != 4 || ff[1] !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ || ff[2] == "" || ff[3] == "" || ff[4] == "") {
    malformed++
    next
  }
  nfire++
  fi_date[nfire] = ff[1]
  fi_what[nfire] = ff[2]
  fi_tsdate[nfire] = substr(ff[3], 1, 10)
  next
}
END {
  for (i = 1; i <= nrul; i++) {
    esc = 0
    for (j = i + 1; j <= nrul; j++) if (r_what[j] == r_what[i]) esc++
    r_escaped[i] = esc
    is_ruling_what[r_what[i]] = 1
  }
  for (i = 1; i <= nrul; i++) {
    cnt = 0; best = ""
    for (k = 1; k <= nfire; k++) {
      if (fi_what[k] != r_what[i]) continue
      cnt++
      if (best == "" || jdn_of_date(fi_tsdate[k]) > jdn_of_date(best)) best = fi_tsdate[k]
    }
    r_caught[i] = cnt
    if (cnt > 0) r_last[i] = days_since(best)
  }
  ngroup = 0
  for (k = 1; k <= nfire; k++) {
    if (is_ruling_what[fi_what[k]]) continue
    key = fi_date[k] SUBSEP fi_what[k]
    if (!(key in group_index)) {
      ngroup++
      group_index[key] = ngroup
      g_date[ngroup] = fi_date[k]
      g_what[ngroup] = fi_what[k]
      g_count[ngroup] = 0
      g_best[ngroup] = ""
    }
    gi = group_index[key]
    g_count[gi]++
    if (g_best[gi] == "" || jdn_of_date(fi_tsdate[k]) > jdn_of_date(g_best[gi])) g_best[gi] = fi_tsdate[k]
  }
  for (i = 1; i <= nrul; i++) {
    if (r_date[i] == "" || (r_rung[i] != "hook" && r_rung[i] != "lint")) {
      r_verdict[i] = "unmeasured"
    } else if (r_escaped[i] > 0) {
      r_verdict[i] = "escaped"
    } else if (r_caught[i] > 0) {
      r_verdict[i] = "held"
    } else if (days_since(r_date[i]) >= prune + 0) {
      r_verdict[i] = "prune?"
    } else {
      r_verdict[i] = "young"
    }
  }
  total = nrul + ngroup
  if (as_json == 1) {
    printf "[\n"
    idx = 0
    for (i = 1; i <= nrul; i++) {
      idx++
      last_field = (r_caught[i] > 0) ? r_last[i] : "null"
      printf "  {\"date\": %s, \"rung\": \"%s\", \"caught\": %d, \"last\": %s, \"escaped\": %d, \"verdict\": \"%s\", \"what\": \"%s\"}%s\n", \
        json_string(r_date[i]), r_rung[i], r_caught[i], last_field, r_escaped[i], r_verdict[i], json_escape(r_what[i]), (idx < total ? "," : "")
    }
    for (g = 1; g <= ngroup; g++) {
      idx++
      last_field = (g_count[g] > 0) ? days_since(g_best[g]) : "null"
      printf "  {\"date\": \"%s\", \"rung\": null, \"caught\": %d, \"last\": %s, \"escaped\": 0, \"verdict\": \"orphan\", \"what\": \"%s\"}%s\n", \
        g_date[g], g_count[g], last_field, json_escape(g_what[g]), (idx < total ? "," : "")
    }
    printf "]\n"
  } else {
    printf "date\trung\tcaught\tlast\tescaped\tverdict\twhat\n"
    for (i = 1; i <= nrul; i++) {
      date_field = (r_date[i] == "") ? "-" : r_date[i]
      last_field = (r_caught[i] > 0) ? r_last[i] : "-"
      printf "%s\t%s\t%d\t%s\t%d\t%s\t%s\n", date_field, r_rung[i], r_caught[i], last_field, r_escaped[i], r_verdict[i], r_what[i]
    }
    for (g = 1; g <= ngroup; g++) {
      last_field = (g_count[g] > 0) ? days_since(g_best[g]) : "-"
      printf "%s\t-\t%d\t%s\t0\torphan\t%s\n", g_date[g], g_count[g], last_field, g_what[g]
    }
  }
  if (malformed > 0) print "lesson-stats: skipped " malformed " malformed line(s)" > "/dev/stderr"
}
' "${AWK_FILES[@]}"
