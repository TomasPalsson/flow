#!/usr/bin/env bash
# lesson-record — append one Ruling to PROGRESS.md's "## Rulings" section
# (created, with the file, when missing). Bash 3.2 compatible; see --help.
set -u

usage() {
  cat <<'HELP'
Usage: lesson-record --what <text> --mechanism <text> --cost <text> [--file <PROGRESS.md>] [--date <YYYY-MM-DD>]

Appends
  - Ruling: <what> — <mechanism> — <cost> (<YYYY-MM-DD>)
under "## Rulings" in <PROGRESS.md> (default ./PROGRESS.md), after the
last ruling of that section (fenced ``` blocks are never headings). The
date defaults to today (UTC) and may be pinned with --date; an existing
undated legacy ruling is never rewritten. Creates the section at the end
when it is missing, and the file from the minimal template when it does
not exist. Refuses an exact duplicate line (exit 3, nothing written); a
ruling with the same <what> but a new mechanism or cost is written and
noted on stderr as superseding. Every write is checked and serialised
through <PROGRESS.md>.lock. Prints the line written, then a second line
`marker: lesson(<YYYY-MM-DD>): <what>` to paste on the rung; when the
file is now over 60 lines, a warning to stderr (exit stays 0).

Exit codes: 0 written · 2 usage or malformed --date · 3 exact duplicate · 4 cannot write
HELP
}

WHAT=""; MECH=""; COST=""; FILE="PROGRESS.md"; DATE=""
while [ $# -gt 0 ]; do
  case "$1" in
  --help | -h) usage; exit 0 ;;
  --what) WHAT=${2:-}; shift 2 ;;
  --mechanism) MECH=${2:-}; shift 2 ;;
  --cost) COST=${2:-}; shift 2 ;;
  --file) FILE=${2:-}; shift 2 ;;
  --date) DATE=${2:-}; shift 2 ;;
  *) printf 'lesson-record: unknown argument %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
if [ -z "$WHAT" ] || [ -z "$MECH" ] || [ -z "$COST" ]; then
  printf 'lesson-record: --what, --mechanism and --cost are all required\n' >&2
  exit 2
fi
case "$WHAT$MECH$COST" in *"
"*) printf 'lesson-record: arguments must be single-line\n' >&2; exit 2 ;; esac

if [ -z "$DATE" ]; then
  DATE=$(date -u +%Y-%m-%d)
else
  case "$DATE" in
  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
  *) printf 'lesson-record: --date must be YYYY-MM-DD\n' >&2; exit 2 ;;
  esac
fi

LINE="- Ruling: $WHAT — $MECH — $COST ($DATE)"

die() { printf 'lesson-record: %s\n' "$1" >&2; exit 4; }

# Serialise concurrent runs (mkdir is atomic on every POSIX filesystem).
LOCK="${FILE}.lock"
_tries=0
until mkdir "$LOCK" 2>/dev/null; do
  _tries=$((_tries + 1))
  [ "$_tries" -ge 40 ] && die "could not take $LOCK after 4s (stale? rmdir it)"
  sleep 0.1
done
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

if [ ! -f "$FILE" ]; then
  cat >"$FILE" <<'TPL' || die "cannot create $FILE"
# Progress

## Now
- (one bullet: what is being worked on right now)

## Next
- (none)

## Done
- (none yet)

## Rulings

## Blocked / open questions
- (none)
TPL
fi

[ -r "$FILE" ] || die "cannot read $FILE"
if grep -F -x -q -- "$LINE" "$FILE"; then
  printf 'lesson-record: this exact ruling is already recorded in %s\n' "$FILE" >&2
  exit 3
fi
if grep -F -q -- "- Ruling: $WHAT — " "$FILE"; then
  printf 'lesson-record: note: an earlier ruling starts with the same text; this one is recorded as superseding it\n' >&2
fi

if ! grep -q '^## Rulings' "$FILE"; then
  printf '\n## Rulings\n' >>"$FILE" || die "cannot write $FILE"
fi

# Insert after the last line of the Rulings section (before the next "## "
# heading), dropping a placeholder bullet if that is all the section holds.
tmp="${FILE}.lesson.$$"
awk -v line="$LINE" '
  BEGIN { inr = 0; done = 0; blanks = 0; fence = 0 }
  function flush() { while (blanks > 0) { print ""; blanks-- } }
  {
    t = $0; sub(/^[ \t]*/, "", t)
    if (t ~ /^(```|~~~)/) { fence = !fence; if (inr) flush(); print; next }
    if (fence) { if (inr) flush(); print; next }
  }
  !inr && /^## Rulings/ && !done { inr = 1; print; next }
  inr && /^## / {
    if (!done) { print line; done = 1 }
    flush()
    inr = 0; print; next
  }
  inr && /^- Ruling: <what was decided>/ { next }
  inr && /^[[:space:]]*$/ { blanks++; next }
  inr { flush(); print; next }
  { print }
  END { if (inr && !done) { print line; done = 1 } flush() }
' "$FILE" >"$tmp" || { rm -f "$tmp"; die "cannot write $tmp"; }
grep -F -x -q -- "$LINE" "$tmp" || { rm -f "$tmp"; die "ruling did not land in $FILE (no writable Rulings section?)"; }
mv "$tmp" "$FILE" || { rm -f "$tmp"; die "cannot replace $FILE"; }

printf '%s\n' "$LINE"
printf 'marker: lesson(%s): %s\n' "$DATE" "$WHAT"
n=$(wc -l <"$FILE" | tr -d ' ')
if [ "$n" -gt 60 ]; then
  printf 'lesson-record: %s is now %s lines (budget 60) — collapse ## Done or ## Next\n' "$FILE" "$n" >&2
fi
exit 0
