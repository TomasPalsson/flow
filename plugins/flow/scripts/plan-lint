#!/usr/bin/env bash
# plan-lint — validate a feature-plan.local.md against the C7 grammar.
#
# Fence-aware: lines inside ``` or ~~~ code fences are never treated as
# headings, bullets, or table rows (matches slice-brief / slice-overlap
# segmentation so all three tools agree on slice boundaries).
set -u

print_help() {
  cat <<'EOF'
Usage: plan-lint <plan-file>

Validates a feature-plan.local.md file against the plan grammar (C7):
  - required top-level headings, in order:
      ## Behavior Inventory
      one or more ## Slice <N> — <title>
      ## Gate Phases
  - the Behavior Inventory section contains a table with the header row
      | Behavior | Slice | Verified by |
    a separator row, and at least one data row
  - every slice has ### Slice <N> — RED / GREEN / REFACTOR sub-headings
  - every "- **Depends-on**: Slice <M>" refers to an existing,
    lower-numbered slice
  - optional "## Discovered" section (C17): only after the last
    ## Slice <N> and before ## Gate Phases; each bullet must read
    "- <what> — discovered in Slice <N> — <defer|fold into Slice M>"
    and name an existing slice. Its absence is never reported.

Lines inside ``` or ~~~ fences are never treated as headings, bullets,
or table rows.

Prints "OK" when the plan is clean, or one MISSING/INVALID line per
problem found. Exit 1 if any problem is found, 0 otherwise.
EOF
}

for a in "$@"; do
  case "$a" in
  --help | -h)
    print_help
    exit 0
    ;;
  esac
done

if [ $# -lt 1 ]; then
  echo "Usage: plan-lint <plan-file>" >&2
  exit 1
fi

plan_file=$1

if [ ! -f "$plan_file" ]; then
  echo "MISSING: file not found: $plan_file"
  exit 1
fi

problems=()

# fence state
in_fence=0
fence_char=""

# heading-order tracking
seq=""
bi_seen=0
gate_seen=0
nslices=0
slice_numbers=()
cur_top_slice=""

# behavior-inventory table state
in_bi=0
bi_header=0
bi_sep=0
bi_row=0

# Discovered section state (C17)
disc_seen=0
in_discovered=0
disc_bullet_idx=0

# per-slice sub-heading / dependency tracking (sparse indexed arrays,
# indexed by normalised slice number — no declare -A needed)
red_seen=()
green_seen=()
refactor_seen=()
dep_list=()

SLICE_HEAD_RE='^## Slice ([0-9]+) — (.*)$'
SUB_RE='^### Slice ([0-9]+) — (RED|GREEN|REFACTOR)[[:space:]]*$'
DEPENDS_RE='^- \*\*Depends-on\*\*: (.*)$'
DEPENDS_ITEM_RE='^[[:space:]]*Slice[[:space:]]+([0-9]+)[[:space:]]*$'
DISCOVERED_BULLET_RE='discovered in Slice ([0-9]+)'

while IFS= read -r line || [ -n "$line" ]; do
  # strip a trailing CR (CRLF files)
  line=${line%$'\r'}

  # left-trim for fence / table checks
  trimmed=$line
  while :; do
    case "$trimmed" in
    ' '*) trimmed=${trimmed# } ;;
    "$(printf '\t')"*) trimmed=${trimmed#"$(printf '\t')"} ;;
    *) break ;;
    esac
  done

  if [ "$in_fence" -eq 1 ]; then
    case "$trimmed" in
    '```'*)
      [ "$fence_char" = '```' ] && { in_fence=0; fence_char=""; }
      ;;
    '~~~'*)
      [ "$fence_char" = '~~~' ] && { in_fence=0; fence_char=""; }
      ;;
    esac
    continue
  fi
  case "$trimmed" in
  '```'*)
    in_fence=1
    fence_char='```'
    continue
    ;;
  '~~~'*)
    in_fence=1
    fence_char='~~~'
    continue
    ;;
  esac

  # ---- top-level headings ----
  if [ "$line" = "## Behavior Inventory" ]; then
    bi_seen=1
    in_bi=1
    in_discovered=0
    seq="$seq BI"
    cur_top_slice=""
    continue
  fi
  if [ "$line" = "## Discovered" ]; then
    disc_seen=1
    in_bi=0
    in_discovered=1
    seq="$seq DISC"
    cur_top_slice=""
    continue
  fi
  if [ "$line" = "## Gate Phases" ]; then
    gate_seen=1
    in_bi=0
    in_discovered=0
    seq="$seq GATE"
    cur_top_slice=""
    continue
  fi
  if [[ $line =~ $SLICE_HEAD_RE ]]; then
    n=${BASH_REMATCH[1]}
    n=$((10#$n))
    in_bi=0
    in_discovered=0
    seq="$seq SLICE"
    nslices=$((nslices + 1))
    slice_numbers+=("$n")
    cur_top_slice=$n
    continue
  fi
  case "$line" in
  '## '*)
    in_bi=0
    in_discovered=0
    cur_top_slice=""
    continue
    ;;
  esac

  # ---- Behavior Inventory table ----
  if [ "$in_bi" -eq 1 ]; then
    if [ "$bi_header" -eq 0 ]; then
      if [ "$trimmed" = "| Behavior | Slice | Verified by |" ]; then
        bi_header=1
      fi
    elif [ "$bi_sep" -eq 0 ]; then
      case "$trimmed" in
      '|'*)
        inner=${trimmed#|}
        case "$inner" in
        *[!\-\|:\ ]*) : ;;
        *) bi_sep=1 ;;
        esac
        ;;
      esac
    else
      case "$trimmed" in
      '|'*'|') bi_row=1 ;;
      esac
    fi
  fi

  # ---- sub-headings ----
  if [[ $line =~ $SUB_RE ]]; then
    sn=${BASH_REMATCH[1]}
    sn=$((10#$sn))
    kind=${BASH_REMATCH[2]}
    if [ "$cur_top_slice" = "$sn" ]; then
      case "$kind" in
      RED) red_seen[sn]=1 ;;
      GREEN) green_seen[sn]=1 ;;
      REFACTOR) refactor_seen[sn]=1 ;;
      esac
    fi
    continue
  fi

  # ---- Depends-on bullet ----
  if [ -n "$cur_top_slice" ] && [[ $line =~ $DEPENDS_RE ]]; then
    rest=${BASH_REMATCH[1]}
    parts=()
    IFS=',' read -ra parts <<<"$rest"
    for part in "${parts[@]}"; do
      if [[ $part =~ $DEPENDS_ITEM_RE ]]; then
        m=${BASH_REMATCH[1]}
        m=$((10#$m))
        dep_list[cur_top_slice]="${dep_list[cur_top_slice]:-} $m"
      fi
    done
  fi

  # ---- Discovered bullet (C17) ----
  if [ "$in_discovered" -eq 1 ]; then
    case "$line" in
    '- '*)
      disc_bullet_idx=$((disc_bullet_idx + 1))
      bullet_ok=0
      if [[ $line =~ $DISCOVERED_BULLET_RE ]]; then
        dn=${BASH_REMATCH[1]}
        dn=$((10#$dn))
        for sn in "${slice_numbers[@]}"; do
          [ "$sn" = "$dn" ] && bullet_ok=1
        done
      fi
      if [ "$bullet_ok" -eq 0 ]; then
        problems+=("INVALID: Discovered bullet $disc_bullet_idx does not name an existing slice")
      fi
      ;;
    esac
  fi
done <"$plan_file"

# ---- required headings ----
[ "$bi_seen" -eq 0 ] && problems+=("MISSING: ## Behavior Inventory heading")
[ "$nslices" -eq 0 ] && problems+=("MISSING: at least one ## Slice <N> — <title> heading")
[ "$gate_seen" -eq 0 ] && problems+=("MISSING: ## Gate Phases heading")

if [ "$bi_seen" -eq 1 ] && [ "$nslices" -gt 0 ] && [ "$gate_seen" -eq 1 ]; then
  seq_trimmed=${seq# }
  if [ "$disc_seen" -eq 1 ]; then
    if [[ ! $seq_trimmed =~ ^BI(\ SLICE)+\ DISC\ GATE$ ]]; then
      problems+=("INVALID: Discovered section is misplaced")
    fi
  else
    if [[ ! $seq_trimmed =~ ^BI(\ SLICE)+\ GATE$ ]]; then
      problems+=("INVALID: top-level headings must appear in order: Behavior Inventory, Slice section(s), Gate Phases")
    fi
  fi
fi

# ---- Behavior Inventory table ----
if [ "$bi_header" -eq 0 ]; then
  problems+=("MISSING: Behavior Inventory table header row '| Behavior | Slice | Verified by |'")
elif [ "$bi_sep" -eq 0 ]; then
  problems+=("MISSING: Behavior Inventory table separator row")
elif [ "$bi_row" -eq 0 ]; then
  problems+=("MISSING: Behavior Inventory table row (at least one data row required)")
fi

# ---- per-slice sub-headings ----
for n in "${slice_numbers[@]}"; do
  [ "${red_seen[n]:-0}" = "1" ] || problems+=("MISSING: ### Slice $n — RED sub-heading")
  [ "${green_seen[n]:-0}" = "1" ] || problems+=("MISSING: ### Slice $n — GREEN sub-heading")
  [ "${refactor_seen[n]:-0}" = "1" ] || problems+=("MISSING: ### Slice $n — REFACTOR sub-heading")
done

# ---- Depends-on validation ----
for n in "${slice_numbers[@]}"; do
  deps=${dep_list[n]:-}
  [ -z "$deps" ] && continue
  for m in $deps; do
    exists=0
    for sn in "${slice_numbers[@]}"; do
      [ "$sn" = "$m" ] && exists=1
    done
    if [ "$exists" -eq 0 ] || [ "$m" -ge "$n" ]; then
      problems+=("INVALID: Slice $n Depends-on refers to Slice $m (not an existing lower-numbered slice)")
    fi
  done
done

if [ ${#problems[@]} -eq 0 ]; then
  printf 'OK\n'
  exit 0
fi

for p in "${problems[@]}"; do
  printf '%s\n' "$p"
done
exit 1
