#!/usr/bin/env bash
# prep-lint — validate a PREP.md against the prep grammar.
#
# Fence-aware: lines inside ``` or ~~~ code fences are never treated as
# headings or bullets (matches flow-lint's fence handling).
set -u

print_help() {
  cat <<'EOF'
Usage: prep-lint <prep-file>

Validates a PREP.md file against the prep grammar:
  # Prep — <title>
  Gathered: <date> · Questions: <n> of <m> · Route: <route> · Status: <status>

  ## Decisions
  - D-NN <text> — user, Q<n>
  ## Not this
  - <text>
  ## Discretion
  - <text>
  ## Assumptions
  - A-NN <text> — evidence: <path:line|none> — confidence: high|medium|low — <confirmed Qn|corrected Qn|unconfirmed>
  ## Verify
  - <text>
  ## Open
  - Q: <question> → <resolution or "deferred to spec">

Route must be one of: spike, bounded, oneshot, dispatch.
Status must be one of: interviewing, ready for spec, done in chat.
The header separator may be " · " or " - "; matching is on field names,
not the separator.

Lines inside ``` or ~~~ fences are never treated as headings or bullets.

Prints "OK" when the prep file is clean, or one "ERROR: ... — fix: ..." or
"WARN: ... — fix: ..." line per problem found. Exit 1 if any ERROR is
found, 0 otherwise (including when only WARNs are found).
EOF
}

for a in "$@"; do
  case "$a" in
  --help | -h)
    print_help
    exit 0
    ;;
  esac
done

if [ $# -lt 1 ]; then
  echo "Usage: prep-lint <prep-file>" >&2
  exit 1
fi

prep_file=$1

if [ ! -f "$prep_file" ]; then
  echo "MISSING: $prep_file"
  exit 1
fi

# update_max_q <receipt> — <receipt> is the bullet's receipt fragment only
# ("— user, Q4" / "confirmed Q3"), never the whole line: a Q10 mentioned in
# prose is not a receipt. Raises the global max_q when the number is larger.
update_max_q() {
  local qs q
  qs=$(printf '%s\n' "$1" | grep -oE 'Q[0-9]+' || true)
  for q in $qs; do
    q=$((10#${q#Q}))
    [ "$q" -gt "$max_q" ] && max_q=$q
  done
}

# section_name <token> — maps an internal section token to its heading text.
section_name() {
  case "$1" in
  DEC) printf 'Decisions' ;;
  NOT) printf 'Not this' ;;
  DISC) printf 'Discretion' ;;
  ASSUM) printf 'Assumptions' ;;
  VERIFY) printf 'Verify' ;;
  OPEN) printf 'Open' ;;
  esac
}

rtrim() {
  local s=$1
  while :; do
    case "$s" in
    *' ') s=${s% } ;;
    *) break ;;
    esac
  done
  printf '%s' "$s"
}

problems=()

# ---- fence state ----
in_fence=0
fence_char=""

# ---- header state ----
gathered_found=0
qn="" qm="" route="" status=""

# ---- section / bullet state ----
seq=""
cur_section=""
dec_count=0
notthis_count=0
verify_count=0
open_count=0
dec_ids=""
assum_ids=""
dup_ids=""
max_q=0

HEADER_QN_RE='Questions:[[:space:]]*([0-9]+)[[:space:]]+of[[:space:]]+([0-9]+)'
HEADER_ROUTE_RE='Route:[[:space:]]*([A-Za-z]+)'
HEADER_STATUS_RE='Status:[[:space:]]*(.*)$'
DEC_RE='^- D-([0-9]{2,}) .+ (—|--) user, Q[0-9]+[[:space:]]*$'
ASSUM_RE='^- A-([0-9]{2,}) .*confidence:[[:space:]]*(high|medium|low)'

while IFS= read -r line || [ -n "$line" ]; do
  line=${line%$'\r'}

  trimmed=$line
  while :; do
    case "$trimmed" in
    ' '*) trimmed=${trimmed# } ;;
    "$(printf '\t')"*) trimmed=${trimmed#"$(printf '\t')"} ;;
    *) break ;;
    esac
  done

  if [ "$in_fence" -eq 1 ]; then
    case "$trimmed" in
    '```'*) [ "$fence_char" = '```' ] && { in_fence=0; fence_char=""; } ;;
    '~~~'*) [ "$fence_char" = '~~~' ] && { in_fence=0; fence_char=""; } ;;
    esac
    continue
  fi
  case "$trimmed" in
  '```'*)
    in_fence=1
    fence_char='```'
    continue
    ;;
  '~~~'*)
    in_fence=1
    fence_char='~~~'
    continue
    ;;
  esac

  if [ "$gathered_found" -eq 0 ]; then
    case "$line" in
    'Gathered:'*)
      gathered_found=1
      if [[ $line =~ $HEADER_QN_RE ]]; then
        qn=$((10#${BASH_REMATCH[1]}))
        qm=$((10#${BASH_REMATCH[2]}))
      fi
      [[ $line =~ $HEADER_ROUTE_RE ]] && route=${BASH_REMATCH[1]}
      if [[ $line =~ $HEADER_STATUS_RE ]]; then
        status=${BASH_REMATCH[1]}
        status=${status%% · *}
        status=${status%% - *}
        status=$(rtrim "$status")
      fi
      continue
      ;;
    esac
  fi

  case "$line" in
  '## Decisions')
    cur_section=DEC
    seq="$seq DEC"
    continue
    ;;
  '## Not this')
    cur_section=NOT
    seq="$seq NOT"
    continue
    ;;
  '## Discretion')
    cur_section=DISC
    seq="$seq DISC"
    continue
    ;;
  '## Assumptions')
    cur_section=ASSUM
    seq="$seq ASSUM"
    continue
    ;;
  '## Verify')
    cur_section=VERIFY
    seq="$seq VERIFY"
    continue
    ;;
  '## Open')
    cur_section=OPEN
    seq="$seq OPEN"
    continue
    ;;
  '## '*)
    cur_section=""
    continue
    ;;
  esac

  case "$line" in
  '- '*)
    case "$cur_section" in
    DEC)
      dec_count=$((dec_count + 1))
      if [[ $line =~ $DEC_RE ]]; then
        id="D-${BASH_REMATCH[1]}"
        case " $dup_ids " in
        *" $id "*) : ;;
        *)
          case " $dec_ids " in
          *" $id "*)
            dup_ids="$dup_ids $id"
            problems+=("ERROR: duplicate id $id — fix: ids are unique — renumber D-NN/A-NN")
            ;;
          esac
          ;;
        esac
        dec_ids="$dec_ids $id"
      else
        problems+=("ERROR: Decisions bullet does not match the grammar: \"$line\" — fix: every decision reads \"- D-NN <text> — user, Q<n>\"")
      fi
      update_max_q "$(printf '%s' "$line" | grep -oE '(—|--) user, Q[0-9]+' || true)"
      ;;
    NOT) notthis_count=$((notthis_count + 1)) ;;
    ASSUM)
      if [[ $line =~ $ASSUM_RE ]]; then
        id="A-${BASH_REMATCH[1]}"
        case " $dup_ids " in
        *" $id "*) : ;;
        *)
          case " $assum_ids " in
          *" $id "*)
            dup_ids="$dup_ids $id"
            problems+=("ERROR: duplicate id $id — fix: ids are unique — renumber D-NN/A-NN")
            ;;
          esac
          ;;
        esac
        assum_ids="$assum_ids $id"
      else
        problems+=("ERROR: Assumptions bullet does not match the grammar: \"$line\" — fix: every assumption reads \"- A-NN <text> — evidence: <path:line|none> — confidence: high|medium|low — <confirmed Qn|corrected Qn|unconfirmed>\"")
      fi
      update_max_q "$(printf '%s' "$line" | grep -oE '(confirmed|corrected) Q[0-9]+' || true)"
      ;;
    VERIFY) verify_count=$((verify_count + 1)) ;;
    OPEN) open_count=$((open_count + 1)) ;;
    esac
    ;;
  esac
done <"$prep_file"

# ---- rule 1: header missing / Questions unparsable ----
if [ "$gathered_found" -eq 0 ] || [ -z "$qn" ] || [ -z "$qm" ]; then
  problems+=('ERROR: Gathered header missing or Questions: N of M is unparsable — fix: write the header line "Gathered: <date> · Questions: <n> of 12 · Route: <route> · Status: <status>"')
fi

# ---- rule 2: N > M ----
if [ -n "$qn" ] && [ -n "$qm" ] && [ "$qn" -gt "$qm" ]; then
  problems+=("ERROR: Questions $qn exceeds $qm — fix: split the work — more than $qm questions means the scope is too large; run /flow:prep once per piece")
fi

# ---- rule 3: Route not in the four ----
route_ok=0
case "$route" in
spike | bounded | oneshot | dispatch) route_ok=1 ;;
esac
[ "$route_ok" -eq 0 ] && problems+=("ERROR: Route \"$route\" is not valid — fix: Route must be spike, bounded, oneshot or dispatch")

# ---- rule 4: Status not in the three ----
status_ok=0
case "$status" in
interviewing | "ready for spec" | "done in chat") status_ok=1 ;;
esac
[ "$status_ok" -eq 0 ] && problems+=("ERROR: Status \"$status\" is not valid — fix: Status must be interviewing, ready for spec, or done in chat")

# ---- rule 5: spike/bounded with Status ready for spec ----
case "$route" in
spike | bounded)
  [ "$status" = "ready for spec" ] && problems+=("ERROR: Route $route with Status \"ready for spec\" — fix: spike and bounded never get a spec — set Status to \"done in chat\"")
  ;;
esac

# ---- rule 6: required sections missing or out of order ----
seq_padded="$seq "
seq_trimmed=${seq# }
required_order="DEC NOT DISC ASSUM VERIFY OPEN"
if [ "$seq_trimmed" != "$required_order" ]; then
  missing_tok=""
  for tok in DEC NOT DISC ASSUM VERIFY OPEN; do
    case "$seq_padded" in
    *" $tok "*) : ;;
    *)
      missing_tok=$tok
      break
      ;;
    esac
  done
  if [ -n "$missing_tok" ]; then
    name=$(section_name "$missing_tok")
    problems+=("ERROR: missing required section \"## $name\" — fix: add \"## $name\" — the six sections are Decisions, Not this, Discretion, Assumptions, Verify, Open, in that order")
  else
    problems+=("ERROR: sections are out of order (found:$seq) — fix: the six sections are Decisions, Not this, Discretion, Assumptions, Verify, Open, in that order")
  fi
fi

# ---- rules 7 / 8: Not this / Verify require a bullet outside interviewing ----
if [ "$notthis_count" -eq 0 ] && [ "$status" != "interviewing" ]; then
  problems+=('ERROR: ## Not this has no bullet — fix: ask "what should this explicitly NOT do?" and record at least one line')
fi
if [ "$verify_count" -eq 0 ] && [ "$status" != "interviewing" ]; then
  problems+=('ERROR: ## Verify has no bullet — fix: ask "what single check would convince you this shipped?" and record it')
fi

# ---- rule 9: more than 3 Open bullets ----
if [ "$open_count" -gt 3 ]; then
  k=$((open_count - 3))
  problems+=("ERROR: ## Open has $open_count bullets, more than 3 — fix: more than 3 open questions means the scope is too large — split, or resolve $k of them now")
fi

# ---- rule 13 (WARN): ready for spec with zero Decisions ----
if [ "$status" = "ready for spec" ] && [ "$dec_count" -eq 0 ]; then
  problems+=('WARN: Status "ready for spec" with zero Decisions bullets — fix: a spec with nothing decided is a wishlist — record at least one D-NN or stay in "interviewing"')
fi

# ---- rule 14 (WARN): counter behind the receipts ----
if [ -n "$qn" ] && [ "$max_q" -gt "$qn" ]; then
  problems+=("WARN: the Questions counter is behind the receipts (found Q$max_q, counter says $qn) — fix: the counter is behind the receipts — set Questions to $max_q of $qm")
fi

if [ ${#problems[@]} -eq 0 ]; then
  printf 'OK\n'
  exit 0
fi

has_error=0
for p in "${problems[@]}"; do
  printf '%s\n' "$p"
  case "$p" in
  ERROR:*) has_error=1 ;;
  esac
done

[ "$has_error" -eq 1 ] && exit 1
exit 0
