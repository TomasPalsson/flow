#!/usr/bin/env bash
# lesson-sites — where can a guardrail go in this project? Prints one line per
# rung of the /lesson ladder with the concrete site it would use, from state on
# disk only (no judgement). Bash 3.2 compatible; see --help.
set -u

usage() {
  cat <<'HELP'
Usage: lesson-sites [--dir <path>] [--json]

Inspects <path> (default: the current directory's git toplevel, else cwd)
and prints, per rung of the /lesson ladder, the site a guardrail would use:

  test      the project's test runner and directory, or the harness suites
            when <path> is the harness plugin itself
  deny      <path>/.claude/settings.json permissions.deny block (present
            only when the file exists and contains "deny"); ~/.claude/
            settings.json for a machine-wide rule
  hook      .claude/settings.json (project hooks) or the plugin hooks dir
  lint      .claude/flow.config.json thresholds / .flow/ threshold files
  script    the plugin scripts dir (harness) or the project's bin dir
  skill     the plugin skills dir the current session loads
  claude-md ./CLAUDE.md and ~/.claude/CLAUDE.md with their line counts and
            budget (100 project / 40 global)
  progress  PROGRESS.md (present or not; line count)

Text form: "<rung> <status> <detail>", status is one of present|absent.
--json prints the same as a JSON object keyed by rung.
HELP
}

DIR=""
JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
  --help | -h) usage; exit 0 ;;
  --dir) DIR=$2; shift 2 ;;
  --json) JSON=1; shift ;;
  *) printf 'lesson-sites: unknown argument %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [ -z "$DIR" ]; then
  DIR=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
fi
DIR=$(cd "$DIR" 2>/dev/null && pwd -P) || { printf 'lesson-sites: no such directory\n' >&2; exit 2; }

count_lines() { if [ -f "$1" ]; then wc -l <"$1" | tr -d ' '; else printf '0'; fi; }

is_harness=0
[ -f "$DIR/.claude-plugin/plugin.json" ] && [ -d "$DIR/hooks/tests" ] && is_harness=1

# test
test_status=absent; test_detail="no test runner detected"
if [ "$is_harness" -eq 1 ]; then
  test_status=present; test_detail="$DIR/hooks/tests/run.sh and $DIR/scripts/tests/run.sh (add t_<unit>_* to a test_*.sh)"
elif [ -f "$DIR/package.json" ]; then
  if grep -q '"test"[[:space:]]*:' "$DIR/package.json"; then
    test_status=present; test_detail="package.json test script"
  else
    test_status=absent; test_detail="package.json has no test script; add one (bun test / vitest / node --test) before writing the regression test"
  fi
elif [ -f "$DIR/pyproject.toml" ]; then
  test_status=present; test_detail="pytest (tests/)"
elif [ -d "$DIR/tests" ] || [ -d "$DIR/test" ]; then
  test_status=present; test_detail="a tests/ directory exists; runner not detected (check the README)"
elif [ -f "$DIR/Cargo.toml" ]; then
  test_status=present; test_detail="cargo test"
elif [ -f "$DIR/go.mod" ]; then
  test_status=present; test_detail="go test ./..."
fi

# deny
settings_file="$DIR/.claude/settings.json"
if [ -f "$settings_file" ] && grep -q '"deny"' "$settings_file"; then
  deny_status=present
  deny_detail="$settings_file already has a permissions.deny block"
elif [ -f "$settings_file" ]; then
  deny_status=absent
  deny_detail="$settings_file exists; add a permissions.deny block to it; ~/.claude/settings.json for a machine-wide rule"
else
  deny_status=absent
  deny_detail="$settings_file does not exist; create it with a permissions.deny block; ~/.claude/settings.json for a machine-wide rule"
fi

# hook
if [ "$is_harness" -eq 1 ]; then
  hook_status=present; hook_detail="$DIR/hooks/*.sh registered in $DIR/hooks/hooks.json (bash 3.2, exit 2 = feedback, JSON deny for PreToolUse)"
elif [ -f "$DIR/.claude/settings.json" ] && grep -q '"hooks"' "$DIR/.claude/settings.json"; then
  hook_status=present; hook_detail="$DIR/.claude/settings.json hooks block (project-scoped)"
else
  hook_status=absent; hook_detail="no project hooks; add a hooks block to $DIR/.claude/settings.json, or a harness hook for every project"
fi

# lint
if [ -f "$DIR/.claude/flow.config.json" ]; then
  lint_status=present; lint_detail="$DIR/.claude/flow.config.json (maxFileLines, maxFuncLines, requireSpec, stopGate)"
elif [ -d "$DIR/.harness" ]; then
  lint_status=present; lint_detail="$DIR/.flow/ threshold files"
else
  lint_status=absent; lint_detail="no .claude/flow.config.json; flow init creates it"
fi

# script
if [ "$is_harness" -eq 1 ]; then
  script_status=present; script_detail="$DIR/scripts/<name> with scripts/tests/test_<name>.sh"
elif [ -d "$DIR/bin" ] || [ -d "$DIR/scripts" ]; then
  script_status=present; script_detail="$DIR/bin or $DIR/scripts"
else
  script_status=absent; script_detail="no scripts dir; a harness script serves every project"
fi

# skill
skills_dir="${HOME:-}/.claude/skills"
if [ -d "$skills_dir/harness/skills" ]; then
  skill_status=present; skill_detail="$skills_dir/harness/skills/<name>/SKILL.md (plugin; edits are live)"
elif [ -d "$skills_dir" ]; then
  skill_status=present; skill_detail="$skills_dir/<name>/SKILL.md"
else
  skill_status=absent; skill_detail="no ~/.claude/skills"
fi

# claude-md
proj_md="$DIR/CLAUDE.md"; glob_md="${HOME:-}/.claude/CLAUDE.md"
pl=$(count_lines "$proj_md"); gl=$(count_lines "$glob_md")
cm_status=present
cm_detail="$proj_md ${pl}/100 lines; $glob_md ${gl}/40 lines"
[ "$pl" -ge 100 ] && cm_detail="$cm_detail; project file AT BUDGET (cut one line per line added)"
[ "$gl" -ge 40 ] && cm_detail="$cm_detail; global file AT BUDGET"

# progress
if [ -f "$DIR/PROGRESS.md" ]; then
  progress_status=present; progress_detail="$DIR/PROGRESS.md $(count_lines "$DIR/PROGRESS.md")/60 lines"
else
  progress_status=absent; progress_detail="no PROGRESS.md; lesson-record creates it"
fi

if [ "$JSON" -eq 1 ]; then
  esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
  printf '{\n'
  printf '  "dir": "%s",\n  "harnessRepo": %s,\n' "$(esc "$DIR")" "$([ "$is_harness" -eq 1 ] && printf true || printf false)"
  printf '  "test": {"status": "%s", "detail": "%s"},\n' "$test_status" "$(esc "$test_detail")"
  printf '  "deny": {"status": "%s", "detail": "%s"},\n' "$deny_status" "$(esc "$deny_detail")"
  printf '  "hook": {"status": "%s", "detail": "%s"},\n' "$hook_status" "$(esc "$hook_detail")"
  printf '  "lint": {"status": "%s", "detail": "%s"},\n' "$lint_status" "$(esc "$lint_detail")"
  printf '  "script": {"status": "%s", "detail": "%s"},\n' "$script_status" "$(esc "$script_detail")"
  printf '  "skill": {"status": "%s", "detail": "%s"},\n' "$skill_status" "$(esc "$skill_detail")"
  printf '  "claude-md": {"status": "%s", "detail": "%s"},\n' "$cm_status" "$(esc "$cm_detail")"
  printf '  "progress": {"status": "%s", "detail": "%s"}\n' "$progress_status" "$(esc "$progress_detail")"
  printf '}\n'
else
  printf 'test %s %s\n' "$test_status" "$test_detail"
  printf 'deny %s %s\n' "$deny_status" "$deny_detail"
  printf 'hook %s %s\n' "$hook_status" "$hook_detail"
  printf 'lint %s %s\n' "$lint_status" "$lint_detail"
  printf 'script %s %s\n' "$script_status" "$script_detail"
  printf 'skill %s %s\n' "$skill_status" "$skill_detail"
  printf 'claude-md %s %s\n' "$cm_status" "$cm_detail"
  printf 'progress %s %s\n' "$progress_status" "$progress_detail"
fi
exit 0
