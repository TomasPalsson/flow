#!/usr/bin/env bash
# new-spec — allocate the next numbered spec dir, and optionally a branch
# or worktree for it. Bash 3.2 compatible; see --help for the contract.
set -u

usage() {
  cat <<'EOF'
Usage: new-spec "<title>" [--dir .specs] [--prefix flow/] [--no-branch] [--worktree] [--reuse <dir>/NNN-slug] [--json]

Computes the next 3-digit spec number from existing <dir>/NNN-* entries
(001 when none exist), slugifies <title> to lowercase ASCII [a-z0-9-]
(max 40 chars, computed under LC_ALL=C), and creates <dir>/NNN-slug/.
The number is the max over the current dir, every git worktree's <dir>,
and every local/remote branch's committed <dir>. Inside zellij
(ZELLIJ_PANE_ID set), the pane is renamed to NNN-slug; failures are
ignored.

With --reuse <path>, no number is allocated and nothing is created:
<path> must be an existing <dir>/NNN-slug (a /flow:prep directory holding
PREP.md); NNN and slug are read from its name and everything else runs
as usual, so spec.md lands beside PREP.md.
Unless --no-branch is given, creates and checks out branch
<prefix><slug> from the current HEAD. With --worktree, instead creates
the branch in a sibling worktree at
  $(git rev-parse --show-toplevel)/../code-worktrees/<branch>
via `git worktree add -b`.

Writes .claude/flow.json =
  {"number":"NNN","slug":"...","spec_dir":"...","branch":"...","worktree":"..."|null}
and prints the same JSON to stdout.

--json is accepted for symmetry with the other scripts; output is
already JSON on every run.

Does not check working-tree dirtiness. Exit 1 only when a branch is
requested outside a git repository, or <dir> is not writable.
EOF
}

slugify() {
  # $1 = title -> lowercase ASCII [a-z0-9-], collapsed/trimmed dashes,
  # truncated to 40 chars. Computed under LC_ALL=C.
  LC_ALL=C printf '%s' "$1" |
    LC_ALL=C tr '[:upper:]' '[:lower:]' |
    LC_ALL=C sed -e 's/[^a-z0-9]/-/g' -e 's/-\{2,\}/-/g' -e 's/^-*//' -e 's/-*$//' |
    LC_ALL=C cut -c1-40 |
    LC_ALL=C sed -e 's/-*$//'
}

bump_max() {
  # $1 = basename (NNN-*), $2 = current max -> new max, printed.
  local base="$1" max="$2" n
  n=${base%%-*}
  case "$n" in
  [0-9][0-9][0-9])
    n=$((10#$n))
    if [ "$n" -gt "$max" ]; then max=$n; fi
    ;;
  esac
  printf '%s' "$max"
}

scan_dir_for_max() {
  # $1 = dir, $2 = current max -> new max, printed. No-op when dir is
  # absent or has no NNN-* entries.
  local dir="$1" max="$2" cand base
  if [ -d "$dir" ]; then
    for cand in "$dir"/[0-9][0-9][0-9]-*; do
      [ -e "$cand" ] || continue
      base=$(basename "$cand")
      max=$(bump_max "$base" "$max")
    done
  fi
  printf '%s' "$max"
}

scan_worktrees_for_max() {
  # $1 = dir, $2 = current max -> new max, printed. Scans <worktree>/<dir>
  # for every worktree registered with the current repo, uncommitted
  # entries included.
  local dir="$1" max="$2" wt_path worktrees
  worktrees=$(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  while IFS= read -r wt_path; do
    [ -n "$wt_path" ] || continue
    max=$(scan_dir_for_max "$wt_path/$dir" "$max")
  done <<WORKTREES
$worktrees
WORKTREES
  printf '%s' "$max"
}

scan_refs_for_max() {
  # $1 = dir, $2 = current max -> new max, printed. Scans every local and
  # remote branch's committed <dir>/NNN-* entries, so a number claimed on
  # a branch not checked out here is still honored.
  local dir="$1" max="$2" ref name refs names
  refs=$(git for-each-ref --format='%(refname)' refs/heads refs/remotes 2>/dev/null)
  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    names=$(git ls-tree --name-only "$ref" -- "$dir/" 2>/dev/null)
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      max=$(bump_max "$(basename "$name")" "$max")
    done <<NAMES
$names
NAMES
  done <<REFS
$refs
REFS
  printf '%s' "$max"
}

next_number() {
  # $1 = dir -> next 3-digit number as a string, "001" when dir is
  # absent or has no NNN-* entries anywhere scanned. Scans the current
  # dir, every git worktree's <dir>, and every local/remote branch's
  # committed <dir>, so the number stays unique across worktrees and
  # unmerged branches.
  local dir="$1" max n
  max=$(scan_dir_for_max "$dir" 0)
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    max=$(scan_worktrees_for_max "$dir" "$max")
    max=$(scan_refs_for_max "$dir" "$max")
  fi
  n=$((max + 1))
  printf '%03d' "$n"
}

TITLE=""
DIR=".specs"
PREFIX="flow/"
NO_BRANCH=0
WORKTREE=0
REUSE=""

while [ $# -gt 0 ]; do
  case "$1" in
  --help | -h)
    usage
    exit 0
    ;;
  --dir)
    DIR=$2
    shift 2
    ;;
  --prefix)
    PREFIX=$2
    shift 2
    ;;
  --no-branch)
    NO_BRANCH=1
    shift
    ;;
  --worktree)
    WORKTREE=1
    shift
    ;;
  --reuse)
    REUSE=$2
    shift 2
    ;;
  --json)
    shift
    ;;
  --)
    shift
    break
    ;;
  -*)
    printf 'new-spec: unknown option: %s\n' "$1" >&2
    exit 1
    ;;
  *)
    if [ -z "$TITLE" ]; then
      TITLE=$1
    else
      printf 'new-spec: unexpected argument: %s\n' "$1" >&2
      exit 1
    fi
    shift
    ;;
  esac
done

if [ -z "$TITLE" ]; then
  usage >&2
  exit 1
fi

if [ "$NO_BRANCH" -eq 0 ]; then
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'new-spec: not inside a git repository (use --no-branch to skip)\n' >&2
    exit 1
  fi
fi

if [ -n "$REUSE" ]; then
  if [ ! -d "$REUSE" ]; then
    printf 'new-spec: --reuse %s is not a directory\n' "$REUSE" >&2
    exit 1
  fi
  SPEC_DIR=${REUSE%/}
  base=$(basename "$SPEC_DIR")
  case "$base" in
  [0-9][0-9][0-9]-?*) ;;
  *)
    printf 'new-spec: --reuse expects <dir>/NNN-slug, got %s\n' "$base" >&2
    exit 1
    ;;
  esac
  NUMBER=${base%%-*}
  SLUG=${base#*-}
else
  NUMBER=$(next_number "$DIR")
  SLUG=$(slugify "$TITLE")
  SPEC_DIR="$DIR/$NUMBER-$SLUG"
  if ! mkdir -p "$SPEC_DIR" 2>/dev/null; then
    printf 'new-spec: cannot create %s (not writable?)\n' "$SPEC_DIR" >&2
    exit 1
  fi
fi

if [ -n "${ZELLIJ_PANE_ID:-}" ] && command -v zellij >/dev/null 2>&1; then
  zellij action rename-pane "$NUMBER-$SLUG" >/dev/null 2>&1 || true
fi

BRANCH=""
WORKTREE_PATH=""
if [ "$NO_BRANCH" -eq 0 ]; then
  BRANCH="${PREFIX}${SLUG}"
  if [ "$WORKTREE" -eq 1 ]; then
    TOPLEVEL=$(git rev-parse --show-toplevel)
    WORKTREE_PATH="$TOPLEVEL/../code-worktrees/$BRANCH"
    git worktree add -b "$BRANCH" "$WORKTREE_PATH" >/dev/null
  else
    git checkout -b "$BRANCH" >/dev/null 2>&1
  fi
fi

mkdir -p .claude

{
  printf '{'
  printf '"number":"%s",' "$NUMBER"
  printf '"slug":"%s",' "$SLUG"
  printf '"spec_dir":"%s",' "$SPEC_DIR"
  printf '"branch":"%s",' "$BRANCH"
  if [ -n "$WORKTREE_PATH" ]; then
    printf '"worktree":"%s"' "$WORKTREE_PATH"
  else
    printf '"worktree":null'
  fi
  printf '}\n'
} >.claude/flow.json

cat .claude/flow.json
